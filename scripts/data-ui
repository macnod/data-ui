}

function export_docs_environment {
    export SKIP_DB="true"
    export LOG_FILE="tests/docs.log"
    unset SWANK_PORT &>/dev/null
    export RUN_TESTS="false"
}

function get_model_field {
    # Data, not code: the model path and the field name cross to SBCL as
    # environment variables read by constant --eval forms — never
    # spliced into the eval text (the old "${FIELD_NAME}" spellings
    # were a shell-quoting injection hole; paths containing quotes,
    # backslashes, parentheses, or newlines must compile or fail
    # cleanly, with nothing injected). DATA_UI_MODEL_PATH defaults to
    # the canonical models/${MODEL_NAME}.lisp; handoff deploys point it
    # at the candidate. The basename-derived second argument is the
    # deploy token under a handoff — harmless only because
    # top-level-model-field ignores it when :model-path is given; keep
    # it that way.
    local model_path="${DATA_UI_MODEL_PATH:-models/${MODEL_NAME}.lisp}"
    DATA_UI_MODEL_PATH="$model_path" \
        ros run -- --disable-debugger \
        --load "lisp/deployment.lisp" \
        --eval '(in-package :deployment)' \
        --eval '(let* ((path (uiop:getenv "DATA_UI_MODEL_PATH"))
                       (base (and path (pathname-name (parse-namestring path)))))
                  (top-level-model-field (uiop:getenv "DATA_UI_FIELD_NAME") base :model-path path))' \
        --quit
}

#
# Deployment
#

function haproxy_env {
    # HAProxy paths plus DEPLOY_HOST, shared by deploy/undeploy and the
    # profile expose/unexpose verbs (which call it directly). DEPLOY_HOST
    # is the machine hosting the k3d cluster and HAProxy; it must be
    # both a valid ssh destination (see ~/.ssh/config) and the machine's
    # hostname, since the latter decides local vs remote deploy. The
    # path variables keep pre-set values so test harnesses (and other
    # front doors) can redirect them; defaults are the production host's.
    export DEPLOY_HOST="${DEPLOY_HOST:-evo-x2}"
    export HAPROXY_CFG="${HAPROXY_CFG:-/etc/haproxy/haproxy.cfg}"
    export HAPROXY_CONF_D="${HAPROXY_CONF_D:-/etc/haproxy/conf.d}"
    export HAPROXY_MAP="${HAPROXY_MAP:-/etc/haproxy/data-ui.map}"
    export HAPROXY_DEFAULTS="${HAPROXY_DEFAULTS:-/etc/default/haproxy}"
}

function export_deploy_environment {
    export DEPLOY_ENV="demo"
    haproxy_env
    # DEPLOY_CHECKOUT defaults to the production clone under
    # /data/data-ui/repos (scripts/lib/checkout.sh owns the default).
    # A deploy always selects and re-executes that checkout's script;
    # the caller's HEAD, branch, working tree, and remotes are never
    # production inputs.
    export DEPLOY_CHECKOUT
    # Machine-local deployment state (rendered manifests, ports.lock,
    # per-instance secrets, orphaned candidates, recovery records).
    # Deliberately outside every repository: it is derived output and
    # cluster-state cache, not source.
    export DEPLOY_STATE_DIR="${DEPLOY_STATE_DIR:-$DATA_UI_STATE/deploy}"
    export K3D_CLUSTER="${K3D_CLUSTER:-evo-x2}"
    export IMAGE_REPO="macnod/data-ui"
    export TEMPLATES_DIR="deploy/templates"
    export PORTS_LOCK="${DEPLOY_STATE_DIR}/ports.lock"
    export PORT_MIN=30300
    # The deployed instance's database identity is a fixed fact of the
    # k8s templates (POSTGRES_USER dataui; app env DB_NAME/DB_USER
    # dataui; init container -U dataui -d dataui), not an environment
    # knob. Pin it unconditionally: this script often runs inside a
    # Data UI app process (the :deploy-model hook inherits its host
    # profile's env), whose DB_NAME (e.g. modelbank) otherwise leaks
    # into the rendered init SQL (\c modelbank) while the app container
    # connects as dataui/dataui — the init-db container then
    # crash-loops on a nonexistent database and the rollout times out.
    # DB_HOST too: the deploy-time compile database publishes on
    # loopback. (DB_PASSWORD is NOT pinned: the compile database
    # interpolates it, and the instance password comes from
    # ensure_instance_secrets.)
    export DB_NAME="dataui"
    export DB_USER="dataui"
    export DB_HOST="127.0.0.1"
}

function model_field {
    # $1 = field name, crossing as data (see get_model_field).
    DATA_UI_FIELD_NAME="$1" get_model_field | tail -1
}

function require_clean_tree {
    # Retired: the deploy body never checks the caller's tree. Outer
    # selection runs the strict check on the production checkout
    # (require_checkout_clean in scripts/lib/checkout.sh), and
    # development is never required to be clean. Kept as a hard error
    # so stale callers surface immediately.
    die "require_clean_tree is retired; selection owns cleanliness (scripts/lib/checkout.sh)."
}

function export_deploy_db_environment {
    # Throwaway database for the deploy-time model compile. Uses its own
    # container and port so it never collides with a running repl (5444)
    # or test (5445) database. Unconditional: hermetic sub-environment.
    export DB_CONTAINER="pg-data-ui-deploy"
    export DB_SERVICE="pg-data-ui-deploy"
    export DB_DOCKER_COMPOSE="tests/docker-compose-pg-data-ui-deploy.yaml"
    export DB_PORT="5446"
    export LOG_FILE="tests/deploy-compile.log"
    export PGPASSWORD="$DB_PASSWORD"
}

function build_load_contract_evals {
    # The ASDF load contract, shared by start_repl, run_tests,
    # compile_model, and the staging pre-warm. Every load site runs a
    # FRESH SBCL ((asdf:clear-system :data-ui) cannot undo a load
    # already performed), pushes this checkout onto
    # asdf:*central-registry* BEFORE (require :data-ui), then
    # canonicalizes (asdf:system-source-directory :data-ui) AND
    # data-ui::*package-root* and aborts (exit 3) unless both equal the
    # invoking checkout. A plain push is not enough: ~/common-lisp is in
    # the default source-registry tree and Quicklisp local-projects can
    # resolve the development clone first. *package-root* is not an
    # independent witness (it is system-relative), but it is the path
    # the image uses for models/, the deploy script, and the registry,
    # so it is compared anyway. The two format lines are diagnostics —
    # the comparison is the guard. All inputs cross as environment
    # variables read by constant --eval forms; nothing is spliced.
    local checkout
    checkout=$(canonical_checkout_root)
    LOAD_CONTRACT_EVALS=(
        --eval '(let ((c (uiop:getenv "DATA_UI_EXPECTED_CHECKOUT")))
                  (push (uiop:ensure-directory-pathname c)
                        asdf:*central-registry*))'
        --eval '(asdf:clear-system :data-ui)'
        --eval '(require :data-ui)'
        --eval '(let* ((expected (uiop:getenv "DATA_UI_EXPECTED_CHECKOUT"))
                       (want (concatenate (quote string) (string-right-trim "/" expected) "/"))
                       (src (namestring (truename (asdf:system-source-directory :data-ui))))
                       (root (namestring (truename data-ui::*package-root*))))
                  (format t "DATA-UI-ASDF-SOURCE=~a~%" src)
                  (format t "DATA-UI-PACKAGE-ROOT=~a~%" root)
                  (unless (and (equal src want) (equal root want))
                    (format *error-output* "FATAL: ASDF resolved :data-ui outside this checkout (source=~a package-root=~a wanted=~a)~%" src root want)
                    (uiop:quit 3)))'
    )
    LOAD_CONTRACT_CHECKOUT="$checkout"
}

function compile_model {
    # MODEL identity crosses as data: DATA_UI_MODEL_PATH (canonical
    # models/<name>.lisp or the handoff candidate) is read by constant
    # --eval forms — the old "${model_file}" splice is gone. The read
    # stays behind read-model-text (the read-time-eval fix; a plain
    # read would reopen the #. hole), and the ASDF load contract pins
    # the compile to this checkout.
    local model_path="${DATA_UI_MODEL_PATH:-models/${MODEL_NAME}.lisp}"
    echo
    echo "Compiling model from ${model_path}..."
    # Runs the compilation phase of SET-MODEL (validation, SQL generation,
    # lambda compilation) against a throwaway database, skipping the
    # cluster-facing side effects (CREATE-TABLES, START-WEB-SERVER, etc).
    # COMPILE-MODEL merges in *base-model* itself, but its stage-1 needs
    # *rbac* initialized, hence the database and INIT-DATABASE.
    export_deploy_db_environment
    render_init_sql
    # Gitignored runtime directories; absent in a fresh deploy clone.
    mkdir -p "$DOCUMENT_ROOT" "$FS_TEMP_DIRECTORY"
    start_postgres_quietly
    initialize_database_quietly
    local status=0
    build_load_contract_evals
    DATA_UI_MODEL_PATH="$model_path" \
    DATA_UI_EXPECTED_CHECKOUT="$LOAD_CONTRACT_CHECKOUT" \
        ros run -- --disable-debugger \
            "${LOAD_CONTRACT_EVALS[@]}" \
            --eval '(in-package :data-ui)' \
            --eval '(init-database)' \
            --eval '(let* ((path (uiop:getenv "DATA_UI_MODEL_PATH"))
                           (model (cadr (read-model-text (u:slurp path)))))
                      (top-level-settings model)
                      (compile-model (getf model :types))
                      (format t "Model compiled OK.~%"))' \
            --quit || status=1
    stop_database_quietly
    (( status == 0 )) \
        || die "Model failed to compile; aborting deployment."
}

function gather_deploy_facts {
    echo "Reading identity from the model..."
    NAME=$(model_field name)
    TITLE=$(model_field title)
    VERSION=$(model_field version)
    DOMAIN=$(model_field domain)
    REPL=$(model_field repl)
    # The model compile step already requires these; the checks here only
    # guard against get_model_field plumbing failures.
    [[ -n "$NAME" && "$NAME" != "NIL" ]] || die "Model has no :name."
    [[ -n "$TITLE" && "$TITLE" != "NIL" ]] || die "Model has no :title."
    [[ -n "$VERSION" && "$VERSION" != "NIL" ]] || die "Model has no :version."
    [[ -n "$DOMAIN" && "$DOMAIN" != "NIL" ]] || die "Model has no :domain."
    SHORT_HASH="${DEPLOY_FULL_SHA:0:7}"
    TAG="${NAME}-${VERSION}-${SHORT_HASH}"
    IMAGE="${IMAGE_REPO}:${TAG}"
    RELEASE_NAME="${TITLE} ${TAG}"
    NAMESPACE="dataui-${NAME}"
    OUT_DIR="${DEPLOY_STATE_DIR}/${NAME}/releases/${VERSION}-${SHORT_HASH}"
    SECRETS_ENV="${DEPLOY_STATE_DIR}/${NAME}/secrets.env"
    echo "  name:      $NAME"
    echo "  title:     $TITLE"
    echo "  version:   $VERSION"
    echo "  domain:    $DOMAIN"
    echo "  repl:      $REPL"
    echo "  tag:       $TAG"
    echo "  image:     $IMAGE"
    echo "  manifests: $OUT_DIR"
}

function create_deploy_tag {
    # FR-9: a git tag <name>-<version>-<hash> in the production clone
    # names the deploying VIP's model — a radar trace even though the
    # file is gitignored. Skip under a handoff; keep the docker tag.
    # The tag is local to the production clone, created AT the
    # envelope's full SHA (never a HEAD reread), and is never pushed to
    # public, private, or origin. Operators identify a release by the
    # printed source + full SHA and the image tag; rollback is a revert
    # commit, never a tag checkout.
    if [[ -n "${DEPLOY_HANDOFF_KIND:-}" && "${DEPLOY_HANDOFF_KIND}" != "none" ]]; then
        echo "Handoff deploy (MODEL_FILE); skipping git tag (FR-9)."
        return
    fi
    if checkout_git "$DEPLOY_CHECKOUT" rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then
        if [[ "$(checkout_git "$DEPLOY_CHECKOUT" rev-parse "${TAG}^{commit}")" != "$DEPLOY_FULL_SHA" ]]; then
            die "Tag ${TAG} exists but points at a different commit."
        fi
        echo "Tag ${TAG} already exists at ${DEPLOY_FULL_SHA}; reusing it."
    else
        checkout_git "$DEPLOY_CHECKOUT" tag -a "$TAG" -m "$RELEASE_NAME" "$DEPLOY_FULL_SHA" \
            || die "Cannot create tag ${TAG} in ${DEPLOY_CHECKOUT}."
        echo "Created tag ${TAG} (\"${RELEASE_NAME}\")."
    fi
}

function build_image {
    # The Docker context is a fresh restrictive temporary directory
    # populated by `git archive FULL_SHA` — never the raw checkout
    # (Dockerfile uses COPY ., and ignored stale VIP models under
    # models/local/ would ride into canonical images). Any models/local
    # path in the archive listing aborts the build. A handoff deploy
    # then creates models/local/ IN THE CONTEXT, copies the immutable
    # candidate there as models/local/<cli-name>.lisp, SHA-256-checks it
    # against the envelope handoff SHA, and asserts the archived
    # canonical models/<cli-name>.lisp is absent; a canonical deploy
    # asserts no models/local/ path exists in the context. The context
    # is cleaned by the inner arm's trap. The tracked root .dockerignore
    # rides in the archive (harmless; it never excluded models/local/).
    local context listing archive
    context=$(mktemp -d "${TMPDIR:-/tmp}/data-ui-build-context.XXXXXX") \
        || die "cannot create a build context directory"
    DEPLOY_BUILD_CONTEXT="$context"
    chmod 700 "$context"
    archive=$(mktemp "${TMPDIR:-/tmp}/data-ui-build-archive.XXXXXX.tar") \
        || die "cannot create a build archive temp file"
    DEPLOY_BUILD_ARCHIVE="$archive"
    checkout_git "$DEPLOY_CHECKOUT" archive --format=tar "$DEPLOY_FULL_SHA" > "$archive" \
        || { rm -f "$archive"; die "git archive of ${DEPLOY_FULL_SHA} failed."; }
    listing=$(tar -tf "$archive") \
        || { rm -f "$archive"; die "cannot list the git archive (corrupt?)."; }
    if grep -q '^models/local/' <<<"$listing"; then
        die "Refusing to build: the selected revision tracks files under models/local/ (never a build input)."
    fi
    tar -xf "$archive" -C "$context" \
        || die "cannot extract the git archive into the build context."
    rm -f "$archive"
    DEPLOY_BUILD_ARCHIVE=""
    if [[ "${DEPLOY_HANDOFF_KIND:-none}" != "none" ]]; then
        local ctx_model="models/local/${MODEL_NAME}.lisp" got
        if [[ -e "${context}/models/${MODEL_NAME}.lisp" ]]; then
            die "Refusing to build: canonical models/${MODEL_NAME}.lisp exists in ${DEPLOY_FULL_SHA}; the image would run it instead of the VIP model (see VIP collision)."
        fi
        mkdir -p "${context}/models/local"
        cp -- "$DEPLOY_CANDIDATE_ABS" "${context}/${ctx_model}" \
            || die "cannot copy the handoff candidate into the build context."
        got=$(sha256sum "${context}/${ctx_model}" | cut -d' ' -f1)
        [[ "$got" == "$ENVELOPE_HANDOFF_SHA" ]] \
            || die "Handoff SHA mismatch in the build context (wanted ${ENVELOPE_HANDOFF_SHA}, got ${got})."
        echo "Build context: git archive ${DEPLOY_FULL_SHA:0:12} + handoff ${ctx_model}"
    else
        if find "$context" -path '*/models/local/*' -print -quit | grep -q .; then
            die "Refusing to build: models/local/ present in a canonical build context."
        fi
        echo "Build context: git archive ${DEPLOY_FULL_SHA:0:12} (canonical; no models/local/)"
    fi
    echo
    echo "Building Docker image ${IMAGE}"
    # --no-cache: cached RUN layers (e.g. `ros install macnod/*`) can hold
    # old dependency versions while COPY picks up fresh data-ui source,
    # producing an image that mixes new code with stale deps. Deploys are
    # rare; always pay for a clean build.
    docker build --no-cache -t "$IMAGE" "$context" || die "Docker build failed."
    echo
    echo "Importing image into k3d cluster ${K3D_CLUSTER}"
    k3d image import "$IMAGE" -c "$K3D_CLUSTER" \
        || die "k3d image import failed."
}

function assign_node_port {
    mkdir -p "$DEPLOY_STATE_DIR"
    touch "$PORTS_LOCK"
    NODE_PORT=$(awk -v n="$NAME" -v e="$DEPLOY_ENV" \
                    '$1==n && $2==e {print $3}' "$PORTS_LOCK")
    if [[ -n "$NODE_PORT" ]]; then
        echo "Reusing NodePort ${NODE_PORT} from ${PORTS_LOCK}."
        return
    fi
    # The lock file is only a cache; the live Service is the source of
    # truth. If the instance is already deployed, recover its NodePort
    # rather than assigning a new one.
    NODE_PORT=$(kubectl get svc -n "$NAMESPACE" "dataui-${NAME}" \
                    -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null)
    if [[ -n "$NODE_PORT" ]]; then
        echo "$NAME $DEPLOY_ENV $NODE_PORT" >> "$PORTS_LOCK"
        echo "Recovered NodePort ${NODE_PORT} from the live Service" \
             "(recorded in ${PORTS_LOCK})."
        return
    fi
    local used_lock used_k8s port
    used_lock=$(awk '{print $3}' "$PORTS_LOCK")
    used_k8s=$(kubectl get svc -A \
                   -o jsonpath='{.items[*].spec.ports[*].nodePort}' \
                   2>/dev/null | tr ' ' '\n')
    port=$PORT_MIN
    # Reserved NodePorts: published via k3d -p loopback lines
    # (127.0.0.1:3130x:3030x) and pinned by their owners. Never offer
    # them to a new instance -- a stranded -p mapping means another
    # recreate. ($reserved deliberately UNQUOTED in the printf:
    # quoted it is one line "30300 30301 30302" and grep -qx never
    # matches a single port.)
    local reserved="30300 30301 30302"
    while printf '%s\n%s\n%s\n' "$used_lock" "$used_k8s" $reserved \
            | grep -qx "$port"; do
        port=$(( port + 1 ))
    done
    NODE_PORT=$port
    echo "$NAME $DEPLOY_ENV $NODE_PORT" >> "$PORTS_LOCK"
    echo "Assigned new NodePort ${NODE_PORT} (recorded in ${PORTS_LOCK})."
}

function assign_backend_target {
    # Early arithmetic ONLY: the k3d-published loopback hop
    # 127.0.0.1:<nodePort+1000>, stable across bridge-IP drift and
    # cluster recreation, needed by generate_manifests. The probe that
    # the hop actually answers moved AFTER rollout
    # (probe_backend_target), so a first deploy of a new name does not
    # fail closed before an image exists. Twin of k3d_backend_target
    # (~/r/k3d-tools/nodeport.sh); this script cannot source that lib —
    # the deploy clone must stay self-contained.
    NODE_TARGET="127.0.0.1:$(( NODE_PORT + 1000 ))"
    echo "HAProxy target (rendered): ${NODE_TARGET} (published loopback hop; verified after rollout)."
}

function probe_backend_target {
    # Post-rollout verification: the loopback hop must answer — never
    # fall back to the node's bridge IP (docker reassigns bridge IPs on
    # container restart and the rendered target would go stale; the
    # 2026-09-30 vof 503). Any HTTP answer counts; the /health gate
    # right after asserts content. The band 30303-31312 is published by
    # the create block. POLLED like the health gates (5s cadence,
    # DEPLOY_HEALTH_TIMEOUT deadline): a service can stay briefly
    # unreachable in the moments after its rollout completes, and the
    # live VIP deploy of 2026-11-06 showed a single-shot probe turning
    # that transient into a failed deploy with a recovery record. A
    # genuinely unpublished -p band still fails closed.
    local host_port=$(( NODE_PORT + 1000 ))
    local deadline="${DEPLOY_HEALTH_TIMEOUT:-300}" waited=0
    while :; do
        if curl -s -o /dev/null -m 5 "http://127.0.0.1:${host_port}/" 2>/dev/null; then
            echo "Loopback hop 127.0.0.1:${host_port} (nodePort ${NODE_PORT}) answers."
            return 0
        fi
        if (( waited >= deadline )); then
            die "loopback hop 127.0.0.1:${host_port} (nodePort ${NODE_PORT}) did" \
                "not answer within ${deadline}s -- refusing to keep a bridge-IP" \
                "target (fail-closed since 2026-09-30). Either the -p band" \
                "is not published (recreate required) or the service never" \
                "became reachable."
        fi
        sleep 5; waited=$(( waited + 5 ))
    done
}

function get_cluster_secret {
    kubectl get secret -n "$NAMESPACE" "dataui-${NAME}-secrets" \
            -o jsonpath="{.data.$1}" | base64 -d
}

function ensure_instance_secrets {
    if [[ -f "$SECRETS_ENV" ]]; then
        echo "Reusing instance secrets from ${SECRETS_ENV}."
        source "$SECRETS_ENV"
        return
    fi
    mkdir -p "$(dirname "$SECRETS_ENV")"
    # The secrets file is only a cache; the live Secret is the source of
    # truth. Never generate fresh credentials for an existing instance:
    # the PostgreSQL volume keeps the old password, and new credentials
    # would break database auth.
    if kubectl get secret -n "$NAMESPACE" "dataui-${NAME}-secrets" \
               &>/dev/null; then
        {
            echo "DB_PASSWORD=$(get_cluster_secret db-password)"
            echo "ADMIN_PASSWORD=$(get_cluster_secret admin-password)"
            echo "JWT_SECRET=$(get_cluster_secret jwt-secret)"
        } > "$SECRETS_ENV"
        chmod 600 "$SECRETS_ENV"
        echo "Recovered instance secrets from the cluster into ${SECRETS_ENV}."
    else
        {
            echo "DB_PASSWORD=$(openssl rand -hex 16)"
            # rbac's password policy requires a letter, a digit, and a
            # punctuation character; the suffix guarantees all three.
            echo "ADMIN_PASSWORD=$(openssl rand -hex 8)-a1"
            echo "JWT_SECRET=$(openssl rand -hex 16)"
        } > "$SECRETS_ENV"
        chmod 600 "$SECRETS_ENV"
        echo "Generated new instance secrets in ${SECRETS_ENV}."
    fi
    source "$SECRETS_ENV"
}

function render_template {
    local src="$1" dst="$2"
    sed -e "s|{{NAME}}|${NAME}|g" \
        -e "s|{{NAMESPACE}}|${NAMESPACE}|g" \
        -e "s|{{VERSION}}|${VERSION}|g" \
        -e "s|{{TAG}}|${TAG}|g" \
        -e "s|{{IMAGE}}|${IMAGE}|g" \
        -e "s|{{DOMAIN}}|${DOMAIN}|g" \
        -e "s|{{ENV}}|${DEPLOY_ENV}|g" \
        -e "s|{{MODEL_NAME}}|${MODEL_NAME}|g" \
        -e "s|{{NODE_PORT}}|${NODE_PORT}|g" \
        -e "s|{{NODE_IP}}|${NODE_IP}|g" \
        -e "s|{{NODE_TARGET}}|${NODE_TARGET}|g" \
        -e "s|{{DB_PASSWORD}}|${DB_PASSWORD}|g" \
        -e "s|{{ADMIN_PASSWORD}}|${ADMIN_PASSWORD}|g" \
        -e "s|{{JWT_SECRET}}|${JWT_SECRET}|g" \
        "$src" > "$dst"
    # Lines marked #@repl are kept (marker stripped) only when the model's
    # :repl key is true; otherwise they are removed.
    if [[ "$REPL" == "true" ]]; then
        sed -i 's| *#@repl$||' "$dst"
    else
        sed -i '/#@repl$/d' "$dst"
    fi
}

function generate_manifests {
    echo
    echo "Generating manifests in ${OUT_DIR}"
    mkdir -p "$OUT_DIR"
    local tpl base
    for tpl in "$TEMPLATES_DIR"/*.yaml.tpl; do
        base=$(basename "$tpl" .tpl)
        render_template "$tpl" "${OUT_DIR}/${base}"
        echo "  ${OUT_DIR}/${base}"
    done
    # Database init SQL, shipped to the init container via a ConfigMap.
    sed "s/:database_name:/${DB_NAME}/" "$DB_INIT_TEMPLATE" \
        > "${OUT_DIR}/init.sql"
    kubectl create configmap "dataui-${NAME}-init-sql" \
            --namespace "$NAMESPACE" \
            --from-file=init.sql="${OUT_DIR}/init.sql" \
            --dry-run=client -o yaml > "${OUT_DIR}/20-init-sql.yaml"
    rm "${OUT_DIR}/init.sql"
    echo "  ${OUT_DIR}/20-init-sql.yaml"
    # HAProxy drop-in snippet and map entry.
    render_template "${TEMPLATES_DIR}/haproxy-backend.cfg.tpl" \
                    "${OUT_DIR}/haproxy-backend.cfg"
    echo "${DOMAIN} dataui-${NAME}" > "${OUT_DIR}/haproxy-map-entry"
    echo "  ${OUT_DIR}/haproxy-backend.cfg"
    echo "  ${OUT_DIR}/haproxy-map-entry"
}

function apply_manifests {
    echo
    echo "Applying manifests to cluster ${K3D_CLUSTER}"
    # Host path == node path (k3d -v /data/k8s:/data/k8s): create the
    # data dirs on the host before apply, with correct ownership.
    # postgres:16 refuses a root- or user-owned PGDATA: db/ must be
    # 999:999. DirectoryOrCreate would make root-owned dirs instead.
    local data_dir="/data/k8s/data-ui/${NAME}-${DEPLOY_ENV}"
    sudo mkdir -p "${data_dir}/db" "${data_dir}/files"
    sudo chown 999:999 "${data_dir}/db"
    sudo chown "$(id -u):$(id -g)" "${data_dir}/files" "${data_dir}"
    kubectl apply -f "$OUT_DIR" || die "kubectl apply failed."
    kubectl -n "$NAMESPACE" rollout status \
            "deploy/dataui-${NAME}-postgres" --timeout=300s \
        || die "PostgreSQL rollout failed."
    kubectl -n "$NAMESPACE" rollout status \
            "deploy/dataui-${NAME}" --timeout=600s \
        || die "Data UI rollout failed."
}

function haproxy_bootstrap {
    # One-time host setup: enable conf.d, create the map, add the
    # routing rule. Echoes "1" on stdout iff EXTRAOPTS was just added
    # (a full restart is then required: a reload re-execs the master
    # with its original command line, without -f conf.d). Human-readable
    # progress goes to stderr so callers can capture stdout for the
    # restart decision; never return non-zero for that.
    sudo install -d "$HAPROXY_CONF_D"
    [[ -f "$HAPROXY_MAP" ]] || sudo touch "$HAPROXY_MAP"
    local need_restart=""
    if ! grep -q 'conf\.d' "$HAPROXY_DEFAULTS"; then
        echo 'EXTRAOPTS="-S /run/haproxy-master.sock -f /etc/haproxy/conf.d"' \
            | sudo tee -a "$HAPROXY_DEFAULTS" >/dev/null
        echo "Enabled ${HAPROXY_CONF_D} via EXTRAOPTS in ${HAPROXY_DEFAULTS}." >&2
        need_restart=1
    fi
    if ! grep -q 'data-ui\.map' "$HAPROXY_CFG"; then
        sudo sed -i '/^ *default_backend guru/i\    use_backend %[req.hdr(host),lower,map(/etc/haproxy/data-ui.map)] if { req.hdr(host),lower,map(/etc/haproxy/data-ui.map) -m found }' \
             "$HAPROXY_CFG"
        echo "Added data-ui.map routing rule to ${HAPROXY_CFG}." >&2
    fi
    if [[ -n "$need_restart" ]]; then echo 1; fi
}

function haproxy_validate_and_reload {
    # Validate the whole config, then restart (conf.d just enabled) or
    # reload. Dies on validation failure unless the second arg is
    # "tolerant" (profile delete only: warn and continue). A failed
    # restart or reload DIES for every caller: removing a conf.d file
    # or map line changes nothing until the reload, so a silent reload
    # failure would leave routes serving from stale config — the exact
    # window the Model Bank quiescence barrier closes (running HAProxy
    # routes from its loaded config and in-memory map; disk state
    # goes false BEFORE routing stops).
    local need_restart="$1"
    if sudo haproxy -c -f "$HAPROXY_CFG" -f "$HAPROXY_CONF_D" >/dev/null; then
        if [[ -n "$need_restart" ]]; then
            sudo systemctl restart haproxy || die "HAProxy restart failed; routing unchanged (config files on disk do not take effect until a successful restart)."
            echo "HAProxy restarted (conf.d newly enabled)."
        else
            sudo systemctl reload haproxy || die "HAProxy reload failed; routing unchanged (config files on disk do not take effect until a successful reload)."
            echo "HAProxy reloaded."
        fi
    elif [[ "$2" == "tolerant" ]]; then
        echo "WARNING: HAProxy configuration validation failed; not reloading." >&2
    else
        die "HAProxy configuration validation failed; not reloading."
    fi
}

function haproxy_map_delete_backend {
    # Delete map lines whose second field equals the backend exactly
    # (never a substring: purging dataui-profile-foo must not touch
    # dataui-profile-foo-2). A missing map is a no-op, not an error.
    local backend="$1"
    [[ -f "$HAPROXY_MAP" ]] || return 0
    local tmp
    tmp=$(mktemp)
    awk -v b="$backend" '$2 != b' "$HAPROXY_MAP" > "$tmp"
    sudo install -m 644 "$tmp" "$HAPROXY_MAP"
    rm -f "$tmp"
}

function update_haproxy {
    echo
    echo "Updating HAProxy (requires sudo)"
    local need_restart
    need_restart=$(haproxy_bootstrap)
    # One domain, one owner: refuse to hijack a host-profile exposure
    # (profile expose backend). Never rewrite the other side's entry.
    if [[ -f "$HAPROXY_MAP" ]]; then
        local owner=""
        owner=$(awk -v d="$DOMAIN" '$1 == d { print $2; exit }' "$HAPROXY_MAP")
        if [[ "$owner" == dataui-profile-* ]]; then
            local claimed_by="${owner#dataui-profile-}"
            die "Domain ${DOMAIN} is claimed by host profile '${claimed_by}'; run '$SCRIPT_NAME profile unexpose ${claimed_by}' first."
        fi
    fi
    # Per-instance backend and map entry.
    sudo install -m 644 "${OUT_DIR}/haproxy-backend.cfg" \
         "${HAPROXY_CONF_D}/dataui-${NAME}.cfg"
    if grep -q "^${DOMAIN} " "$HAPROXY_MAP"; then
        sudo sed -i "s|^${DOMAIN} .*|${DOMAIN} dataui-${NAME}|" "$HAPROXY_MAP"
    else
        echo "${DOMAIN} dataui-${NAME}" | sudo tee -a "$HAPROXY_MAP" >/dev/null
    fi
    haproxy_validate_and_reload "$need_restart"
}

#
# Deploy candidates (production's models/local/deploy-incoming/)
#

function new_deploy_token {
    # Random token matching [A-Za-z0-9_-]+ (hex here).
    printf 't%s' "$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
}

function snapshot_model_file {
    # $1 = original cwd. Validate MODEL_FILE and copy it to a private
    # mode-600 temp snapshot; sets DEPLOY_HANDOFF_SHA; echoes the
    # snapshot path. Regular file, non-empty, <=1 MiB, not a symlink,
    # SHA-256 recorded — all BEFORE any Git or network mutation
    # (bootstrap clone included). A missing, changed, oversized,
    # directory, or symlink-escape input aborts with no canonical-model
    # fallback and no cluster mutation. Relative paths resolve against
    # the ORIGINAL cwd (e.g. Model Bank's staging root), never the
    # script directory.
    local orig_cwd="$1" path="${MODEL_FILE}" abs real size snap
    if [[ "$path" = /* ]]; then abs="$path"; else abs="${orig_cwd}/${path}"; fi
    [[ -e "$abs" ]] || die "MODEL_FILE '${path}' not found (resolved against the original cwd: ${abs})."
    [[ ! -L "$abs" ]] || die "MODEL_FILE must not be a symlink: ${abs}."
    real=$(readlink -f "$abs") || die "cannot resolve MODEL_FILE ${abs}."
    [[ -f "$real" ]] || die "MODEL_FILE is not a regular file: ${abs}."
    size=$(stat -c %s "$real")
    (( size > 0 )) || die "MODEL_FILE is empty: ${abs}."
    (( size <= 1048576 )) || die "MODEL_FILE is larger than 1 MiB (${size} bytes): ${abs}."
    snap=$(mktemp "${TMPDIR:-/tmp}/data-ui-handoff.XXXXXX") \
        || die "cannot create the handoff snapshot."
    cp -- "$real" "$snap" || { rm -f "$snap"; die "cannot snapshot MODEL_FILE ${abs}."; }
    chmod 600 "$snap"
    DEPLOY_HANDOFF_SHA=$(sha256sum "$snap" | cut -d' ' -f1)
    # Both values, because callers run this through a command
    # substitution: an assignment here cannot cross that boundary, and
    # a caller reading $DEPLOY_HANDOFF_SHA afterward used to get an
    # EMPTY sha — every handoff then failed its hash verification.
    # take_model_snapshot consumes this pair.
    echo "$snap"
    echo "$DEPLOY_HANDOFF_SHA"
}

function take_model_snapshot {
    # take_model_snapshot ORIG_CWD — snapshot_model_file with the
    # subshell boundary handled: captures its two-line output (snapshot
    # path, SHA-256) into MODEL_SNAPSHOT_PATH and DEPLOY_HANDOFF_SHA
    # in THIS shell. A failure inside snapshot_model_file already
    # printed its error from the subshell; exit with its status.
    local out st
    out=$(snapshot_model_file "$1")
    st=$?
    (( st == 0 )) || exit "$st"
    DEPLOY_HANDOFF_SHA=${out##*$'\n'}
    MODEL_SNAPSHOT_PATH=${out%%$'\n'*}
}

function handle_deploy_leftovers {
    # Right after acquiring the production lock and before installing
    # its own candidate: move every file already present in
    # production's deploy-incoming/, bytes intact, to the
    # orphaned-candidates area, printing each move. Never delete one —
    # it may be the only identity of an instance a killed deploy rolled
    # out.
    local dir="${DEPLOY_CHECKOUT}/models/local/deploy-incoming" f ts dest
    [[ -d "$dir" ]] || return 0
    mkdir -p "${DEPLOY_STATE_DIR}/orphaned-candidates"
    while IFS= read -r -d '' f; do
        ts=$(date -u +%Y%m%dT%H%M%SZ)
        dest="${DEPLOY_STATE_DIR}/orphaned-candidates/${ts}-$(basename "$f")"
        mv "$f" "$dest" || die "cannot move the leftover candidate ${f}."
        echo "Moved leftover candidate $(basename "$f") to ${dest}."
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0)
}

function install_deploy_candidate {
    # $1 = snapshot path. Installs the immutable candidate (mode 600,
    # SHA-256 verified against the snapshot) at
    # models/local/deploy-incoming/<token>.lisp in the production
    # checkout, under the production lock (the only writer; the
    # Model Bank worker's incoming file lives in STAGING and is never
    # touched). Sets DEPLOY_CANDIDATE (checkout-relative),
    # DEPLOY_CANDIDATE_ABS, DEPLOY_CANDIDATE_TOKEN.
    local snapshot="$1" dir tok tmp got
    require_incoming_ignored "$DEPLOY_CHECKOUT"
    dir="${DEPLOY_CHECKOUT}/models/local/deploy-incoming"
    mkdir -p "$dir" || die "cannot create ${dir}."
    tok=$(new_deploy_token)
    while [[ -e "${dir}/${tok}.lisp" || -e "${dir}/.${tok}.lisp.tmp" ]]; do
        tok=$(new_deploy_token)
    done
    tmp="${dir}/.${tok}.lisp.tmp"
    cp -- "$snapshot" "$tmp" || die "cannot stage the candidate."
    chmod 600 "$tmp"
    got=$(sha256sum "$tmp" | cut -d' ' -f1)
    [[ "$got" == "$DEPLOY_HANDOFF_SHA" ]] \
        || { rm -f "$tmp"; die "candidate hash mismatch after the copy."; }
    mv "$tmp" "${dir}/${tok}.lisp" || { rm -f "$tmp"; die "cannot install the candidate."; }
    DEPLOY_CANDIDATE="models/local/deploy-incoming/${tok}.lisp"
    DEPLOY_CANDIDATE_ABS="${DEPLOY_CHECKOUT}/${DEPLOY_CANDIDATE}"
    DEPLOY_CANDIDATE_TOKEN="$tok"
}

function deploy_check_identity {
    # After selection, before compilation/tagging/rendering/building:
    # the :name equality check (CLI operand vs the model's declared
    # :name), and — for a handoff — the canonical-collision refusal
    # (resolve-model-path prefers models/<name>.lisp, so the image
    # would silently run the canonical model). Never remove or
    # overwrite the canonical file to make a VIP deploy fit.
    local model="$1" snapshot="$2" name
    if [[ -n "$snapshot" ]]; then
        if checkout_git "$DEPLOY_CHECKOUT" cat-file -e "${SELECTED_FULL_SHA}:models/${model}.lisp" 2>/dev/null; then
            die "models/${model}.lisp exists in ${CHECKOUT_REMOTE}/${CHECKOUT_BRANCH} (${SELECTED_FULL_SHA}); a VIP deploy would silently run that canonical model. Publish the model under another name, or make this deploy canonical."
        fi
        name=$(MODEL_NAME="$model" DATA_UI_MODEL_PATH="$snapshot" model_field name)
    else
        name=$(MODEL_NAME="$model" model_field name)
    fi
    [[ -n "$name" && "$name" != "NIL" ]] || die "Model has no :name."
    [[ "$name" == "$model" ]] \
        || die "Model :name is '${name}' but the deploy operand is '${model}'; they must match."
}

function wait_for_health_200 {
    # $1 url, $2 label, $3 deadline seconds (default 300). Poll every
    # 5 seconds with a 5-second request timeout.
    local url="$1" label="$2" deadline="${3:-300}" waited=0 code
    while :; do
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 5 "$url" 2>/dev/null) || code=000
        [[ "$code" == "200" ]] && return 0
        if (( waited >= deadline )); then
            echo "ERROR: ${label}: no HTTP 200 from ${url} within ${deadline}s (last: ${code:-none})." >&2
            return 1
        fi
        sleep 5; waited=$(( waited + 5 ))
    done
}

#
# Remote deploy/delete forwarder (step 3): a thin forwarder, nothing
# more. The caller never selects a local production clone, never
# inspects or clean-checks its own repo, and never derives a SHA,
# writes facts or tags, pushes, or queries origin — including under
# DRY_RUN=1. The host-side launcher is chosen on the host: the
# production checkout's script if present and executable, otherwise the
# bootstrap checkout's; after first bootstrap the bootstrap checkout is
# never consulted. Under the one-host rule this path never fires
# outside tests; a forwarder failure in production means DEPLOY_HOST is
# misconfigured.
#

function remote_forward_env_string {
    # The environment allowlist: DRY_RUN, checkout/state/source
    # overrides, cluster configuration, and delete's FORCE. Never
    # secrets. Emitted as shell-quoted VAR=... words for the remote
    # bash; the whole remote script travels as ONE argument that
    # survives exactly one reparse.
    local -a fwd=()
    local v
    for v in DRY_RUN FORCE \
             DEPLOY_CHECKOUT STAGING_CHECKOUT CHECKOUT_LOCK_ROOT \
             DEPLOY_HOST STAGING_HOST DEPLOY_BOOTSTRAP_CHECKOUT \
             DEPLOY_STATE_DIR DATA_UI_STATE \
             DATA_UI_PUBLIC_URL DATA_UI_PRIVATE_URL \
             K3D_CLUSTER OPS_LIB_DIR SYSTEMD_UNIT_DIR \
             HAPROXY_CFG HAPROXY_CONF_D HAPROXY_MAP HAPROXY_DEFAULTS \
             STAGING_HEALTH_TIMEOUT; do
        [[ -n "${!v:-}" ]] && fwd+=("$v=$(printf '%q' "${!v}")")
    done
    local IFS=' '
    printf '%s' "${fwd[*]}"
}

function remote_launcher_script {
    # $@ = validated argv for the launcher. Prints the host-side bash
    # script (launcher choice + exec) — a single string, embedded into
    # one `bash -c <quoted>` argument.
    local prod_q boot_q args_q=""
    prod_q=$(printf '%q' "${DEPLOY_CHECKOUT}/scripts/data-ui")
    boot_q=$(printf '%q' "${DEPLOY_BOOTSTRAP_CHECKOUT}/scripts/data-ui")
    local a
    for a in "$@"; do
        args_q+=" $(printf '%q' "$a")"
    done
    cat <<EOF
set -e
launcher=""
if [[ -x $prod_q ]]; then launcher=$prod_q
elif [[ -x $boot_q ]]; then launcher=$boot_q
else
    echo "ERROR: no deploy launcher on this host (tried ${DEPLOY_CHECKOUT}/scripts/data-ui and ${DEPLOY_BOOTSTRAP_CHECKOUT}/scripts/data-ui); run bootstrap first." >&2
    exit 1
fi
# No exec: an EXIT trap installed above (remote MODEL_FILE cleanup)
# must survive the launcher's exit; set -e preserves its status.
"\$launcher"$args_q
EOF
}

function remote_run_script {
    # $1 = remote bash script text. Sends it as ONE argument through
    # one reparse: ssh passes "bash -c <quoted>" to the remote login
    # shell, which reparses exactly once. -t so sudo and delete
    # confirmation can prompt. Never run with an inherited checkout
    # lock descriptor (ssh may leave a ControlMaster behind).
    local script="$1" quoted
    quoted=$(printf '%q' "$script")
    checkout_run_without_locks ssh -t "$DEPLOY_HOST" "bash -c $quoted" \
        || die "Remote ${REMOTE_KIND:-operation} failed."
}

function remote_transfer_model_file {
    # Remote MODEL_FILE: the same 1 MiB + SHA-256 validation locally,
    # then the IMMUTABLE local snapshot (not the original file, which
    # could change between validation and transfer) is transferred
    # non-interactively to a fresh mode-700 host temp directory
    # OUTSIDE both checkouts, verified (type, size, hash) there BEFORE
    # any source mutation. A host-side trap cleans the temp directory
    # on normal exit and on partial transfer; cleanup after a network
    # partition is best-effort, and that is documented. Sets
    # REMOTE_TEMP_DIR / REMOTE_MODEL_FILE and marks the handoff's
    # provenance (DEPLOY_HANDOFF_ORIGIN=remote) so the host-side outer
    # arm emits HANDOFF_KIND=remote.
    local snap sha tdir remote_tmp
    take_model_snapshot "$(pwd)"
    snap="$MODEL_SNAPSHOT_PATH"
    sha="$DEPLOY_HANDOFF_SHA"
    tdir=$(ssh "$DEPLOY_HOST" 't=$(mktemp -d "${TMPDIR:-/tmp}/data-ui-remote-handoff.XXXXXX") && chmod 700 "$t" && echo "$t"') \
        || { rm -f "$snap"; die "cannot create a host temp directory on ${DEPLOY_HOST}."; }
    [[ -n "$tdir" ]] || { rm -f "$snap"; die "empty temp dir answer from ${DEPLOY_HOST}."; }
    local remote_file="${tdir}/model.lisp"
    if ! scp -q "$snap" "${DEPLOY_HOST}:${remote_file}"; then
        rm -f "$snap"
        ssh "$DEPLOY_HOST" "rm -rf $(printf '%q' "$tdir")" >/dev/null 2>&1
        die "transfer of MODEL_FILE to ${DEPLOY_HOST} failed."
    fi
    rm -f "$snap"
    local got
    got=$(ssh "$DEPLOY_HOST" "f=$(printf '%q' "$remote_file"); [[ -f \"\$f\" && ! -L \"\$f\" ]] || exit 3; s=\$(stat -c %s \"\$f\"); [[ \$s -le 1048576 ]] || exit 4; sha256sum \"\$f\" | cut -d' ' -f1") \
        || { ssh "$DEPLOY_HOST" "rm -rf $(printf '%q' "$tdir")" >/dev/null 2>&1; die "MODEL_FILE verification on ${DEPLOY_HOST} failed (type/size)."; }
    if [[ "$got" != "$sha" ]]; then
        ssh "$DEPLOY_HOST" "rm -rf $(printf '%q' "$tdir")" >/dev/null 2>&1
        die "MODEL_FILE hash mismatch after transfer to ${DEPLOY_HOST}; aborting with no mutation."
    fi
    REMOTE_TEMP_DIR="$tdir"
    REMOTE_MODEL_FILE="$remote_file"
    DEPLOY_HANDOFF_ORIGIN="remote"
}

function remote_deploy {
    # Thin forwarder for deploy when hostname != DEPLOY_HOST.
    local model="$1"
    echo "Not on ${DEPLOY_HOST}; forwarding the deploy there."
    local -a fwd_args=(deploy "$model")
    [[ -n "${DEPLOY_FROM_SPEC:-}" ]] && fwd_args+=(--from "$DEPLOY_FROM_SPEC")
    local env_str cleanup_pre=""
    env_str=$(remote_forward_env_string)
    if [[ -n "${MODEL_FILE:-}" ]]; then
        remote_transfer_model_file
        cleanup_pre="trap 'rm -rf $(printf '%q' "$REMOTE_TEMP_DIR")' EXIT
"
        env_str="${env_str} MODEL_FILE=$(printf '%q' "$REMOTE_MODEL_FILE") DEPLOY_HANDOFF_ORIGIN=remote"
    fi
    local launcher_args
    launcher_args=$(remote_launcher_script "${fwd_args[@]}")
    REMOTE_KIND="deploy"
    # `export`, never `env`: the forwarded assignments must apply to
    # THIS remote bash before the launcher lines below. The separator
    # matters too — the launcher script begins with `set -e`, and
    # without the `;` export would treat `set` and `-e` as more
    # NAME=VALUE arguments (`export: '-e': not a valid identifier`),
    # while `env VAR=... set -e` cannot work either (env cannot exec
    # the builtin `set`). Either way the launcher would run with the
    # login shell's inherited environment — no forwarded vars at all.
    remote_run_script "${cleanup_pre}${env_str:+export ${env_str}; }${launcher_args}"
}

function remote_delete {
    # Thin forwarder for delete; -t carries the confirmation prompt.
    local model="$1"
    echo "Not on ${DEPLOY_HOST}; forwarding the delete there."
    local -a fwd_args=(delete "$model")
    local env_str cleanup_pre=""
    env_str=$(remote_forward_env_string)
    if [[ -n "${MODEL_FILE:-}" ]]; then
        remote_transfer_model_file
        cleanup_pre="trap 'rm -rf $(printf '%q' "$REMOTE_TEMP_DIR")' EXIT
"
        env_str="${env_str} MODEL_FILE=$(printf '%q' "$REMOTE_MODEL_FILE") DEPLOY_HANDOFF_ORIGIN=remote"
    fi
    local launcher_args
    launcher_args=$(remote_launcher_script "${fwd_args[@]}")
    REMOTE_KIND="delete"
    # `export`, never `env`: the forwarded assignments must apply to
    # THIS remote bash before the launcher lines below. The separator
    # matters too — the launcher script begins with `set -e`, and
    # without the `;` export would treat `set` and `-e` as more
    # NAME=VALUE arguments (`export: '-e': not a valid identifier`),
    # while `env VAR=... set -e` cannot work either (env cannot exec
    # the builtin `set`). Either way the launcher would run with the
    # login shell's inherited environment — no forwarded vars at all.
    remote_run_script "${cleanup_pre}${env_str:+export ${env_str}; }${launcher_args}"
}

#
# Deploy: outer selection + re-execution, inner body
#

function deploy_outer {
    # The outer arm: parse (already done by the dispatcher), snapshot
    # MODEL_FILE before any Git/network mutation, take the production
    # lock (DRY_RUN included: the compile database on 5446 is one
    # global resource and the lock serializes a developer's dry run
    # against a Model Bank worker's deploy), handle leftovers,
    # bootstrap/validate the clone, select, run the :name and collision
    # checks, install the candidate, then exec the production script
    # with the envelope. No production build ever uses the caller's
    # HEAD, branch, working tree, or remotes.
    export_deploy_environment
    if [[ "$(hostname)" != "$DEPLOY_HOST" ]]; then
        remote_deploy "$DEPLOY_MODEL_NAME"
        return
    fi
    local model="$DEPLOY_MODEL_NAME"
    local orig_cwd snapshot="" kind=none sha="-"
    orig_cwd=$(pwd)
    if [[ -n "${MODEL_FILE:-}" ]]; then
        take_model_snapshot "$orig_cwd"
        snapshot="$MODEL_SNAPSHOT_PATH"
        sha="$DEPLOY_HANDOFF_SHA"
        kind="${DEPLOY_HANDOFF_ORIGIN:-local}"
    fi
    with_checkout_lock production
    local lockfd
    lockfd=$(checkout_lock_fd production)
    handle_deploy_leftovers
    ensure_checkout "$DEPLOY_CHECKOUT" "$DATA_UI_PUBLIC_URL" "$DATA_UI_PRIVATE_URL"
    parse_source_spec "$DEPLOY_FROM_SPEC"
    require_checkout_clean "$DEPLOY_CHECKOUT"
    checkout_fetch_source "$DEPLOY_CHECKOUT" "$CHECKOUT_REMOTE" "$CHECKOUT_BRANCH"
    checkout_move_to_source "$DEPLOY_CHECKOUT" "$CHECKOUT_REMOTE" "$CHECKOUT_BRANCH" "$SELECTED_FULL_SHA"
    cd "$DEPLOY_CHECKOUT" || die "cannot cd to the production checkout ${DEPLOY_CHECKOUT}."
    deploy_check_identity "$model" "$snapshot"
    local cand="-"
    if [[ -n "$snapshot" ]]; then
        install_deploy_candidate "$snapshot"
        cand="$DEPLOY_CANDIDATE"
        rm -f "$snapshot"
        if [[ -n "${DRY_RUN:-}" ]]; then
            echo "DRY_RUN: would promote the stable copy to models/local/${model}.lisp (the candidate ${cand} is temporary; removed at exit)."
        fi
    else
        [[ -f "models/${model}.lisp" ]] \
            || die "No canonical model 'models/${model}.lisp' in ${DEPLOY_CHECKOUT} at ${SELECTED_FULL_SHA}."
    fi
    print_checkout_identity production "$DEPLOY_CHECKOUT" "$CHECKOUT_REMOTE" "$CHECKOUT_BRANCH" "$SELECTED_LOCAL_BRANCH" "$SELECTED_FULL_SHA"
    unset MODEL_FILE
    local marker
    marker=$(checkout_envelope_marker)
    exec "${DEPLOY_CHECKOUT}/scripts/data-ui" \
        "$marker" production "$CHECKOUT_REMOTE" "$CHECKOUT_BRANCH" "$SELECTED_FULL_SHA" \
        "$lockfd" - "$kind" "$cand" "$sha" deploy "$model"
}

function deploy_inner_exit_trap {
    # The inner arm owns cleanup for what it keeps open: the build
    # context and the candidate. A promoted candidate is already
    # renamed; a dry run removes its candidate (nothing persists:
    # deploy-incoming/ ends byte-identical, no registry record, and a
    # following real deploy is unaffected); a failure before
    # apply_manifests removes the candidate; a failure after
    # apply_manifests began preserves it as the recovery record and
    # prints the delete command (only an operator removes recovery
    # records — a failed :domain change may have left a route only the
    # record describes). Dry runs and failures leave any prior stable
    # copy byte-identical.
    local status=$?
    trap - EXIT
    if [[ -n "${DEPLOY_BUILD_CONTEXT:-}" && -d "${DEPLOY_BUILD_CONTEXT:-}" ]]; then
        rm -rf "$DEPLOY_BUILD_CONTEXT"
    fi
    if [[ -n "${DEPLOY_BUILD_ARCHIVE:-}" && -f "${DEPLOY_BUILD_ARCHIVE:-}" ]]; then
        rm -f "$DEPLOY_BUILD_ARCHIVE"
    fi
    if [[ -n "${DEPLOY_PROMOTED:-}" ]] \
       || [[ -z "${DEPLOY_CANDIDATE_ABS:-}" || ! -e "${DEPLOY_CANDIDATE_ABS:-}" ]]; then
        exit "$status"
    fi
    if [[ -n "${DRY_RUN:-}" ]]; then
        rm -f "$DEPLOY_CANDIDATE_ABS"
        echo "DRY_RUN: removed the temporary candidate; deploy-incoming/ left as it was." >&2
        exit "$status"
    fi
    if [[ -z "${DEPLOY_MANIFESTS_APPLIED:-}" ]]; then
        rm -f "$DEPLOY_CANDIDATE_ABS"
        echo "Removed the deploy candidate (failure before rollout)." >&2
        exit "$status"
    fi
    local rec_dir rec
    rec_dir="${DEPLOY_STATE_DIR}/${NAME:-unknown}/recovery"
    mkdir -p "$rec_dir" 2>/dev/null
    rec="${rec_dir}/${DEPLOY_FULL_SHA}-${DEPLOY_CANDIDATE_TOKEN}.lisp"
    if cp -- "$DEPLOY_CANDIDATE_ABS" "$rec" 2>/dev/null; then
        chmod 600 "$rec"
        rm -f "$DEPLOY_CANDIDATE_ABS"
        echo "Recovery record: ${rec}" >&2
        echo "If a route was created and must be removed: MODEL_FILE='${rec}' scripts/data-ui delete '${NAME:-?}'" >&2
    else
        echo "WARNING: could not write the recovery record; candidate left in place: ${DEPLOY_CANDIDATE_ABS}" >&2
    fi
    exit "$status"
}

function promote_deploy_candidate {
    # The promotion point: after image import, rollout,
    # update_haproxy, and BOTH production health gates. A VIP deploy
    # renames its candidate onto the stable models/local/<name>.lisp
    # (workers never write the stable copy); a canonical deploy removes
    # any stale stable copy and reports the removal, so a later bare
    # delete resolves the canonical identity (VIP-to-canonical
    # adoption). Failures and dry runs never reach here.
    local stable="models/local/${MODEL_NAME}.lisp"
    if [[ "${DEPLOY_HANDOFF_KIND:-none}" != "none" ]]; then
        mv -- "$DEPLOY_CANDIDATE_ABS" "$stable" \
            || die "cannot promote the candidate onto ${stable}."
        DEPLOY_PROMOTED=1
        echo "Promoted the candidate to ${stable} (stable VIP identity)."
    else
        if [[ -f "$stable" ]]; then
            rm -f "$stable" \
                || die "cannot remove the stale stable copy ${stable}."
            echo "Removed the stale stable copy ${stable} (canonical model adopted upstream)."
        fi
        DEPLOY_PROMOTED=1
    fi
}

function report_recovery_records {
    # A later successful deploy prints any recovery records it finds
    # but never deletes them: a failed :domain change may have left a
    # route only the record describes. Only an operator removes them.
    local rec_dir="${DEPLOY_STATE_DIR}/${NAME}/recovery" f
    [[ -d "$rec_dir" ]] || return 0
    for f in "$rec_dir"/*.lisp; do
        [[ -f "$f" ]] || continue
        echo "NOTE: recovery record present (operator-only removal): ${f}"
    done
}

function deploy_selected {
    # The deploy body, run by the production script under a verified
    # envelope: compile, facts, tag, node port, backend-target
    # arithmetic, secrets, manifests (the dry run stops here),
    # curated-context build, rollout, the loopback probe + NodePort
    # /health gate, HAProxy update, the public-domain /health gate, and
    # only then promotion.
    DEPLOY_FULL_SHA="$ENVELOPE_FULL_SHA"
    DEPLOY_HANDOFF_KIND="$ENVELOPE_HANDOFF_KIND"
    # Exported: the field reads below shell out to ros with the
    # candidate as DATA_UI_MODEL_PATH, and MODEL_NAME is what
    # identifies the model when the path is an unpredictable token.
    export MODEL_NAME="${ENVELOPE_ARGS[0]}"
    if [[ "$DEPLOY_HANDOFF_KIND" != "none" ]]; then
        # The handoff file exists and hash-matches the envelope (the
        # outer arm installed it under the lock; a dry run's candidate
        # exists too and its EXIT trap removes it).
        [[ -f "$DEPLOY_CANDIDATE_ABS" && ! -L "$DEPLOY_CANDIDATE_ABS" ]] \
            || die "handoff candidate ${DEPLOY_CANDIDATE} is missing in the production checkout."
        local got
        got=$(sha256sum "$DEPLOY_CANDIDATE_ABS" | cut -d' ' -f1)
        [[ "$got" == "$ENVELOPE_HANDOFF_SHA" ]] \
            || die "handoff candidate hash mismatch (${DEPLOY_CANDIDATE})."
        export DATA_UI_MODEL_PATH="$DEPLOY_CANDIDATE"
    else
        export DATA_UI_MODEL_PATH="models/${MODEL_NAME}.lisp"
    fi
    echo
    echo "Deploying ${MODEL_NAME} from the production checkout (source ${ENVELOPE_REMOTE}/${ENVELOPE_BRANCH}, SHA ${DEPLOY_FULL_SHA})."
    compile_model
    gather_deploy_facts
    [[ -n "${DRY_RUN:-}" ]] || create_deploy_tag
    NODE_IP=$(kubectl get nodes -o \
        jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')
    [[ -n "$NODE_IP" ]] || die "Could not determine the k3d node IP."
    assign_node_port
    assign_backend_target
    ensure_instance_secrets
    generate_manifests
    if [[ -n "${DRY_RUN:-}" ]]; then
        echo
        echo "DRY_RUN set; stopping after manifest generation (fetch, fast-forward, compile, and deploy state were real; no tag, image, or cluster mutation)."
        return 0
    fi
    build_image
    DEPLOY_MANIFESTS_APPLIED=1
    apply_manifests
    # Production health gate 1: the loopback hop answers and the
    # NodePort /health returns 200.
    probe_backend_target
    if ! wait_for_health_200 "http://${NODE_TARGET}/health" \
            "NodePort /health gate (${NAMESPACE})" "${DEPLOY_HEALTH_TIMEOUT:-300}"; then
        die "NodePort /health gate failed; taking the recovery path."
    fi
    echo "NodePort /health gate passed (http://${NODE_TARGET}/health)."
    update_haproxy
    # Production health gate 2: the public domain routes and answers.
    # It must follow update_haproxy (a new name or :domain is not
    # routed until then). The failure message names the domain and says
    # it did not resolve or route — *.demo.data-ui.com wildcard DNS and
    # certificate cover only that zone.
    if ! wait_for_health_200 "https://${DOMAIN}/health" \
            "public-domain /health gate" "${DEPLOY_HEALTH_TIMEOUT:-300}"; then
        die "Domain ${DOMAIN} did not resolve or route within ${DEPLOY_HEALTH_TIMEOUT:-300}s (the wildcard DNS/certificate covers *.demo.data-ui.com only). Taking the recovery path; the trap prints the delete command for any route this created."
    fi
    echo "Public-domain /health gate passed (https://${DOMAIN}/health)."
    promote_deploy_candidate
    report_recovery_records
    echo
    echo "Deployed ${RELEASE_NAME}."
    echo "  Source:    ${ENVELOPE_REMOTE}/${ENVELOPE_BRANCH} @ ${DEPLOY_FULL_SHA}"
    echo "  Domain:    https://${DOMAIN}"
    echo "  NodePort:  http://${NODE_IP}:${NODE_PORT}"
    # Convenience during MVP development; remove before this is used for
    # anything sensitive. The password also lives in $SECRETS_ENV and in
    # the cluster Secret (see docs/deployment.md).
    echo "  Admin:     admin / ${ADMIN_PASSWORD}"
    if [[ "$REPL" == "true" ]]; then
        echo "  Swank:     kubectl -n ${NAMESPACE} port-forward" \
             "deploy/dataui-${NAME} 4005:4005"
    fi
}

#
# Bootstrap-only production mode
#

function migrate_legacy_vip_identities {
    # Step-12 cutover action (dormant until then): inventory
    # models/local/*.lisp in every checkout production has deployed
    # from (the bootstrap/development checkout, plus any existing
    # production clone), cross-check against live dataui-* namespaces,
    # and copy each file bytes-intact (SHA-256 verified) to the
    # production clone's models/local/<declared-name>.lisp. Refuse to
    # overwrite a different destination file; reject malformed names,
    # declared-name mismatches, conflicting duplicates, and symlink
    # sources for operator resolution. Never modify the legacy
    # checkout. An empty inventory is printed and is fine. These files
    # never enter an archive build context.
    local -a sources=() migrated=()
    local src f name got dest ns
    [[ -d "${DEPLOY_BOOTSTRAP_CHECKOUT}/models/local" ]] && sources+=("$DEPLOY_BOOTSTRAP_CHECKOUT")
    [[ -d "${DEPLOY_CHECKOUT}/models/local" ]] && sources+=("$DEPLOY_CHECKOUT")
    if (( ${#sources[@]} == 0 )); then
        echo "Legacy VIP identity inventory: empty (no models/local/ under ${DEPLOY_BOOTSTRAP_CHECKOUT} or ${DEPLOY_CHECKOUT})."
        return 0
    fi
    for src in "${sources[@]}"; do
        for f in "${src}/models/local/"*.lisp; do
            [[ -f "$f" ]] || continue
            [[ ! -L "$f" ]] || { echo "ERROR: symlink source ${f} — operator resolution required." >&2; exit 1; }
            name=$(basename "$f" .lisp)
            valid_model_operand "$name" "legacy VIP identity file name"
            got=$(cd "$src" && MODEL_NAME="$name" \
                  DATA_UI_MODEL_PATH="models/local/${name}.lisp" \
                  model_field name 2>/dev/null | tail -1)
            [[ "$got" == "$name" ]] \
                || { echo "ERROR: ${f} declares :name '${got}' but its file name is '${name}' — operator resolution required." >&2; exit 1; }
            dest="${DEPLOY_CHECKOUT}/models/local/${name}.lisp"
            if [[ -f "$dest" ]]; then
                if [[ "$(sha256sum "$f" | cut -d' ' -f1)" != "$(sha256sum "$dest" | cut -d' ' -f1)" ]]; then
                    echo "ERROR: ${dest} already exists with different bytes than ${f} — refusing to overwrite; operator resolution required." >&2
                    exit 1
                fi
                echo "Identity ${name}: already in production (identical bytes)."
                migrated+=("$name")
                continue
            fi
            mkdir -p "${DEPLOY_CHECKOUT}/models/local"
            cp -- "$f" "$dest" || { echo "ERROR: copying ${f} failed." >&2; exit 1; }
            [[ "$(sha256sum "$f" | cut -d' ' -f1)" == "$(sha256sum "$dest" | cut -d' ' -f1)" ]] \
                || { echo "ERROR: SHA-256 mismatch copying ${f}." >&2; exit 1; }
            echo "Migrated legacy VIP identity: ${f} -> ${dest} ($(sha256sum "$f" | cut -d' ' -f1))"
            migrated+=("$name")
        done
    done
    echo "Legacy VIP identity inventory complete: ${#migrated[@]} migrated (${migrated[*]:-none})."
    # Cross-check: every live dataui-* namespace must resolve to an
    # identity production can find (canonical in HEAD or a stable
    # local copy); anything else requires an explicit archived
    # MODEL_FILE delete and must be resolved before cutover completes.
    local -a unexplained=()
    while read -r ns; do
        [[ -n "$ns" ]] || continue
        name="${ns#dataui-}"
        if [[ ! -f "${DEPLOY_CHECKOUT}/models/${name}.lisp" && ! -f "${DEPLOY_CHECKOUT}/models/local/${name}.lisp" ]]; then
            unexplained+=("$name")
        fi
    done < <(kubectl get ns -o name 2>/dev/null | sed 's|^namespace/||' | grep '^dataui-')
    if (( ${#unexplained[@]} > 0 )); then
        echo "ERROR: live instances with no inventoryable identity: ${unexplained[*]}." >&2
        echo "Each requires: MODEL_FILE=<archived model file> scripts/data-ui delete <name>. Resolve before completing cutover." >&2
        exit 1
    fi
}

function deploy_bootstrap_only {
    # deploy-bootstrap: create the production clone, verify remotes,
    # and (at cutover) migrate legacy VIP identities — without
    # compiling, building, or touching the cluster. This, not a dry
    # run, is the first production action.
    export_deploy_environment
    [[ "$(hostname)" == "$DEPLOY_HOST" ]] \
        || die "deploy-bootstrap must run on ${DEPLOY_HOST} (this is $(hostname))."
    with_checkout_lock production
    ensure_checkout "$DEPLOY_CHECKOUT" "$DATA_UI_PUBLIC_URL" "$DATA_UI_PRIVATE_URL"
    migrate_legacy_vip_identities
    echo "Bootstrap-only mode complete: no fetch, compile, build, or cluster mutation."
}

function deploy {
    # Legacy entry: the dispatcher routes deploy through
    # parse_deploy_args + deploy_outer; this function only exists so a
    # stale direct call dies loudly instead of half-deploying.
    die "internal: deploy() reached directly; the dispatcher owns the outer/inner split."
}


function traffic {
    # Show the HAProxy per-IP rate-limit counters (stick-table in the
    # https frontend) and flag clients near or over the limits. Requires
    # sudo for the admin socket.
    local sock="/run/haproxy/admin.sock"
    local cfg="/etc/haproxy/haproxy.cfg"
    [[ -S "$sock" ]] || die "HAProxy admin socket not found at ${sock}."
    # Read the live thresholds from the config so this report never
    # drifts from the rules it describes.
    local lim_cur lim_rate lim_req
    lim_cur=$(grep -oP 'sc_conn_cur\(0\) gt \K[0-9]+' "$cfg")
    lim_rate=$(grep -oP 'sc_conn_rate\(0\) gt \K[0-9]+' "$cfg")
    lim_req=$(grep -oP 'sc_http_req_rate\(0\) gt \K[0-9]+' "$cfg")
    echo "Limits: conn_cur > ${lim_cur:-?} reject," \
         "conn_rate > ${lim_rate:-?}/min reject," \
         "http_req_rate > ${lim_req:-?}/min tarpit"
    echo
    echo "show table https" \
        | sudo socat "$sock" stdio \
        | awk -v lim_cur="${lim_cur:-100}" \
              -v lim_rate="${lim_rate:-200}" \
              -v lim_req="${lim_req:-1000}" '
        BEGIN {
            fmt = "%-40s %9s %10s %13s  %s\n"
            printf fmt, "client", "conn_cur", "conn_rate", "http_req_rate", "status"
        }
        /key=/ {
            ip = ""; cur = 0; rate = 0; req = 0
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^key=/)                 { sub("key=", "", $i); ip = $i }
                if ($i ~ /^conn_cur=/)            { sub(".*=", "", $i); cur = $i }
                if ($i ~ /^conn_rate\(/)          { sub(".*=", "", $i); rate = $i }
                if ($i ~ /^http_req_rate\(/)      { sub(".*=", "", $i); req = $i }
            }
            status = "ok"
            if (cur > lim_cur * 0.8 || rate > lim_rate * 0.8 || req > lim_req * 0.8)
                status = "WARN (>80% of a limit)"
            if (cur > lim_cur)   status = "REJECTING (conn_cur)"
            if (rate > lim_rate) status = "REJECTING (conn_rate)"
            if (req > lim_req)   status = "TARPITTED (http_req_rate)"
            printf fmt, ip, cur, rate, req, status
            n++
        }
        END {
            if (n == 0) print "(no tracked clients; table is empty)"
        }'
    echo
    echo "Note: counters are per source IP; whitelisted IPs are tracked"
    echo "but never rejected. Entries expire after 10 minutes idle."
}

function delete_outer {
    # Delete routes to the existing production checkout's script from
    # any cwd. It does not fetch, switch, require cleanliness, or
    # require a branch. Validates checkout and host, takes the
    # production lock, moves leftovers, optionally installs an identity
    # candidate from an explicit MODEL_FILE, and re-executes with a
    # delete envelope. Delete never advances source to find a model.
    local model="$1"
    export_deploy_environment
    if [[ "$(hostname)" != "$DEPLOY_HOST" ]]; then
        remote_delete "$model"
        return
    fi
    [[ -x "${DEPLOY_CHECKOUT}/scripts/data-ui" ]] \
        || die "No production checkout at ${DEPLOY_CHECKOUT}; run 'scripts/data-ui deploy-bootstrap' first."
    local snapshot="" kind=none sha="-"
    if [[ -n "${MODEL_FILE:-}" ]]; then
        take_model_snapshot "$(pwd)"
        snapshot="$MODEL_SNAPSHOT_PATH"
        sha="$DEPLOY_HANDOFF_SHA"
        kind="${DEPLOY_HANDOFF_ORIGIN:-local}"
    fi
    with_checkout_lock production
    local lockfd
    lockfd=$(checkout_lock_fd production)
    handle_deploy_leftovers
    local cand="-"
    if [[ -n "$snapshot" ]]; then
        install_deploy_candidate "$snapshot"
        cand="$DEPLOY_CANDIDATE"
        rm -f "$snapshot"
    fi
    unset MODEL_FILE
    local marker
    marker=$(checkout_envelope_marker)
    exec "${DEPLOY_CHECKOUT}/scripts/data-ui" \
        "$marker" production - - - "$lockfd" - "$kind" "$cand" "$sha" delete "$model"
}

function delete_selected {
    # The inner delete arm: cd before identity lookup, resolve identity
    # (explicit handoff candidate, canonical models/<name>.lisp, or the
    # stable models/local/<name>.lisp — undeploy's lookup order),
    # validate it fully (NAME == operand, profile/profile-* refusal)
    # BEFORE any snapshot, confirmation, or destructive step, then run
    # the destructive body under the inherited lock.
    cd "$DEPLOY_CHECKOUT" || die "cannot cd to the production checkout ${DEPLOY_CHECKOUT}."
    local model="${ENVELOPE_ARGS[0]}"
    # Exported for the same reason as in deploy_selected: identity
    # reads shell out to ros with the candidate as
    # DATA_UI_MODEL_PATH, and MODEL_NAME identifies the model when
    # the path is an unpredictable deploy token.
    export MODEL_NAME="$model"
    local source_path=""
    if [[ "$ENVELOPE_HANDOFF_KIND" != "none" ]]; then
        export MODEL_FILE="$DEPLOY_CHECKOUT/$ENVELOPE_HANDOFF_PATH"
        source_path="$ENVELOPE_HANDOFF_PATH"
        echo "Identity from the explicit handoff: ${source_path}"
    else
        unset MODEL_FILE
        if [[ -f "models/${model}.lisp" ]]; then
            source_path="models/${model}.lisp"
        elif [[ -f "models/local/${model}.lisp" ]]; then
            source_path="models/local/${model}.lisp"
            echo "No models/${model}.lisp; reading identity from ${source_path} (stable VIP copy)."
        else
            die "No identity for '${model}': neither models/${model}.lisp nor models/local/${model}.lisp exists in ${DEPLOY_CHECKOUT}. An archived MODEL_FILE is the fallback: MODEL_FILE=<path> scripts/data-ui delete ${model}"
        fi
    fi
    export DATA_UI_MODEL_PATH="$source_path"
    # Identity comes from the model, exactly as in deploy; validated
    # before any snapshot, confirmation, or destructive step.
    NAME=$(model_field name)
    DOMAIN=$(model_field domain)
    [[ -n "$NAME" && "$NAME" != "NIL" ]] || die "Model has no :name."
    [[ -n "$DOMAIN" && "$DOMAIN" != "NIL" ]] || die "Model has no :domain."
    [[ "$NAME" == "$model" ]] \
        || die "Model :name is '${NAME}' but the delete operand is '${model}'; they must match."
    # Same predicate the compiler enforces on :name (model.lisp); delete
    # reads the model file without compiling, so the check lives here too.
    # Reserved names can only ever be host-profile exposures.
    if [[ "$NAME" == "profile" || "$NAME" == profile-* ]]; then
        die "Name '${NAME}' is reserved for host profiles; nothing deployed under it."
    fi
    NAMESPACE="dataui-${NAME}"
    local node="k3d-${K3D_CLUSTER}-server-0"
    local data_dir="/data/k8s/data-ui/${NAME}-${DEPLOY_ENV}"
    local state_dir="${DEPLOY_STATE_DIR}/${NAME}"
    local farewell="prd-${NAME}-last"
    echo "About to delete instance '${NAME}' (${DEPLOY_ENV}):"
    echo "  - Kubernetes namespace ${NAMESPACE} and its PVs"
    echo "  - Application data in ${node}:${data_dir}"
    echo "  - HAProxy backend and map entry for ${DOMAIN} (map line only if it points at dataui-${NAME})"
    echo "  - Deploy state in ${state_dir} (including secrets)"
    echo
    echo "This destroys the instance's database and uploaded files."
    echo "A farewell snapshot ('${farewell}') is saved to the shared"
    echo "snapshot pool first, and survives the delete (FORCE=1 skips it)."
    if [[ -z "$FORCE" ]]; then
        local reply
        read -r -p "Type the instance name ('${NAME}') to confirm: " reply
        [[ "$reply" == "$NAME" ]] || die "Confirmation did not match; aborting."
    fi
    # Farewell snapshot: the delete-side twin of the stop verb's
    # p-last refresh. delete destroys the db and files volumes, so the
    # last state is saved to the shared pool first, under the same
    # -last slot shape the stg profile world uses; address-keyed names
    # (prd-todos-last vs stg-todos-last) keep the two apart in the one
    # flat pool. Rotating: a redeploy + re-delete of the same name
    # overwrites it. Saved only when the namespace exists — a re-run
    # after a partial delete has nothing to save and must not block
    # the retry. A failed save dies with the data still intact;
    # FORCE=1 skips the farewell entirely (the "I really mean it"
    # lever, same as the confirmation it also skips). snapshot_save_pair
    # resolves prd:${NAME} from cluster truth (deploy host only —
    # delete already is, or re-execs there via ssh).
    if [[ -n "$FORCE" ]]; then
        echo "FORCE set; skipping the farewell snapshot (${farewell})."
    elif kubectl get ns "$NAMESPACE" &>/dev/null; then
        echo
        echo "Saving farewell snapshot '${farewell}' (prd:${NAME})..."
        snapshot_save_pair "$farewell" "prd:${NAME}"
        echo "Farewell snapshot '${farewell}' is in the pool; it survives"
        echo "the delete (recover into a fresh deploy with 'snapshot"
        echo "restore ${farewell} prd:${NAME}')."
    else
        echo
        echo "Namespace ${NAMESPACE} not found; no farewell snapshot to"
        echo "save (partial-delete re-run)."
    fi
    # Every step tolerates already-deleted resources, so a delete that
    # fails partway can simply be re-run.
    echo
    echo "Deleting namespace ${NAMESPACE}..."
    kubectl delete namespace "$NAMESPACE" --ignore-not-found --timeout=120s
    echo "Deleting persistent volumes..."
    kubectl delete pv --ignore-not-found \
            "dataui-${NAME}-${DEPLOY_ENV}-db-pv" \
            "dataui-${NAME}-${DEPLOY_ENV}-files-pv"
    echo "Deleting application data in ${node}:${data_dir}..."
    # Host path == node path (k3d -v /data/k8s:/data/k8s), so remove
    # on the host directly; docker exec still works, but the host
    # view is authoritative and needs no running node.
    if [[ -d "$data_dir" ]]; then
        sudo rm -rf "$data_dir"
    else
        echo "  ${data_dir} not found on host; skipping."
    fi
    echo "Removing HAProxy backend and map entry (requires sudo)..."
    sudo rm -f "${HAPROXY_CONF_D}/dataui-${NAME}.cfg"
    # Delete the map line only if it points at our deploy backend; a
    # host-profile exposure (dataui-profile-*) owns the domain now.
    # Do not call haproxy_bootstrap: delete must not enable conf.d.
    if [[ -f "$HAPROXY_MAP" ]] \
       && awk -v d="$DOMAIN" -v b="dataui-${NAME}" \
              '$1 == d && $2 == b { found = 1 } END { exit !found }' \
              "$HAPROXY_MAP"; then
        sudo sed -i "\\|^${DOMAIN} |d" "$HAPROXY_MAP"
    fi
    haproxy_validate_and_reload ""
    echo "Removing deploy state in ${state_dir}..."
    rm -rf "$state_dir"
    if [[ -f "$PORTS_LOCK" ]]; then
        sed -i "/^${NAME} ${DEPLOY_ENV} /d" "$PORTS_LOCK"
    fi
    # The identity candidate (explicit MODEL_FILE deletes) is identity
    # only; remove it. A mid-delete death leaves it for the next
    # invocation's leftover handler.
    if [[ -n "${DEPLOY_CANDIDATE_ABS:-}" && -e "${DEPLOY_CANDIDATE_ABS:-}" ]]; then
        rm -f "$DEPLOY_CANDIDATE_ABS"
    fi
    echo
    echo "Deleted instance '${NAME}' (${DEPLOY_ENV})."
    echo "Not removed (housekeeping, see docs/deployment.md):"
    echo "  - Docker images macnod/data-ui:${NAME}-* (daemon and k3d node)"
    echo "  - Git release tags ${NAME}-*"
    echo "  - Farewell snapshot ${farewell} in the snapshot pool (drop"
    echo "    with: $SCRIPT_NAME snapshot drop ${farewell})"
}

#
# Database snapshots (for model switching)
#

# Detect the currently-loaded model name by querying the running
# instance's /api/info endpoint. Falls back to "default" if the
# server is down or unreachable. Retired from snapshot duty by
# Snapshot 2 (no-arg defaults are gone); retained pending a retire /
# retain decision — see docs/model-accessors.md.
function detect_model_name {
    local token
    token=$(curl -s --max-time 3 \
                "http://${HTTP_HOST}:${HTTP_PORT}/api/login" \
                -H 'Content-Type: application/json' \
                -d "{\"username\":\"admin\",\"password\":\"${ADMIN_PASSWORD}\"}" \
        | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d['result']['access-token'])
except Exception:
    sys.exit(1)
" 2>/dev/null) || true
    [[ -n "$token" ]] || true
    curl -s --max-time 3 \
         "http://${HTTP_HOST}:${HTTP_PORT}/api/info" \
         -H "Authorization: Bearer ${token}" \
        | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d['result']['name'])
except Exception:
    sys.exit(1)
" 2>/dev/null || echo "default"
}

# Snapshot dump/restore runs inside the server container, whose client
# tools always match the server's major version. A newer host client
# (e.g. pg_restore 18 against postgres:16) emits SQL the server rejects
# (SET transaction_timeout), which used to leave the schema dropped and
# nothing restored.
function container_pg_dump {
    db_exec pg_dump --format=custom --no-owner --no-privileges
}

function verify_snapshot_archive {
    # The corrupt-archive gate, in the destination's own pg_restore
    # (version-consistent with the server). prd must stage the
    # archive in the pod first: pg_restore -l is an early-exit
    # consumer, and kubectl exec -i never signals EOF to one (see
    # prd_stage_archive) — streaming it hangs after printing the
    # TOC. dev/stg stream through compose exec -T, which has no such
    # bug. psql heredoc stdin (reset_public_schema) is a full-read
    # consumer and verified clean on the same kubectl.
    local path="$1" staged="" rc
    if [[ "${ADDRESS_QUALIFIER:-}" == "prd" ]]; then
        staged=$(prd_stage_archive "$path")
        db_exec pg_restore -l "$staged" >/dev/null
        rc=$?
        prd_unstage_archive "$staged"
        return "$rc"
    fi
    db_exec pg_restore -l < "$path" >/dev/null
}

function container_pg_restore {
    # Reads the custom-format archive from stdin. --single-transaction
    # makes the restore atomic: a failure leaves the schema exactly as
    # it was before the restore started.
    # prd: stdin cannot stream through kubectl exec -i into pg_restore
    # (client-version-dependent EOF behavior; the TOC listing already
    # wedges on kubectl 1.35 — see prd_stage_archive). Buffer stdin to
    # a host temp file, stage it in the pod, restore from the
    # pod-local path, unstage. Covers both call sites (the snapshot
    # and the rollback's safety dump). dev/stg keep compose -T
    # streaming.
    if [[ "${ADDRESS_QUALIFIER:-}" == "prd" ]]; then
        local tmp staged rc
        tmp=$(mktemp "${TMPDIR:-/tmp}/data-ui-restore-stdin.XXXXXX") \
            || die "cannot create a restore staging temp file."
        cat > "$tmp" || { rm -f "$tmp"; die "could not buffer the archive for staging."; }
        staged=$(prd_stage_archive "$tmp")
        rm -f "$tmp"
        db_exec pg_restore --no-owner --no-privileges --exit-on-error \
                --single-transaction "$staged"
        rc=$?
        prd_unstage_archive "$staged"
        return "$rc"
    fi
    db_exec pg_restore --no-owner --no-privileges --exit-on-error \
            --single-transaction
}

# Drop and recreate the public schema so a restore starts clean.
function reset_public_schema {
    db_exec psql -v ON_ERROR_STOP=1 >/dev/null <<SQL
DROP SCHEMA public CASCADE;
CREATE SCHEMA public;
GRANT ALL ON SCHEMA public TO ${DB_USER};
GRANT ALL ON SCHEMA public TO public;
SQL
}

function snapshot_files_path {
    # Files side of a snapshot pair (may not exist; old snapshots and
    # DOCUMENT_ROOT-less saves have DB only).
    echo "${SNAPSHOT_DIR}/${1}.files.tar.gz"
}

function write_snapshot_meta_atomically {
    # Stage the .meta; the caller moves it onto the slot name with the
    # rest of the triple (never a half-written manifest beside a
    # committed dump). Identity comes from the address plus the model
    # file — never from /api/info. model-version is best-effort
    # (get_model_field reads the model file; a ros blip must not fail
    # a save); its absence is legal.
    local staged="$1" src_address="$2" model="$3" version resolved
    {
        echo "model=${model}"
        echo "source-address=${src_address}"
        echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        # prd-motivated but qualifier-blind: a Deploy-button instance
        # may have no model file in this checkout (it lives in the
        # deploy clone's models/local/). Local-only models exist in
        # dev and stg trees too, so the resolver answers for every
        # qualifier: no file at either location → no model_field call
        # → no model-version line (the genuine prd/deploy-clone skip).
        # The guard lives here, not in the resolver, so verb_stop's
        # stg-p-last refresh and every other caller get the same skip.
        resolved=$(resolve_model_file "$model")
        if [[ -n "$resolved" ]]; then
            version=$(MODEL_NAME="$model" DATA_UI_MODEL_PATH="$resolved" model_field version)
            if [[ -n "$version" && "$version" != "NIL" ]]; then
                echo "model-version=${version}"
            fi
        fi
    } > "$staged"
}

function snapshot_save_pair {
    # Snapshot 2 save wrapper: <name> <src-address>. Owns the
    # /api/info confirm and the .meta write so internal callers
    # (verb_stop's p-last refresh) share the CLI path's checks.
    # Triple-staging (D16 pair rule grown a manifest): dump and .meta
    # are required, the files tar stages only when DOCUMENT_ROOT
    # exists; the triple moves onto the slot names when dump + .meta
    # succeeded (the tar moves too, when staged). A missing files
    # tree must not fail the save — DB-only snapshots stay legal and
    # still drop a stale tar (pair-consistency rule unchanged).
    local name="$1" src_address="$2"
    local dpath fpath dump_tmp files_tmp meta_tmp
    valid_snapshot_name "$name"
    resolve_snapshot_address "$src_address" "source"
    confirm_model_for_save "$ADDRESS_QUALIFIER" "$ADDRESS_MODEL"
    dpath="${SNAPSHOT_DIR}/${name}.dump"
    fpath="$(snapshot_files_path "$name")"
    require_postgres_running
    mkdir -p "$SNAPSHOT_DIR"
    dump_tmp=$(mktemp "${SNAPSHOT_DIR}/.tmp-XXXXXX")
    if ! container_pg_dump > "$dump_tmp"; then
        rm -f "$dump_tmp"
        die "pg_dump failed; snapshot '${name}' not saved (previous" \
            "triple intact)."
    fi
    meta_tmp=$(mktemp "${SNAPSHOT_DIR}/.tmp-XXXXXX")
    if ! write_snapshot_meta_atomically "$meta_tmp" \
             "$src_address" "$ADDRESS_MODEL"; then
        rm -f "$dump_tmp" "$meta_tmp"
        die "could not write .meta; snapshot '${name}' not saved" \
            "(previous triple intact)."
    fi
    files_tmp=""
    if [[ -d "$DOCUMENT_ROOT" ]]; then
        files_tmp=$(mktemp "${SNAPSHOT_DIR}/.tmp-XXXXXX")
        # Canonical top-level entry files/ regardless of the source's
        # basename (dev packs tests/shared-files/, stg packs
        # profiles/<p>/files/): the tar is portable across
        # environments; restore renames the single top-level dir to
        # the destination's DOCUMENT_ROOT basename during the swap.
        # Straight from the tree (same shape as snapshot_restore's
        # prerestore staging); no staging copy of DOCUMENT_ROOT.
        if ! tar -czf "$files_tmp" -C "$(dirname "$DOCUMENT_ROOT")" \
                  --transform "s|^$(basename "$DOCUMENT_ROOT")|files|" \
                  "$(basename "$DOCUMENT_ROOT")"; then
            rm -f "$dump_tmp" "$meta_tmp" "$files_tmp"
            die "tar failed; snapshot '${name}' not saved (dump staged," \
                "not moved; previous triple intact)."
        fi
    fi
    mv "$dump_tmp" "$dpath"
    mv "$meta_tmp" "$(meta_path "$name")"
    if [[ -n "$files_tmp" ]]; then
        mv "$files_tmp" "$fpath"
        echo "Saved snapshot '${name}':"
        echo "  ${dpath}"
        echo "  ${fpath}"
        echo "  $(meta_path "$name")"
    else
        # A triple must be internally consistent: a fresh dump beside a
        # stale tar is the mixed state this helper exists to prevent.
        if [[ -f "$fpath" ]]; then
            echo "warning: DOCUMENT_ROOT (${DOCUMENT_ROOT}) missing;" \
                 "dropping stale files side ${fpath}"
            rm -f "$fpath"
        fi
        echo "warning: DOCUMENT_ROOT (${DOCUMENT_ROOT}) missing;" \
             "snapshot '${name}' saved DB only"
        echo "Saved snapshot '${name}':"
        if [[ "${ADDRESS_QUALIFIER:-}" == "prd" ]]; then
            echo "  ${dpath} (${PRD_PG_DEPLOY}:5432/${DB_NAME})"
        else
            echo "  ${dpath} (${DB_HOST}:${DB_PORT}/${DB_NAME})"
        fi
    fi
}

function snapshot_restore {
    # Snapshot 2 restore wrapper: <name> <dst-address>. Owns the
    # model-mismatch refusal (.meta vs the destination address's
    # model), the /api/info confirm (skip on unreachable — the app
    # down is the natural restore shape), the cross-env password
    # notice, and the prerestore slot's own .meta. The prerestore
    # slot is derived from the DEST address (dev:books ->
    # dev-books-prerestore); the slot name alone does not imply it.
    # prd destinations are deliberately stricter: every check that
    # can fail runs before the scale-to-0 (never scale prod down for
    # a typo), confirm_model_for_restore is skipped entirely (its
    # two possible answers are both dead weight under prd), and the
    # body is wrapped in quiesce → EXIT trap → revive.
    local name="$1" dst_address="$2"
    local path="${SNAPSHOT_DIR}/${name}.dump"
    local slot safety_tmp safety_files safety_meta
    valid_snapshot_name "$name"
    resolve_snapshot_address "$dst_address" "destination"
    if [[ ! -f "$path" ]]; then
        echo "Error: snapshot '${name}' not found at ${path}" >&2
        echo "Available snapshots:"
        snapshot_list
        exit 1
    fi
    [[ -s "$path" ]] || die "Snapshot '${name}' is empty; nothing to restore."
    # Model mismatch is never overridable: the snapshot's .meta.model
    # vs the DESTINATION address's model (never require profile name
    # == model name). Missing .meta (old snapshots): prominent
    # warning — password provenance unknown — then proceed.
    local snap_model src_address
    snap_model="$(meta_read "$name" model)"
    src_address="$(meta_read "$name" source-address)"
    if [[ -n "$snap_model" ]]; then
        if [[ "$snap_model" != "$ADDRESS_MODEL" ]]; then
            die "Refusing restore: snapshot '${name}' holds model '${snap_model}' (.meta), but the destination ${dst_address} is model '${ADDRESS_MODEL}'. A model mismatch is never overridable (FORCE does not apply)."
        fi
    else
        echo "WARNING: snapshot '${name}' has no .meta — model and" \
             "password provenance unknown; proceeding." >&2
    fi
    # Model-version compare is tri-state: warn only when BOTH sides
    # have a version and they differ (migration stubs carry none and
    # must not journal a warning on every nightly restore forever).
    local snap_version dest_version resolved
    snap_version="$(meta_read "$name" model-version)"
    resolved=$(resolve_model_file "$ADDRESS_MODEL")
    if [[ -n "$resolved" ]]; then
        dest_version=$(MODEL_NAME="$ADDRESS_MODEL" DATA_UI_MODEL_PATH="$resolved" model_field version)
    else
        dest_version=""
        echo "note: no models/${ADDRESS_MODEL}.lisp or models/local/${ADDRESS_MODEL}.lisp in this checkout (deployed instance); skipping the version compare" >&2
    fi
    if [[ -n "$snap_version" && -n "$dest_version" \
          && "$dest_version" != "NIL" \
          && "$snap_version" != "$dest_version" ]]; then
        echo "warning: model version differs — snapshot '${name}' is" \
             "v${snap_version}, destination is v${dest_version}" >&2
    fi
    if [[ "$ADDRESS_QUALIFIER" != "prd" ]]; then
        confirm_model_for_restore "$ADDRESS_MODEL"
    fi
    # All checks that can fail run BEFORE the prd scale-to-0:
    # postgres reachable, then the TOC (a corrupt archive must die
    # while prod is still up — never scale-to-0 for a typo, and never
    # pay for a safety dump of a live prod DB first).
    require_postgres_running
    mkdir -p "$SNAPSHOT_DIR"
    if ! verify_snapshot_archive "$path"; then
        # Runs before any prd scale-to-0, so prod is still up here —
        # no trap armed, nothing to disarm; die plain.
        die "Snapshot '${name}' is not a readable archive;" \
            "database untouched."
    fi
    if [[ "$ADDRESS_QUALIFIER" == "prd" ]]; then
        echo "prd destination: scaling ${PRD_NAMESPACE}/deploy/$(prd_app_deploy) to 0 for the duration (ratified: prod downtime beats a live-app restore while there are no transactions)."
        prd_quiesce
        slot="$(address_slot_prefix "$dst_address")-prerestore"
        # Trap state for prd_restore_trap (globals: the trap handler
        # cannot see this function's locals).
        PRD_SLOT="$slot"
        PRD_SAFETY_TMP="" PRD_SAFETY_META="" PRD_SAFETY_FILES=""
        PRD_DROP_STARTED="" PRD_SWAP_STARTED="" PRD_KEEP_ASIDE=""
        PRD_RESTORE_DOCROOT="$DOCUMENT_ROOT"
        PRD_RESTORE_DONE=""
        PRD_RESTORE_ACTIVE=1
        trap prd_restore_trap EXIT
    fi
    # The pre-restore safety net is the rotating address-keyed slot
    # (dest address, colon -> dash). Stage the current DB, files tree,
    # and a fresh .meta to temp names; on failure roll back FROM temp;
    # on success move all onto the slot names. The slot's .meta:
    # source-address = the DEST address of THIS restore (the slot
    # holds the dest's pre-restore data), model from that address.
    slot="$(address_slot_prefix "$dst_address")-prerestore"
    safety_tmp=$(mktemp "${SNAPSHOT_DIR}/.tmp-XXXXXX")
    if ! container_pg_dump > "$safety_tmp"; then
        rm -f "$safety_tmp"
        die "Pre-restore pg_dump failed; database untouched."
    fi
    safety_meta=$(mktemp "${SNAPSHOT_DIR}/.tmp-XXXXXX")
    if ! write_snapshot_meta_atomically "$safety_meta" \
             "$dst_address" "$ADDRESS_MODEL"; then
        rm -f "$safety_tmp" "$safety_meta"
        die "could not stage the prerestore .meta; database untouched."
    fi
    safety_files=""
    if [[ -d "$DOCUMENT_ROOT" ]]; then
        safety_files=$(mktemp "${SNAPSHOT_DIR}/.tmp-XXXXXX")
        # Canonical files/ top level, same as the save path.
        if ! tar -czf "$safety_files" -C "$(dirname "$DOCUMENT_ROOT")" \
                  --transform "s|^$(basename "$DOCUMENT_ROOT")|files|" \
                  "$(basename "$DOCUMENT_ROOT")"; then
            rm -f "$safety_files"
            safety_files=""
            echo "warning: could not stage the files tree; prerestore" \
                 "slot will hold DB only" >&2
        fi
    fi
    if [[ "$ADDRESS_QUALIFIER" == "prd" ]]; then
        PRD_SAFETY_TMP="$safety_tmp" PRD_SAFETY_META="$safety_meta"
        PRD_SAFETY_FILES="$safety_files"
    fi
    # Drop the entire public schema (tables, functions, triggers,
    # sequences) and recreate it so the restore is clean.
    if [[ "$ADDRESS_QUALIFIER" == "prd" ]]; then
        PRD_DROP_STARTED=1
    fi
    if ! reset_public_schema; then
        rm -f "$safety_tmp" "$safety_files" "$safety_meta"
        die "Could not reset the public schema; database may be inconsistent."
    fi
    if ! container_pg_restore < "$path"; then
        echo "ERROR: restoring '${name}' failed; rolling back." >&2
        if container_pg_restore < "$safety_tmp"; then
            rm -f "$safety_tmp" "$safety_files" "$safety_meta"
            echo "Rolled back to the pre-restore state;" \
                 "database unchanged." >&2
        else
            # Rollback failed: promote the staged dump + .meta to the
            # slot so the only copy is findable, and say where.
            mv "$safety_tmp" "${SNAPSHOT_DIR}/${slot}.dump" 2>/dev/null
            mv "$safety_meta" "$(meta_path "$slot")" 2>/dev/null
            rm -f "$safety_files"
            echo "CRITICAL: rollback failed. The pre-restore state is" \
                 "saved at ${SNAPSHOT_DIR}/${slot}.dump; recover" \
                 "manually." >&2
        fi
        # prd: disarm FIRST — the trap must not scale the app back up
        # right after the body deliberately left it down (and on the
        # CRITICAL branch it would race a scale-up against a database
        # the message just called recover-only-by-hand). Both message
        # paths converge on this single exit 1, so one disarm covers
        # both; both messages state the 0-replicas contract below.
        if [[ "$ADDRESS_QUALIFIER" == "prd" ]]; then
            PRD_RESTORE_ACTIVE=""
            trap - EXIT
            echo "The app is STILL AT 0 REPLICAS by design (a restore" \
                 "over a possibly-bad database must not serve). Revive" \
                 "manually with: kubectl -n ${PRD_NAMESPACE} scale" \
                 "deploy/$(prd_app_deploy) --replicas=1" \
                 "— or re-run the restore." >&2
        fi
        exit 1
    fi
    if [[ "$ADDRESS_QUALIFIER" == "prd" ]]; then
        # Flag the swap window for the trap before the files swap
        # starts; prd_restore_swap_done clears it once the new tree
        # is in place.
        prd_swap_begin
    fi
    snapshot_restore_files "$name" || true
    if [[ "$ADDRESS_QUALIFIER" == "prd" ]]; then
        prd_swap_end
    fi
    stamp_admin_password
    # Full success: rotate the staged triple onto the prerestore slot.
    mv "$safety_tmp" "${SNAPSHOT_DIR}/${slot}.dump"
    mv "$safety_meta" "$(meta_path "$slot")"
    if [[ -n "$safety_files" ]]; then
        mv "$safety_files" "$(snapshot_files_path "$slot")"
    fi
    echo "Pre-restore state saved to slot '${slot}'" \
         "(rotating; overwritten by the next restore)"
    snapshot_password_notice "$name" "$dst_address" "$src_address"
    if [[ "$ADDRESS_QUALIFIER" == "prd" ]]; then
        # Disarm before the revive's health predicate can fail (a
        # failing predicate prints the slot and exits nonzero; the
        # trap would double-revive and double-report).
        PRD_RESTORE_DONE=1
        trap - EXIT
        if ! prd_revive "$slot"; then
            exit 1
        fi
        echo "Restored snapshot '${name}' ← ${path} (${PRD_PG_DEPLOY}:5432/${DB_NAME})"
    else
        echo "Restored snapshot '${name}' ← ${path} (${DB_HOST}:${DB_PORT}/${DB_NAME})"
    fi
}

function stamp_admin_password {
    # Re-stamp the admin password hash after a restore, so the
    # destination's own ADMIN_PASSWORD is the working password again
    # (auth rows travel with the dump; the env does not). Hash must
    # match rbac's a:password-hash exactly: sha512(salt ++ password)
    # hex, first 32 chars, salt = the username ("admin"). Verified
    # against the live REPL: printf '%s' "adminadmin-password-1" |
    # sha512sum | cut -c1-32 == d8249d32... The hash is provably
    # [0-9a-f]{32}, so interpolating it into the SQL is safe (the
    # password itself never reaches a query). Warn, never die, on a
    # zero-row update — the restore already succeeded; killing the
    # command here would strand a good database.
    local hash rows
    hash=$(printf '%s' "admin${ADMIN_PASSWORD}" | sha512sum | cut -c1-32)
    [[ "$hash" =~ ^[0-9a-f]{32}$ ]] \
        || die "Could not compute the admin password hash (got '${hash}'); database restored, password NOT re-stamped."
    rows=$(db_exec psql -v ON_ERROR_STOP=1 -tA \
             -c "update users set password_hash = '${hash}', updated_at = now() where user_name = 'admin' returning id")
    if [[ -z "$rows" ]]; then
        echo "WARNING: no 'admin' user in the restored database —" \
             "password not re-stamped." >&2
        return 1
    fi
    local origin
    case "$ADDRESS_QUALIFIER" in
        dev) origin="the dev environment (static admin-password-1)" ;;
        prd) origin="the ${PRD_NAMESPACE} Secret (dataui-${ADDRESS_NAME}-secrets)" ;;
        *)   origin="${ADDRESS_QUALIFIER}:${ADDRESS_NAME}'s profile.env" ;;
    esac
    echo "Admin password re-stamped to the destination's own" \
         "(ADMIN_PASSWORD from ${origin})."
}

function snapshot_password_notice {
    # Cross-env restore notice. The stamp already re-wrote the
    # destination's admin password (stamp_admin_password), so this
    # no longer explains where the working password lives — only that
    # auth rows otherwise traveled (other users' hashes included) and
    # sessions break. Keyed on .meta.source-address ≠ dest address —
    # NOT on qualifier equality (stg:todos → stg:mytodos is
    # same-qualifier but still a cross-address swap). Equal addresses
    # stay quiet (the nightly; migrated stubs carry
    # source-address=stg:<p>). The dest JWT_SECRET is unchanged (it
    # lives in the env, never in the dump — sessions break because
    # the user table was swapped).
    local name="$1" dst_address="$2" src_address="$3"
    [[ "$src_address" == "$dst_address" ]] && return 0
    echo "NOTICE: cross-environment restore (${src_address:-unknown source} → ${dst_address})."
    if [[ -z "$src_address" ]]; then
        echo "  Snapshot '${name}' has no .meta — provenance unknown; the admin password was still re-stamped from the destination's env."
    fi
    echo "  The auth rows traveled with the dump (only 'admin' was re-stamped); log in again. The destination's JWT_SECRET is unchanged (it lives in the env, never in the dump); old sessions break because the user table was swapped, not because the secret was."
}

function snapshot_restore_files {
    # Swap, never delete-then-untar: extract to staging beside the
    # snapshots, validate the layout, then mv old tree aside and the
    # fresh one in. A failed untar must not leave the instance
    # fileless (same shape as the pre-restore safety dump).
    # Snapshot 2: the tar's top-level entry is any single directory
    # (new saves canonicalize it to files/); it is renamed to the
    # destination's DOCUMENT_ROOT basename during the swap — old tars
    # on disk become portable retroactively.
    local name="$1"
    local fpath staging parent base ts keep top
    fpath="$(snapshot_files_path "$name")"
    if [[ ! -f "$fpath" ]]; then
        echo "(no files side; restored database only)"
        return
    fi
    # prd hole (rounds 3–4): a prd resolve exports an EMPTY
    # DOCUMENT_ROOT when the instance has no files PV, and
    # basename ""/dirname "" are nonsense ("", "."). A DB-only prd
    # restore that still holds a files-side tar would otherwise die
    # after the DB restore already succeeded. Skip before any path
    # arithmetic; qualifier-blind because the function's other callers
    # are exactly the "resolver guaranteed a real directory" shape
    # that makes the hole invisible until a new arm opens it.
    if [[ -z "$DOCUMENT_ROOT" ]]; then
        echo "note: destination has no files side (empty DOCUMENT_ROOT);" \
             "files tar for '${name}' left in the pool, not restored"
        return
    fi
    base=$(basename "$DOCUMENT_ROOT")
    parent=$(dirname "$DOCUMENT_ROOT")
    staging=$(mktemp -d "${SNAPSHOT_DIR}/.tmp-files-XXXXXX")
    if ! tar -xzf "$fpath" -C "$staging"; then
        rm -rf "$staging"
        die "files tar for '${name}' unreadable; database restored," \
            "files left untouched."
    fi
    # Exactly one top-level directory (any name): guards against a
    # hand-made tar with an unexpected layout.
    top=$(ls -A "$staging")
    if [[ $(printf '%s\n' "$top" | wc -l) -ne 1 ]] \
       || [[ ! -d "${staging}/${top}" ]]; then
        rm -rf "$staging"
        die "files tar for '${name}' has unexpected layout (wanted" \
            "exactly one top-level directory); database restored," \
            "files left untouched."
    fi
    ts=$(date +%Y%m%d-%H%M%S)
    keep="${parent}/${base}.pre-restore-${ts}"
    if [[ -e "$DOCUMENT_ROOT" ]]; then
        mv "$DOCUMENT_ROOT" "$keep" || {
            rm -rf "$staging"
            die "Could not move the old files tree aside; database" \
                "restored, files left untouched."
        }
    fi
    if ! mv "${staging}/${top}" "$DOCUMENT_ROOT"; then
        rm -rf "$staging"
        if [[ -e "$keep" ]]; then
            mv "$keep" "$DOCUMENT_ROOT" \
                || echo "CRITICAL: could not restore the old files" \
                     "tree; recover it from ${keep}" >&2
        fi
        die "Could not move the restored files tree into place."
    fi
    rm -rf "$staging" "$keep"
    echo "Restored files side ← ${fpath}"
}

function snapshot_list {
    # The shared pool: names + provenance from .meta (annotated, never
    # resolved). A missing .meta prints (no .meta) — hand-named and
    # orphan dumps stay legal, and silent empty provenance looks like
    # a bug. Neat columns: two passes — collect and measure (name and
    # size-group widths), then printf %-*s. Timestamp is fixed-width
    # and provenance is last, so neither needs measuring.
    if [[ ! -d "$SNAPSHOT_DIR" ]] \
       || [[ -z "$(ls -A "$SNAPSHOT_DIR" 2>/dev/null)" ]]; then
        echo "No snapshots found in ${SNAPSHOT_DIR}"
        return
    fi
    local f base size files provenance model version source ts ts_re sgroup
    local -a names sizes stamps provs
    local name_w=0 size_w=0 i
    ts_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}'
    for f in "$SNAPSHOT_DIR"/*.dump; do
        [[ -f "$f" ]] || continue
        base=$(basename "$f" .dump)
        size=$(du -h "$f" | cut -f1)
        files=""
        [[ -f "$(snapshot_files_path "$base")" ]] && files=", +files"
        model="$(meta_read "$base" model)"
        version="$(meta_read "$base" model-version)"
        source="$(meta_read "$base" source-address)"
        # UTC stamp: the .meta save time when it parses; else the
        # .dump's mtime (covers meta-less orphans and migrated
        # stubs, whose stamp is the literal "migrated").
        ts="$(meta_read "$base" timestamp)"
        if [[ ! "$ts" =~ $ts_re ]]; then
            ts="$(date -u -r "$f" +%Y-%m-%dT%H:%M:%SZ)"
        fi
        if [[ -f "$(meta_path "$base")" ]]; then
            # The source address already names the model; only the
            # version rides the provenance.
            provenance="${source:-?}"
            [[ -n "$version" ]] && provenance+=", v${version}"
        else
            provenance="(no .meta)"
        fi
        sgroup="(${size}${files})"
        names+=("$base")
        sizes+=("$sgroup")
        stamps+=("$ts")
        provs+=("$provenance")
        if (( ${#base} > name_w )); then name_w=${#base}; fi
        if (( ${#sgroup} > size_w )); then size_w=${#sgroup}; fi
    done
    echo "Snapshots in ${SNAPSHOT_DIR}:"
    for i in "${!names[@]}"; do
        printf '  %-*s  %-*s  %s  %s\n' \
            "$name_w" "${names[$i]}" \
            "$size_w" "${sizes[$i]}" \
            "${stamps[$i]}" "${provs[$i]}"
    done
}

function snapshot_drop {
    # Removes the whole triple: .dump + .files.tar.gz + .meta.
    local name="$1"
    valid_snapshot_name "$name"
    local path="${SNAPSHOT_DIR}/${name}.dump"
    if [[ ! -f "$path" ]]; then
        echo "Error: snapshot '${name}' not found" >&2
        exit 1
    fi
    rm "$path"
    rm -f "$(snapshot_files_path "$name")" "$(meta_path "$name")"
    echo "Deleted snapshot '${name}'"
}

function snapshot_migrate {
    # One-time migration to address-keyed slots (stays in the tree as
    # a maintenance verb; idempotent, safe to re-run by hand if the
    # ordered window is interrupted). Loops $DATA_UI_STATE/profiles/
    # ($HOST_STATE_DIR, never a hardcoded /data/data-ui/profiles/ —
    # the dumps live under $DATA_UI_STATE/snapshots and a split
    # between the two spellings is the D15 footgun), and for each
    # renames the {golden,last,prerestore} slots. Idempotence is PER
    # SLOT, PER FILE — never a whole-slot skip: a crash between
    # dump-mv and tar-mv leaves the dest dump in place with the tar
    # at its legacy name; a re-run keyed on the dest dump alone would
    # skip the tar forever. Three independent steps, each keyed on
    # its own destination file:
    #   rename the dump iff the dest dump is missing
    #   rename the tar iff the dest tar is missing AND the source
    #     exists (a DB-only slot has no tar — nothing to move)
    #   write the stub .meta iff the dest .meta is missing
    # Without the stub, every nightly restore of a migrated golden
    # prints the missing-.meta warning into the journal, forever.
    # Orphans and hand-named non-slot dumps stay unrenamed and
    # .meta-less — legal (names are plain names now).
    mkdir -p "$SNAPSHOT_DIR"
    local d p model slot name src dst moved=0
    [[ -d "$HOST_STATE_DIR" ]] || { echo "No profiles in ${HOST_STATE_DIR}; nothing to migrate."; return 0; }
    for d in "$HOST_STATE_DIR"/*/; do
        [[ -f "${d}profile.env" ]] || continue
        p="$(basename "$d")"
        model=$(sed -n 's/^MODEL_NAME=//p' "${d}profile.env" | tail -n1)
        for slot in golden last prerestore; do
            name="${p}-${slot}"
            for ext in dump files.tar.gz; do
                src="${SNAPSHOT_DIR}/${name}.${ext}"
                dst="${SNAPSHOT_DIR}/stg-${name}.${ext}"
                if [[ -f "$src" && ! -f "$dst" ]]; then
                    mv "$src" "$dst"
                    moved=$(( moved + 1 ))
                    echo "renamed ${name}.${ext} → stg-${name}.${ext}"
                fi
            done
            dst="${SNAPSHOT_DIR}/stg-${name}.meta"
            if [[ ! -f "$dst" && -f "${SNAPSHOT_DIR}/stg-${name}.dump" ]]; then
                {
                    echo "model=${model}"
                    echo "source-address=stg:${p}"
                    echo "timestamp=migrated"
                } > "$dst"
                echo "stubbed stg-${name}.meta (model ${model})"
            fi
        done
    done
    echo "Migration complete: ${moved} file(s) renamed." \
         "Re-runs are no-ops (per-file idempotence)."
}

function setup_repl_env {
    # $1 = optional profile name. Sets REPL_PROFILE so start_repl can
    # tell a named (staging) REPL from an unnamed development one.
    local profile="$1"
    REPL_PROFILE="$profile"
    if [[ -n "$profile" ]]; then
        load_profile "$profile"
        preflight_ports "$profile"
    else
        export_repl_environment
        render_init_sql
        preflight_ports "dev"
    fi
    ensure_storage_dirs
}

#
# Demo lifecycle verbs (D14/D16): e-demo for the nightly-reset class
# (todos, books), demo for the no-reset class (modelbank). Both are
# sugar over systemctl + the snapshot machinery; one start shape, one
# class-blind teardown. =repl= is retired from profile duty — units
# own demo apps, and Slime rides the unit's swank port as a passenger.
#

function verb_app_port_listening {
    # The verb's own preflight: the *app* is up iff HTTP_PORT listens.
    # Never preflight_ports here — that helper also refuses on DB_PORT
    # / SWANK_PORT, and DB_PORT held by our own compose is the
    # raw-stop / aborted-stop / partial-start state the start verb
    # must proceed through (D16 don't-unify).
    ss -ltn 2>/dev/null | awk '{print $4}' \
        | grep -qE "[:.]${HTTP_PORT}\$"
}

function verb_profile_container_up {
    docker ps --format '{{.Names}}' \
        | grep -qx "$DB_CONTAINER"
}

function stamp_demo_class {
    # Idempotent rewrite of the DEMO_CLASS line in profile.env (D14):
    # class = how the profile was last started. A *first* start is
    # unconstrained (no stamp exists to contradict), so a wrong verb
    # silently opts a fresh profile out of the nightly set — the
    # "class stamped" print is the tripwire.
    local profile="$1" class="$2" env staged
    env="$(profile_env_path "$profile")"
    if grep -q "^DEMO_CLASS=" "$env" 2>/dev/null; then
        if grep -qx "^DEMO_CLASS=${class}$" "$env"; then
            return
        fi
        sed -i "s|^DEMO_CLASS=.*|DEMO_CLASS=${class}|" "$env"
    else
        staged=$(mktemp)
        { cat "$env"; echo "DEMO_CLASS=${class}"; } > "$staged"
        cat "$staged" > "$env"   # preserve mode 600, same inode
        rm -f "$staged"
        echo "class stamped: ${class} (first start)"
    fi
    export DEMO_CLASS="$class"
}

function verb_start {
    local class="$1" profile="$2" _flag="${3:-}" from_snapshot="${4:-}"
    local restore_name
    # Both verbs cd to the checkout at entry: the stamped
    # DB_DOCKER_COMPOSE is checkout-relative, and so is every compose
    # call they make (D14 step 2).
    cd "$(dirname "$(readlink -f "$0")")/.." || die "cannot cd to checkout"
    load_profile "$profile"
    # Preflight: refuse only if the app is up. DB_PORT held by our own
    # compose is the state we must proceed through; a stranger on it
    # fails loudly at compose up.
    if verb_app_port_listening; then
        die "Profile '${profile}' app is already up (HTTP_PORT" \
            "${HTTP_PORT} listening). Nothing to start."
    fi
    # Cross-class refusal needs a stamp, and a stamp exists only after
    # a first start (D14). Absent = first start, unconstrained.
    if [[ -n "${DEMO_CLASS:-}" ]] && [[ "$DEMO_CLASS" != "$class" ]]; then
        local others
        if [[ "$class" == "e-demo" ]]; then others="demo"; else others="e-demo"; fi
        die "Profile '${profile}' is a ${DEMO_CLASS} (stamped in" \
            "profile.env); use '${others} start ${profile}'." \
            "Class changes go through stop + profile delete + recreate."
    fi
    # Vacuum check BEFORE the verb's own mkdir -p / compose up —
    # either materializes the bind source and would make every start
    # look live (D16).
    local vacuum=t
    if [[ -d "$PGDATA_DIR" ]]; then
        vacuum=""
        echo "volume wins: live pgdata present"
    fi
    # mkdir -p (mode 700, host user) — never let docker create the
    # bind source as root (verified uid pattern, D16).
    mkdir -m 700 -p "$PGDATA_DIR"
    chown "$PG_UID:$PG_GID" "$PGDATA_DIR" 2>/dev/null || true
    echo "Starting PostgreSQL (compose up)"
    compose up -d \
        || die "compose up failed (is port ${DB_PORT} held by a stranger?)."
    # pg_isready pinned: exec -T (no TTY) and -U "$DB_USER" — never
    # wait_for_postgres, whose branches are exec -it / -U postgres
    # (both wrong under a profile; D14 step 2).
    local waited=0
    until compose exec -T "$DB_SERVICE" pg_isready -U "$DB_USER" \
            &>/dev/null; do
        if (( waited >= 60 )); then
            die "PostgreSQL did not become ready in 60s."
        fi
        sleep 2; waited=$(( waited + 2 ))
    done
    # Restore: only into a vacuum, unless --from (D16).
    if [[ -n "$from_snapshot" ]]; then
        if [[ ! -f "${SNAPSHOT_DIR}/${from_snapshot}.dump" ]]; then
            die "Snapshot '${from_snapshot}' not found" \
                "(--from fails hard; degrade-to-empty is defaults only)."
        fi
        echo "restoring over live data: ${from_snapshot}"
        snapshot_restore "$from_snapshot" "stg:${profile}"
    elif [[ -n "$vacuum" ]]; then
        # Class default. e-demo → stg-p-golden; demo → stg-p-last.
        # Call site 5 consumes $restore_name as-is, so BOTH branches
        # must carry the stg- prefix (a half-renamed branch leaves
        # e-demo looking for <p>-golden.dump after the migration and
        # silently bootstrapping empty on every resume). A missing
        # slot degrades to an empty start with a warning — the
        # bootstrap case (D14/D16), not an error.
        if [[ "$class" == "e-demo" ]]; then
            restore_name="stg-${profile}-golden"
        else
            restore_name="stg-${profile}-last"
        fi
        if [[ -f "${SNAPSHOT_DIR}/${restore_name}.dump" ]]; then
            echo "restoring into vacuum: ${restore_name}"
            snapshot_restore "$restore_name" "stg:${profile}"
        else
            echo "warning: no snapshot '${restore_name}'; empty start" \
                 "(bootstrap). Seed via the admin UI, then" \
                 "'$SCRIPT_NAME snapshot save ${restore_name} stg:${profile}'."
        fi
    fi
    stamp_demo_class "$profile" "$class"
    render_init_sql
    # init.sql with errors suppressed — load-bearing after a restore
    # (CREATE TABLE without IF NOT EXISTS over a restored schema);
    # do NOT "fix" the suppression (D16 don't-unify).
    psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" \
         -f "$DB_INIT_SQL" &>/dev/null || true
    sudo systemctl enable --now "dataui@${profile}"
    echo
    echo "Unit dataui@${profile} enabled and started."
    echo "  HTTP:  http://127.0.0.1:${HTTP_PORT}"
    echo "  Swank: 127.0.0.1:${SWANK_PORT} (passenger; connect freely)"
    echo "  Cold first start compiles the system — watch:" \
         "journalctl -u dataui@${profile} -f"
}

function verb_stop {
    # One teardown under both verb names, class-blind (D16: the class
    # taxonomy lives on start only).
    local profile="$1"
    cd "$(dirname "$(readlink -f "$0")")/.." || die "cannot cd to checkout"
    load_profile "$profile"
    # Already stopped = the environment is gone (no container, no
    # pgdata): report, exit 0, no rewrite (D14). A disabled unit with
    # pgdata present (dump-failure abort) falls through and completes
    # the teardown — a retry, never a re-enable.
    if [[ ! -d "$PGDATA_DIR" ]] && ! verb_profile_container_up; then
        echo "Profile '${profile}' is already stopped" \
             "(no container, no pgdata)."
        return 0
    fi
    # 1. disable -- now: no reboot resurrection; frees the ports
    #    profile delete refuses against. Postgres stays up (no
    #    ExecStop; compose untouched by systemctl).
    sudo systemctl disable --now "dataui@${profile}" 2>/dev/null || true
    # 2. p-last refresh BEFORE any further teardown, atomically over
    #    the triple (snapshot_save_pair). A failed dump aborts here with
    #    the previous p-last intact — a pause is never left without a
    #    resume copy (risk 26). The app is ALWAYS down at this point;
    #    an unreachable /api/info skips the confirm quietly (the
    #    wrapper's stg branch) — the pause must not look like a fault.
    snapshot_save_pair "stg-${profile}-last" "stg:${profile}"
    # 3. compose down --volumes, then a VERIFIED rm -rf of pgdata —
    #    the bind mount survives compose down, and only the explicit
    #    removal creates the vacuum the next start restores into.
    compose down --remove-orphans --volumes &>/dev/null || true
    rm -rf "$PGDATA_DIR"
    if [[ -d "$PGDATA_DIR" ]]; then
        die "pgdata survived rm -rf (${PGDATA_DIR}); half-deleted is" \
            "neither vacuum nor live data — resolve by hand."
    fi
    # HAProxy is deliberately untouched (D14): the domain stays
    # claimed, the stopped demo serves 503s, its checks flap — honest.
    echo "Stopped '${profile}': unit disabled, p-last refreshed," \
         "environment torn down."
    echo "Profile, exposure, and snapshots intact; resume with the" \
         "start verb."
}

function verb_reset {
    # On-demand golden reset through the nightly's own machinery
    # (Phase 7). No args (e-demo only) = the enabled set via
    # dataui-reset.service — the same run the 04:10 timer makes,
    # journald as the log of record. Explicit names bypass the enabled
    # check, any class (D13 grungy-day; e.g. 'demo reset modelbank').
    # Ops installation belongs to 'staging update' ALONE: this verb
    # never reinstalls the reset script, and explicit-name resets keep
    # running the installed copy unchanged.
    local class="$1"; shift
    local installed_ops="${OPS_LIB_DIR:-/usr/local/lib/data-ui}/petting-zoo-reset.sh"
    local p lock fd
    if (( $# == 0 )) && [[ "$class" != "e-demo" ]]; then
        die "${class} profiles are never in the nightly set — name" \
            "one, e.g. '$SCRIPT_NAME demo reset modelbank'."
    fi
    for p in "$@"; do
        valid_profile_name "$p"
    done
    cd "$(dirname "$(readlink -f "$0")")/.." || die "cannot cd to checkout"
    if (( $# == 0 )); then
        # Courtesy probe only (accepted race): the no-args reset refuses
        # when a non-blocking flock finds the staging lock held, but the
        # updater can still acquire the lock between probe and
        # systemctl start. Recovery for a reset that ran against a
        # half-updated tree is rerunning 'staging update'. No second
        # lifecycle lock.
        lock=$(checkout_lock_file staging)
        fd=""
        # No 2>/dev/null on this open: redirections on a bare exec
        # persist in the shell, so it would swallow every error
        # message for the rest of the invocation (the refusal below
        # included). A failed open prints one honest line and falls
        # back — bash does not exit on a {fd} redirection error.
        exec {fd}<>"$lock" || fd=""
        if [[ -n "$fd" ]]; then
            if flock -n -x "$fd"; then
                exec {fd}>&-
            else
                exec {fd}>&-
                die "A staging update appears to be in progress (the staging lock is held); refusing to start the nightly reset. Re-run after it finishes, or rerun 'staging update' afterwards if it already raced."
            fi
        fi
        echo "Running the nightly set on demand; blocks until done."
        if ! sudo systemctl start dataui-reset.service; then
            journalctl -u dataui-reset.service -n 15 --no-pager >&2 || true
            die "dataui-reset.service failed — journal tail above."
        fi
        echo "Nightly reset complete."
        echo "Log of record: journalctl -u dataui-reset.service"
    else
        sudo "$installed_ops" "$@" \
            || die "Reset failed: $* (the ops script printed why)."
        echo "Reset complete: $*"
    fi
}

function demo_verb {
    local class="$1"; shift
    local action="$1" profile="$2" flag="${3:-}" snap="${4:-}"
    if [[ "$action" == "reset" ]]; then
        # reset takes any number of profiles (zero = the nightly
        # set); the start/stop arg shape and --from do not apply.
        verb_reset "$class" "${@:2}"
        return
    fi
    [[ -n "$profile" ]] \
        || die "Usage: $SCRIPT_NAME ${class} {start|stop|reset} <profile>" \
               "[--from <snapshot>]"
    if [[ -n "$flag" && "$flag" != "--from" ]]; then
        die "Unknown option '${flag}' (only --from <snapshot>)."
    fi
    case "$action" in
        start) verb_start "$class" "$profile" "$flag" "$snap" ;;
        stop)  verb_stop "$profile" ;;
        *) die "Usage: $SCRIPT_NAME ${class} {start|stop|reset} <profile>" \
               "[--from <snapshot>]" ;;
    esac
}

#
# Staging environment: dispatcher verbs, the update supervisor/child,
# Model Bank quiescence + activation, and the orphan scanner.
#

function staging_one_host_check {
    # Canonical STAGING_HOST and DEPLOY_HOST must name the same host.
    # Load-bearing, not a simplification: get-deployed-admin-password
    # (lisp) is a plain local read of $DATA_UI_STATE/deploy/<name>/
    # secrets.env written by the deploy on the deploy host, so Model
    # Bank's deploy-model-record-secret works only on one machine;
    # profile HAProxy operations are host-local too. A differing pair
    # is rejected before lockfile, Git, npm, SSH, or systemd mutation.
    [[ "$STAGING_HOST" == "$DEPLOY_HOST" ]] \
        || die "STAGING_HOST (${STAGING_HOST}) and DEPLOY_HOST (${DEPLOY_HOST}) must name the same host (one-host rule); splitting them is a separate item."
}

function modelbank_activation_state_path {
    echo "$DATA_UI_STATE/profiles/modelbank/activation.state"
}

function write_modelbank_activation_state {
    # Atomic (temp + rename) write of the COMPLETE record: exact key
    # set, mode 600. Field ownership: only original-exposed is
    # operator-authoritative (written once, at step 0); every phase and
    # SHA transition belongs to staging update / activate-modelbank,
    # which never treat a hand-written phase as proof that a locked
    # drain happened.
    local original="$1" phase="$2" target="$3" activated="$4"
    local path tmp
    path=$(modelbank_activation_state_path)
    tmp="${path}.tmp.$$"
    mkdir -p "$(dirname "$path")" || die "cannot create $(dirname "$path")."
    {
        echo "original-exposed=${original}"
        echo "phase=${phase}"
        echo "target-staging-sha=${target}"
        echo "activated-staging-sha=${activated}"
    } > "$tmp" || die "cannot write ${tmp}."
    chmod 600 "$tmp"
    mv "$tmp" "$path" || { rm -f "$tmp"; die "cannot install ${path}."; }
}

function read_modelbank_activation_state {
    # Strict parse of activation.state: exact key set, valid values, no
    # duplicates — parsed, never sourced. Sets MB_STATE_original_exposed,
    # MB_STATE_phase, MB_STATE_target, MB_STATE_activated; returns 1 when
    # the file is absent and dies on any deviation.
    local path line key val
    path=$(modelbank_activation_state_path)
    MB_STATE_original_exposed=""
    MB_STATE_phase=""
    MB_STATE_target=""
    MB_STATE_activated=""
    [[ -f "$path" ]] || return 1
    local -A seen=()
    while IFS= read -r line; do
        [[ "$line" =~ ^[a-z-]+=[-0-9a-zA-Z]+$ ]] \
            || die "malformed activation.state line: '${line}'"
        key="${line%%=*}"
        val="${line#*=}"
        [[ -z "${seen[$key]:-}" ]] || die "duplicate key '${key}' in activation.state"
        seen[$key]=1
        case "$key" in
            original-exposed)
                [[ "$val" == "0" || "$val" == "1" ]] \
                    || die "bad original-exposed='${val}' in activation.state"
                MB_STATE_original_exposed="$val"
                ;;
            phase)
                [[ "$val" == "quiesced" || "$val" == "activated" ]] \
                    || die "bad phase='${val}' in activation.state"
                MB_STATE_phase="$val"
                ;;
            target-staging-sha)
                [[ "$val" == "-" || "$val" =~ ^[0-9a-f]{40}$ ]] \
                    || die "bad target-staging-sha='${val}' in activation.state"
                MB_STATE_target="$val"
                ;;
            activated-staging-sha)
                [[ "$val" == "-" || "$val" =~ ^[0-9a-f]{40}$ ]] \
                    || die "bad activated-staging-sha='${val}' in activation.state"
                MB_STATE_activated="$val"
                ;;
            *)
                die "unknown key '${key}' in activation.state"
                ;;
        esac
    done < "$path"
    local k
    for k in original-exposed phase target-staging-sha activated-staging-sha; do
        [[ -n "${seen[$k]:-}" ]] || die "missing key '${k}' in activation.state"
    done
    return 0
}

function staging_modelbank_running_query {
    # The drain query: plain rows, loud failure (ON_ERROR_STOP). The
    # columns are Model Bank's stored status companions (verified live
    # 2026-11-05). A query or connection failure is a failed drain,
    # never empty. Requires the modelbank profile already loaded.
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" \
        -v ON_ERROR_STOP=1 -Atc \
        "select model_name from rt_models where model_deploy_status = 'running' or model_generate_status = 'running'"
}

function staging_modelbank_running {
    # Private query helper (staging modelbank-running): not a public
    # SQL verb. Loads the modelbank profile through the profile loader
    # and prints the running rows.
    cd "$(canonical_checkout_root)" || die "cannot cd to $(canonical_checkout_root)"
    load_profile modelbank
    staging_modelbank_running_query
}

function modelbank_drain {
    # Drain without the production lock, up to MODELBANK_DRAIN_TIMEOUT
    # seconds (default 600 = 10 minutes; the override exists for tests,
    # like STAGING_HEALTH_TIMEOUT): a running worker's script needs the
    # production lock to finish, so taking production first would
    # deadlock. Safe because admission is HTTP through the HAProxy
    # route and the confirmed reload already cut it: no new row can
    # become running, so the set only shrinks. On timeout, report every
    # model_name and abort; never reset a stranded row.
    local deadline="${MODELBANK_DRAIN_TIMEOUT:-600}"
    local waited=0 rows
    while :; do
        if ! rows=$(staging_modelbank_running_query); then
            die "modelbank drain query failed (connection or SQL error); a failed drain is never empty."
        fi
        if [[ -z "$rows" ]]; then
            echo "modelbank drained (no rt_models rows running)."
            return 0
        fi
        if (( waited >= deadline )); then
            echo "ERROR: modelbank drain timed out after ${deadline}s; still running:" >&2
            printf '%s\n' "$rows" >&2
            die "Never reset a stranded row; investigate the models above."
        fi
        echo "modelbank drain: waiting on running rows ($(printf '%s' "$rows" | tr '\n' ' '))..."
        sleep 10
        waited=$(( waited + 10 ))
    done
}

function modelbank_quiesce {
    # Shared by staging update and activate-modelbank, in this order:
    #  1. absent profile: print it, write nothing, skip (the caller
    #     still takes its locks normally)
    #  2. unit state: active and inactive proceed (a stopped unit still
    #     needs unexpose + drain — a crash may have stranded rows and
    #     its Postgres stays up); anything else fails closed BEFORE any
    #     checkout mutation
    #  3. state file: absent → capture current exposure as
    #     original-exposed (complete record); present → preserve it and
    #     require current unexposure when phase says quiesced. Then, in
    #     update mode only, set phase=quiesced and clear both SHA
    #     fields before any checkout mutation
    #  4. unexpose, confirmed at the reload (the reload, not disk
    #     state, is what cuts admission)
    #  5. drain without the production lock (<=10 min)
    #  6. THEN take production (staging is already held — the item's
    #     only two-role order) and recheck both statuses once; abort
    #     before checkout mutation if any row is running
    # $1 = update | activate.
    local mode="$1" env_file unit_state original
    env_file=$(profile_env_path modelbank)
    if [[ ! -f "$env_file" ]]; then
        echo "No modelbank profile (${env_file}); skipping quiescence."
        return 0
    fi
    unit_state=$(systemctl is-active dataui@modelbank 2>/dev/null)
    case "$unit_state" in
        active|inactive)
            echo "dataui@modelbank is ${unit_state}; proceeding with quiescence."
            ;;
        *)
            die "dataui@modelbank is '${unit_state}' (expected active or inactive); failing closed before any checkout mutation."
            ;;
    esac
    if read_modelbank_activation_state; then
        original="$MB_STATE_original_exposed"
        if [[ "$MB_STATE_phase" == "quiesced" ]]; then
            haproxy_env
            if profile_is_exposed modelbank; then
                die "activation.state says quiesced but modelbank is exposed; failing closed (the drain's admission assumption would not hold)."
            fi
        fi
    else
        haproxy_env
        if profile_is_exposed modelbank; then original=1; else original=0; fi
        echo "Captured modelbank original-exposed=${original} (first quiescence)."
        write_modelbank_activation_state "$original" quiesced - -
    fi
    if [[ "$mode" == "update" ]]; then
        write_modelbank_activation_state "$original" quiesced - -
    fi
    haproxy_env
    require_haproxy_host "modelbank quiescence"
    unexpose_profile modelbank
    if profile_is_exposed modelbank; then
        die "modelbank still reads as exposed after unexpose; failing closed."
    fi
    cd "$(canonical_checkout_root)" || die "cannot cd to $(canonical_checkout_root)"
    load_profile modelbank
    modelbank_drain
    with_checkout_lock production
    local rows
    if ! rows=$(staging_modelbank_running_query); then
        die "modelbank drain recheck query failed; aborting before any checkout mutation."
    fi
    if [[ -n "$rows" ]]; then
        echo "ERROR: rows still running after the drain (a request was inside Hunchentoot when the route was cut):" >&2
        printf '%s\n' "$rows" >&2
        die "Aborting before checkout mutation; never reset a stranded row."
    fi
    echo "modelbank quiesced and drained; holding both locks."
}

#
# Timer supervision (staging update)
#

function staging_capture_timer_state {
    # BEFORE any wait or mutation; the capture is the restoration
    # truth. Accept only enabled/disabled and active/inactive; any
    # other state (masked, runtime, not-found, unknown) or a command
    # error fails untouched.
    STAGING_TIMER_ENABLED=$(systemctl is-enabled dataui-reset.timer 2>/dev/null)
    STAGING_TIMER_ENABLED_STATUS=$?
    STAGING_TIMER_ACTIVE=$(systemctl is-active dataui-reset.timer 2>/dev/null)
    STAGING_TIMER_ACTIVE_STATUS=$?
    [[ "$STAGING_TIMER_ENABLED" == "enabled" || "$STAGING_TIMER_ENABLED" == "disabled" ]] \
        || die "dataui-reset.timer is-enabled returned '${STAGING_TIMER_ENABLED}'; only enabled/disabled are acceptable — leaving everything untouched."
    [[ "$STAGING_TIMER_ACTIVE" == "active" || "$STAGING_TIMER_ACTIVE" == "inactive" ]] \
        || die "dataui-reset.timer is-active returned '${STAGING_TIMER_ACTIVE}'; only active/inactive are acceptable — leaving everything untouched."
    echo "Timer captured: enabled=${STAGING_TIMER_ENABLED} active=${STAGING_TIMER_ACTIVE}."
}

function staging_restore_timer_state {
    # After every stop attempt — including one whose stop returned
    # nonzero — restore the captured state, verify it, fail loudly.
    # Stop only the timer; never start dataui-reset.service as cleanup
    # and never invoke the nightly reset manually. Catch-up:
    # Persistent=true means restoring an originally active timer after
    # crossing 04:10 fires the reset at once, on success or failure —
    # accepted (documented systemd behavior).
    if [[ "${STAGING_TIMER_ENABLED:-}" == "enabled" ]]; then
        sudo systemctl enable dataui-reset.timer >/dev/null 2>&1
    else
        sudo systemctl disable dataui-reset.timer >/dev/null 2>&1
    fi
    if [[ "${STAGING_TIMER_ACTIVE:-}" == "active" ]]; then
        sudo systemctl start dataui-reset.timer
    fi
    local en ac
    en=$(systemctl is-enabled dataui-reset.timer 2>/dev/null)
    ac=$(systemctl is-active dataui-reset.timer 2>/dev/null)
    [[ "$en" == "$STAGING_TIMER_ENABLED" && "$ac" == "$STAGING_TIMER_ACTIVE" ]] \
        || { echo "ERROR: timer restoration failed (wanted enabled=${STAGING_TIMER_ENABLED} active=${STAGING_TIMER_ACTIVE}, got ${en}/${ac})." >&2; return 1; }
    echo "Timer restored: enabled=${en} active=${ac}."
}

function staging_supervisor_exit {
    # Preserves the original exit status unless restoration itself
    # fails. Restoration happens only after the selected child exits
    # (this trap is the only restoration path).
    local status=$?
    trap - EXIT
    staging_restore_timer_state || exit 1
    exit "$status"
}

function staging_wait_reset_service_idle {
    # dataui-reset.service is Type=oneshot without RemainAfterExit, so
    # a running reset reads active or activating; inactive means
    # finished; anything else fails closed. Wait up to 15 minutes for
    # inactive (never stop it).
    local state waited=0
    state=$(systemctl is-active dataui-reset.service 2>/dev/null)
    case "$state" in
        inactive)
            return 0
            ;;
        active|activating)
            echo "dataui-reset.service is ${state}; waiting up to 15 minutes (never stopping it)."
            while :; do
                sleep 10
                waited=$(( waited + 10 ))
                state=$(systemctl is-active dataui-reset.service 2>/dev/null)
                [[ "$state" == "inactive" ]] && return 0
                if (( waited >= 900 )); then
                    die "dataui-reset.service still ${state} after 15 minutes; aborting untouched."
                fi
            done
            ;;
        *)
            die "dataui-reset.service is '${state}' (expected active/activating/inactive); failing closed, untouched."
            ;;
    esac
}

function staging_pause_timer {
    if ! sudo systemctl stop dataui-reset.timer; then
        echo "WARNING: stopping dataui-reset.timer returned nonzero; continuing (restoration is still verified)." >&2
    fi
}

function staging_recheck_reset_service {
    # The pre-pause wait can cross 04:10; after pausing, recheck once.
    # A reset that started during the wait ran normally; one that is
    # running NOW aborts for a later retry.
    local state
    state=$(systemctl is-active dataui-reset.service 2>/dev/null)
    case "$state" in
        inactive)
            return 0
            ;;
        active|activating)
            die "A reset started around the timer pause (state ${state}); aborting for a later retry."
            ;;
        *)
            die "dataui-reset.service is '${state}' at the final check; failing closed."
            ;;
    esac
}

function staging_update_supervisor {
    # staging update [--from REMOTE/BRANCH] (default private/master).
    # The supervisor: host checks, staging lock, sudo preflight, timer
    # capture/wait/pause, Model Bank quiescence, production lock,
    # bootstrap + selection, then the selected staging script as a
    # CHILD (never exec — this shell's EXIT trap owns timer
    # restoration, which cannot survive exec). The child inherits
    # staging as LOCK_FD and production as PROD_LOCK_FD; the supervisor
    # keeps its descriptors open until timer restoration completes.
    # Before the first bootstrap, the selected upstream must already
    # contain this implementation.
    local from_spec="private/master"
    case "${1:-}" in
        "") ;;
        --from)
            [[ -n "${2:-}" ]] || die "--from requires a value: '--from REMOTE/BRANCH'."
            [[ -z "${3:-}" ]] || die "extra arguments after --from REMOTE/BRANCH."
            from_spec="$2"
            ;;
        *)
            die "Unknown argument '${1}' for staging update (only --from REMOTE/BRANCH)."
            ;;
    esac
    export_deploy_environment
    staging_one_host_check
    [[ "$(hostname)" == "$STAGING_HOST" ]] \
        || die "staging update must run on ${STAGING_HOST} (this is $(hostname))."
    parse_source_spec "$from_spec"
    local remote="$CHECKOUT_REMOTE" branch="$CHECKOUT_BRANCH"
    # Noninteractive sudo preflight before the first mutation: a
    # password prompt mid-pipeline would leave the timer paused.
    sudo -n true 2>/dev/null \
        || die "sudo needs a password; run 'sudo -v' first (staging update only proceeds with cached credentials)."
    with_checkout_lock staging
    staging_capture_timer_state
    staging_wait_reset_service_idle
    # Cleanup traps BEFORE stopping the timer: a failure after the
    # pause must still restore it.
    trap 'staging_supervisor_exit' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    staging_pause_timer
    staging_recheck_reset_service
    local status=0
    # Model Bank is quiesced before EVERY staging checkout mutation —
    # always, with no exemption even when an activated record exists:
    # every Deploy runs scripts/data-ui afresh from Model Bank's
    # loaded checkout, so once that checkout's script changes, old
    # Lisp calls a new script with old-contract inputs. It is never
    # restarted by staging update; its process keeps old loaded code
    # until activate-modelbank.
    modelbank_quiesce update
    # Quiescence acquires the production lock at the end of the full
    # path (after the drain); a skipped quiescence must not skip the
    # lock — the child envelope carries both slots and the mutation
    # stays serialized against concurrent deploys.
    ensure_checkout_lock production
    ensure_checkout "$STAGING_CHECKOUT" "$DATA_UI_PUBLIC_URL" "$DATA_UI_PRIVATE_URL"
    require_checkout_clean "$STAGING_CHECKOUT"
    checkout_fetch_source "$STAGING_CHECKOUT" "$remote" "$branch"
    # target-staging-sha: only after a successful fetch, before the
    # working tree moves. phase is already quiesced and
    # activated-staging-sha already cleared (quiesce, update mode).
    if [[ -f "$(modelbank_activation_state_path)" ]]; then
        read_modelbank_activation_state
        write_modelbank_activation_state \
            "$MB_STATE_original_exposed" quiesced "$SELECTED_FULL_SHA" -
    fi
    checkout_move_to_source "$STAGING_CHECKOUT" "$remote" "$branch" "$SELECTED_FULL_SHA"
    print_checkout_identity staging "$STAGING_CHECKOUT" "$remote" "$branch" "$SELECTED_LOCAL_BRANCH" "$SELECTED_FULL_SHA"
    local marker
    marker=$(checkout_envelope_marker)
    "${STAGING_CHECKOUT}/scripts/data-ui" \
        "$marker" staging "$remote" "$branch" "$SELECTED_FULL_SHA" \
        "$(checkout_lock_fd staging)" "$(checkout_lock_fd production)" \
        none - - staging-update-child || status=$?
    if (( status != 0 )); then
        echo "staging update child failed (status ${status}); restoring the timer and exiting with that status." >&2
    fi
    exit "$status"
}

function staging_install_ops {
    # Validate the full source set, then install exactly:
    #   ops/pg-profile.yaml        -> OPS_LIB_DIR/pg-profile.yaml            (0644, reference copy)
    #   ops/profile-run.sh         -> OPS_LIB_DIR/profile-run.sh             (0755)
    #   ops/petting-zoo-reset.sh   -> OPS_LIB_DIR/petting-zoo-reset.sh       (0755)
    #   ops/dataui@.service        -> SYSTEMD_UNIT_DIR/dataui@.service       (0644)
    #   ops/dataui-reset.service   -> SYSTEMD_UNIT_DIR/dataui-reset.service  (0644)
    #   ops/dataui-reset.timer     -> SYSTEMD_UNIT_DIR/dataui-reset.timer    (0644)
    # Each file via sudo with an atomic same-directory temp; everything
    # before a checked daemon-reload. On failure, stop before restarts
    # and report which destinations changed; recovery is rerunning the
    # updater. Never touch demo-directory. OPS_LIB_DIR/SYSTEMD_UNIT_DIR
    # defaults are the production paths; the test harness overrides.
    local lib_dir="${OPS_LIB_DIR:-/usr/local/lib/data-ui}"
    local unit_dir="${SYSTEMD_UNIT_DIR:-/etc/systemd/system}"
    local -a pairs=(
        "ops/pg-profile.yaml|${lib_dir}/pg-profile.yaml|644"
        "ops/profile-run.sh|${lib_dir}/profile-run.sh|755"
        "ops/petting-zoo-reset.sh|${lib_dir}/petting-zoo-reset.sh|755"
        "ops/dataui@.service|${unit_dir}/dataui@.service|644"
        "ops/dataui-reset.service|${unit_dir}/dataui-reset.service|644"
        "ops/dataui-reset.timer|${unit_dir}/dataui-reset.timer|644"
    )
    local p src dst mode tmp
    local -a done_list=()
    for p in "${pairs[@]}"; do
        IFS='|' read -r src dst mode <<<"$p"
        [[ -f "$src" ]] || die "ops install: missing source '${src}' in the staging checkout."
    done
    sudo mkdir -p "$lib_dir" "$unit_dir" \
        || die "ops install: cannot create ${lib_dir} / ${unit_dir}."
    for p in "${pairs[@]}"; do
        IFS='|' read -r src dst mode <<<"$p"
        tmp="${dst}.data-ui-tmp.$$"
        if ! sudo install -m "$mode" "$src" "$tmp" || ! sudo mv -f "$tmp" "$dst"; then
            sudo rm -f "$tmp"
            echo "ERROR: ops install of ${src} -> ${dst} failed." >&2
            echo "  Destinations already changed: ${done_list[*]:-(none)}" >&2
            die "Stopping before restarts; recovery is rerunning 'scripts/data-ui staging update'."
        fi
        done_list+=("$dst")
        echo "Installed ${src} -> ${dst} (mode ${mode})."
    done
    sudo systemctl daemon-reload || die "systemctl daemon-reload failed; stopping before restarts."
    echo "ops files installed; daemon reloaded."
}

function staging_restart_profiles {
    # Enumerate active non-Model-Bank dataui@PROFILE units; abort if
    # any is activating or reloading. Restart each with plain
    # `sudo systemctl restart` (never enable --now, never lifecycle
    # stop/start, never reset/delete verbs). Disabled and stopped
    # profiles stay as they are. Gate each restart before the next: the
    # first profile is the canary and there is no second pass.
    local -a units=()
    local line unit state name
    while read -r line; do
        [[ "$line" == dataui@*.service* ]] || continue
        unit=$(awk '{print $1}' <<<"$line")
        state=$(awk '{print $3}' <<<"$line")
        name="${unit#dataui@}"
        name="${name%.service}"
        [[ "$name" == "modelbank" ]] && continue
        case "$state" in
            active) units+=("$name") ;;
            activating|reloading)
                die "dataui@${name} is ${state}; aborting the update before any restart."
                ;;
            *) ;; # inactive/failed: leave as-is
        esac
    done < <(systemctl list-units --all --no-legend --plain --type=service 'dataui@*.service' 2>/dev/null)
    if (( ${#units[@]} == 0 )); then
        echo "No active non-Model-Bank dataui@ units; nothing to restart."
        return 0
    fi
    echo "Active profiles to restart (gated, one at a time): ${units[*]}"
    local -a restarted=()
    for name in "${units[@]}"; do
        staging_gate_profile_restart "$name"
        restarted+=("$name")
    done
    echo "Restarted (all gates passed): ${restarted[*]}"
}

function staging_gate_profile_restart {
    # Plain restart, then gate BEFORE the next: journal identity (only
    # lines --after-cursor the captured cursor that belong to the new
    # InvocationID — a cursor alone admits late lines from the old
    # process), loopback /health 200, and — if exposed — the routed
    # domain /health 200. Poll 5s with 5s timeouts until
    # STAGING_HEALTH_TIMEOUT (default 300s; 120 was tuned to warm
    # starts and the pre-warm keeps the deadline measuring health, not
    # compilation). An InvocationID change during the poll fails the
    # gate (a crash-restart is not healthy). /health is a real
    # activation gate by ordering: start-web-server has one caller, the
    # last form of set-model, so a process that dies inside set-model
    # never binds the port. Never substitute the "web server started"
    # log line (it is emitted BEFORE h:start).
    local profile="$1" unit="dataui@${1}"
    local env_path http_port cursor inv lines inv2 checkout domain code
    env_path=$(profile_env_path "$profile")
    http_port=$(grep -oP '^HTTP_PORT=\K\d+' "$env_path" 2>/dev/null)
    [[ -n "$http_port" ]] || die "profile '${profile}' has no HTTP_PORT."
    checkout=$(readlink -m "$STAGING_CHECKOUT")
    cursor=$(journalctl -u "$unit" -n 0 --show-cursor 2>/dev/null | sed -n 's/^-- cursor: //p')
    [[ -n "$cursor" ]] || die "cannot capture a journal cursor for ${unit}."
    sudo systemctl restart "$unit" || die "systemctl restart ${unit} failed."
    inv=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null)
    [[ -n "$inv" ]] || die "cannot read the InvocationID of ${unit} after restart."
    echo "Restarted ${unit} (invocation ${inv:0:8}); gating (deadline ${STAGING_HEALTH_TIMEOUT:-300}s)."
    local deadline="${STAGING_HEALTH_TIMEOUT:-300}" waited=0
    local journal_ok=0 health_ok=0 exposed_ok=0 exposed=0
    haproxy_env
    if profile_is_exposed "$profile"; then
        exposed=1
        domain=$(profile_routed_domain "$profile")
        [[ -n "$domain" ]] || die "${profile} is exposed but has no routed domain in the map."
    fi
    while :; do
        lines=$(journalctl -u "$unit" --after-cursor "$cursor" 2>/dev/null)
        if [[ -n "$lines" ]] && (( journal_ok == 0 )); then
            if grep -qF "profile-run: checkout: ${checkout}" <<<"$lines" \
               && grep -qF "DATA-UI-ASDF-SOURCE=${checkout}/" <<<"$lines"; then
                journal_ok=1
            fi
        fi
        if (( journal_ok == 1 && health_ok == 0 )); then
            code=$(curl -s -o /dev/null -w '%{http_code}' -m 5 \
                       "http://127.0.0.1:${http_port}/health" 2>/dev/null) || code=000
            [[ "$code" == "200" ]] && health_ok=1
        fi
        if (( journal_ok == 1 && health_ok == 1 && exposed == 1 && exposed_ok == 0 )); then
            code=$(curl -s -o /dev/null -w '%{http_code}' -m 5 \
                       "https://${domain}/health" 2>/dev/null) || code=000
            [[ "$code" == "200" ]] && exposed_ok=1
        fi
        # Checked after the polls and BEFORE declaring success: the
        # invocation must still be the one the restart produced. A
        # fast crash-restart can re-serve a satisfying /health within
        # the same iteration, and the plan's rule is unqualified — an
        # InvocationID change during the poll fails the gate.
        inv2=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null)
        [[ "$inv2" == "$inv" ]] \
            || die "InvocationID of ${unit} changed during the health poll (a crash-restart is not healthy)."
        if (( journal_ok == 1 && health_ok == 1 && ( exposed == 0 || exposed_ok == 1 ) )); then
            if (( exposed == 1 )); then
                echo "  ${unit}: journal identity + loopback /health + https://${domain}/health OK."
            else
                echo "  ${unit}: journal identity + loopback /health OK (not exposed)."
            fi
            return 0
        fi
        if (( waited >= deadline )); then
            echo "ERROR: ${unit} did not pass its health gate within ${deadline}s (journal=${journal_ok} loopback=${health_ok} exposed=${exposed_ok})." >&2
            echo "  Inspect: journalctl -u ${unit} --after-cursor '${cursor}'" >&2
            die "Stopping at the first failure; no further profiles are restarted (no second pass)."
        fi
        sleep 5
        waited=$(( waited + 5 ))
    done
}

function staging_update_child {
    # The selected staging script's body, under a verified envelope
    # holding BOTH locks. Build, pre-warm, ops installation, and
    # per-profile gated restarts happen here; Model Bank waits for
    # activate-modelbank; the supervisor restores the timer when this
    # child exits (the child never issues a timer command).
    local remote="$ENVELOPE_REMOTE" branch="$ENVELOPE_BRANCH" sha="$ENVELOPE_FULL_SHA"
    cd "$STAGING_CHECKOUT" || die "cannot cd to ${STAGING_CHECKOUT}."
    echo "staging update child: ${remote}/${branch} @ ${sha}"
    # Frontend: npm ci (requires the committed web/package-lock.json;
    # never falling back to npm install) then npm run build. Outputs
    # are never promoted between checkouts; web/dist and node_modules
    # are ignored so they cannot dirty the tree.
    [[ -f web/package-lock.json ]] \
        || die "web/package-lock.json is missing at ${sha}; npm ci requires it and there is no npm-install fallback."
    ( cd web && npm ci && npm run build ) \
        || die "frontend build failed; stopping before ops installation or restarts."
    # Pre-warm: a fresh SBCL applies the ASDF load contract, loads
    # :data-ui, and exits — a compile gate (a broken revision fails
    # before any ops file is installed or any unit restarted) that also
    # fills the FASL cache every dataui@ restart shares
    # (~/.cache/common-lisp, keyed by checkout path). Run WITHOUT sudo
    # and as the invoking user (the unit's user): a root-owned cache
    # would make the health deadline measure compilation again.
    local warm_start=$SECONDS
    build_load_contract_evals
    DATA_UI_EXPECTED_CHECKOUT="$LOAD_CONTRACT_CHECKOUT" \
        ros run -- --disable-debugger \
            "${LOAD_CONTRACT_EVALS[@]}" \
            --eval '(format t "pre-warm: :data-ui loaded~%")' \
            --quit \
        || die "pre-warm load failed; stopping before ops installation or restarts."
    echo "Pre-warm complete in $(( SECONDS - warm_start ))s."
    staging_install_ops
    staging_restart_profiles
    echo
    echo "Staging update complete."
    echo "  staging SHA:      ${sha}"
    echo "  Model Bank:       pending activation ('scripts/data-ui staging activate-modelbank')"
}

#
# staging activate-modelbank
#

function swank_eval_string {
    # Minimal swank client (the CLASSIC SLIME wire protocol from
    # swank/rpc.lisp: 6-hex-digit length-prefixed s-expressions, and
    # the request shape (:emacs-rex (swank:interactive-eval "string"
    # lines width) "PACKAGE" thread id)). Evaluates EXPR on the unit's
    # Swank passenger at 127.0.0.1:$1 and prints the value. The value
    # travels inside [[...]] sentinels so the echo-area decoration
    # interactive-eval adds (prefix, CL string quoting) cannot corrupt
    # it. Used only as a verification channel (the running image's own
    # *package-root* and deploy script path) — never a control path.
    python3 - "$1" "$2" <<'PYEOF'
import re, socket, sys, time
port, expr = int(sys.argv[1]), sys.argv[2]
def cl_str(x):
    return b'"' + x.replace(b"\\", b"\\\\").replace(b'"', b'\\"') + b'"'
def frame(p):
    return b"%06x" % len(p) + p
def read_message(f):
    hdr = b""
    while len(hdr) < 6:
        c = f.read(6 - len(hdr))
        if not c: raise EOFError("connection closed")
        hdr += c
    n = int(hdr, 16)
    data = f.read(n)
    if len(data) < n: raise EOFError("short read")
    return data
inner = '(format nil "[[~a]]" %s)' % expr
req = (b'(:emacs-rex (swank:interactive-eval ' + cl_str(inner.encode())
       + b' 1 100) "COMMON-LISP-USER" t 1)')
s = socket.create_connection(("127.0.0.1", port), timeout=10)
ret = b""
try:
    f = s.makefile("rb")
    s.sendall(frame(req))
    end = time.time() + 10
    while time.time() < end:
        try:
            m = read_message(f)
        except Exception:
            break
        if m.startswith(b"(:return"):
            ret = m
            break
finally:
    s.close()
m = ret.decode("utf-8", "replace")
if ":ok" not in m:
    sys.stderr.write("swank eval failed: %r\n" % m[:200]); sys.exit(1)
hit = re.search(r"\[\[(.*)\]\]", m, re.S)
if not hit:
    sys.stderr.write("swank eval returned no [[value]]: %r\n" % m[:200]); sys.exit(1)
sys.stdout.write(hit.group(1))
PYEOF
}

function verify_modelbank_identity {
    # Loopback /health, then — through the unit's Swank passenger — the
    # running image's *package-root* and the deploy script path it
    # would hand a Deploy worker. The journal proves what the process
    # printed at startup; this proves what the live image believes.
    local env_path http_port swank_port root want out code
    env_path=$(profile_env_path modelbank)
    http_port=$(grep -oP '^HTTP_PORT=\K\d+' "$env_path" 2>/dev/null)
    swank_port=$(grep -oP '^SWANK_PORT=\K\d+' "$env_path" 2>/dev/null)
    [[ -n "$http_port" && -n "$swank_port" ]] \
        || die "modelbank profile lacks HTTP_PORT/SWANK_PORT."
    code=$(curl -s -o /dev/null -w '%{http_code}' -m 5 \
               "http://127.0.0.1:${http_port}/health" 2>/dev/null) || code=000
    [[ "$code" == "200" ]] \
        || { echo "ERROR: modelbank /health returned ${code:-none} on 127.0.0.1:${http_port}." >&2; return 1; }
    want="$(readlink -m "$STAGING_CHECKOUT")/"
    root=$(swank_eval_string "$swank_port" \
               '(namestring (truename data-ui::*package-root*))') \
        || return 1
    [[ "$root" == "$want" ]] \
        || { echo "ERROR: modelbank's *package-root* is ${root}, wanted ${want}." >&2; return 1; }
    out=$(swank_eval_string "$swank_port" \
              '(namestring (probe-file (merge-pathnames "scripts/data-ui" data-ui::*package-root*)))') \
        || return 1
    [[ "$out" == "${want}scripts/data-ui" ]] \
        || { echo "ERROR: modelbank's deploy script path is ${out}, wanted ${want}scripts/data-ui." >&2; return 1; }
    echo "modelbank identity verified (loopback /health 200; Swank *package-root* and deploy script under ${want})."
    return 0
}

function staging_check_protocol_readiness {
    # Early warning before --expose: the next Deploy selects
    # public/master, so the DATA_UI_REEXEC_PROTOCOL line in
    # refs/remotes/public/master:scripts/lib/checkout.sh must equal
    # staging's. Refs-only fetch under the production lock already
    # held; NEVER the working tree (production HEAD is the wrong
    # commit). File-content identity would be too strict; this never
    # waits on a production application's health. The inner arm's
    # version check is the real guard.
    [[ -d "${DEPLOY_CHECKOUT}/.git" ]] \
        || { echo "ERROR: no production checkout at ${DEPLOY_CHECKOUT}; cannot check protocol readiness." >&2; return 1; }
    checkout_git "$DEPLOY_CHECKOUT" fetch --no-tags public +refs/heads/master:refs/remotes/public/master >/dev/null 2>&1 \
        || { echo "ERROR: refs-only fetch of public/master into ${DEPLOY_CHECKOUT} failed." >&2; return 1; }
    local line
    line=$(checkout_git "$DEPLOY_CHECKOUT" show refs/remotes/public/master:scripts/lib/checkout.sh 2>/dev/null \
               | sed -n 's/^DATA_UI_REEXEC_PROTOCOL=//p' | tail -1)
    [[ "$line" == "$DATA_UI_REEXEC_PROTOCOL" ]] \
        || { echo "ERROR: protocol mismatch: public/master's scripts/lib/checkout.sh speaks V${line:-none}, staging speaks V${DATA_UI_REEXEC_PROTOCOL}. Publish to public, or use --leave-unexposed." >&2; return 1; }
    echo "Protocol readiness OK (public/master speaks V${DATA_UI_REEXEC_PROTOCOL})."
    return 0
}

function staging_activate_modelbank {
    # [--leave-unexposed|--expose] (default --leave-unexposed; options
    # mutually exclusive; extra operands fail). Routed to staging
    # without selection; takes its own locks (staging first, then
    # production via the quiescence helper) and holds both through
    # restart, verification, and any exposure. Activation is a plain
    # restart — never enable/disable, never the lifecycle verbs.
    local mode="leave-unexposed"
    if (( $# > 1 )); then
        die "staging activate-modelbank takes at most one option (--leave-unexposed | --expose)."
    fi
    if [[ "${1:-}" == "--expose" ]]; then
        mode="expose"
    elif [[ -n "${1:-}" && "${1:-}" != "--leave-unexposed" ]]; then
        die "Unknown option '${1}' (only --leave-unexposed | --expose, mutually exclusive)."
    fi
    staging_one_host_check
    [[ "$(hostname)" == "$STAGING_HOST" ]] \
        || die "staging activate-modelbank must run on ${STAGING_HOST} (this is $(hostname))."
    cd "$STAGING_CHECKOUT" 2>/dev/null \
        || die "no staging checkout at ${STAGING_CHECKOUT}; run 'scripts/data-ui staging update' first."
    local env_file
    env_file=$(profile_env_path modelbank)
    [[ -f "$env_file" ]] || die "No modelbank profile (${env_file})."
    # An e-demo-stamped Model Bank would be restarted by the nightly
    # reset outside quiescence; refuse it (normal Model Bank is demo
    # class and never in the nightly set).
    local class
    class=$(grep -oP '^DEMO_CLASS=\K.*' "$env_file" | tail -1)
    [[ "$class" != "e-demo" ]] \
        || die "modelbank is DEMO_CLASS=e-demo (nightly reset set); activate-modelbank refuses — the reset would restart it outside quiescence."
    # Original exposure, read before anything can change it.
    local original
    if read_modelbank_activation_state; then
        original="$MB_STATE_original_exposed"
    else
        haproxy_env
        if profile_is_exposed modelbank; then original=1; else original=0; fi
    fi
    MB_ORIGINAL_EXPOSED="$original"
    MB_PHASE="pre-restart"
    trap 'staging_activate_abort' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    with_checkout_lock staging
    modelbank_quiesce activate
    local head
    head=$(checkout_git "$STAGING_CHECKOUT" rev-parse HEAD) \
        || die "cannot read the staging HEAD."
    local already=0
    if read_modelbank_activation_state \
       && [[ "$MB_STATE_phase" == "activated" && "$MB_STATE_activated" == "$head" ]]; then
        already=1
    fi
    if (( already )); then
        # --expose fast path: never restart a healthy current Model
        # Bank just to change exposure. Revalidate invocation, journal
        # identity, loopback health, and Swank identity.
        echo "modelbank is already activated at ${head}; using the --expose fast path (no restart)."
        if ! verify_modelbank_identity; then
            die "modelbank failed revalidation on the fast path; run 'scripts/data-ui staging activate-modelbank' (without --expose) to restart it."
        fi
    else
        local unit="dataui@modelbank" cursor inv
        cursor=$(journalctl -u "$unit" -n 0 --show-cursor 2>/dev/null | sed -n 's/^-- cursor: //p')
        [[ -n "$cursor" ]] || die "cannot capture a journal cursor for ${unit}."
        echo "Activating modelbank: plain restart of ${unit}."
        sudo systemctl restart "$unit" || { MB_PHASE="post-restart"; die "systemctl restart ${unit} failed."; }
        MB_PHASE="post-restart"
        inv=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null)
        [[ -n "$inv" ]] || die "cannot read the InvocationID of ${unit} after restart."
        # Gate: journal identity (only this invocation's lines), loopback
        # /health, then Swank identity — the deadline and rules match
        # staging_gate_profile_restart.
        local deadline="${STAGING_HEALTH_TIMEOUT:-300}" waited=0 checkout lines ok=0
        checkout=$(readlink -m "$STAGING_CHECKOUT")
        while :; do
            lines=$(journalctl -u "$unit" --after-cursor "$cursor" 2>/dev/null)
            if [[ -n "$lines" ]] \
               && grep -qF "profile-run: checkout: ${checkout}" <<<"$lines" \
               && grep -qF "DATA-UI-ASDF-SOURCE=${checkout}/" <<<"$lines" \
               && verify_modelbank_identity >/dev/null 2>&1; then
                ok=1
                break
            fi
            local inv2
            inv2=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null)
            [[ "$inv2" == "$inv" ]] \
                || { echo "ERROR: InvocationID of ${unit} changed during activation (a crash-restart is not healthy)." >&2; break; }
            if (( waited >= deadline )); then
                echo "ERROR: modelbank did not verify within ${deadline}s." >&2
                break
            fi
            sleep 5
            waited=$(( waited + 5 ))
        done
        if (( ok == 0 )); then
            echo "Post-restart verification failed; failing closed (no exposure). Recovery:" >&2
            echo "  journalctl -u ${unit} --after-cursor '${cursor}'" >&2
            echo "  retry: scripts/data-ui staging activate-modelbank" >&2
            die "modelbank activation failed verification."
        fi
        verify_modelbank_identity
        # Success: phase=activated at the current staging HEAD, keeping
        # original-exposed (and target-staging-sha as recorded).
        read_modelbank_activation_state 2>/dev/null || true
        write_modelbank_activation_state \
            "$original" activated "${MB_STATE_target:--}" "$head"
        echo "modelbank activated at ${head} (phase=activated)."
    fi
    trap - EXIT INT TERM
    if [[ "$mode" == "expose" ]]; then
        if [[ "$original" == "1" ]]; then
            if ! staging_check_protocol_readiness; then
                echo "modelbank stays unexposed (phase=activated); publish to public, then re-run with --expose." >&2
                die "protocol readiness failed; refusing to expose modelbank."
            fi
            haproxy_env
            require_haproxy_host "staging activate-modelbank --expose"
            expose_profile modelbank
            local domain
            domain=$(profile_routed_domain modelbank)
            [[ -n "$domain" ]] || die "modelbank has no routed domain after expose."
            if ! wait_for_health_200 "https://${domain}/health" \
                    "modelbank public health" "${STAGING_HEALTH_TIMEOUT:-300}"; then
                die "modelbank exposed at https://${domain} but its public /health gate failed; investigate before relying on it."
            fi
            echo "Exposed modelbank: https://${domain} (public /health 200)."
        else
            haproxy_env
            if profile_is_exposed modelbank; then
                die "modelbank was originally unexposed but is exposed now; refusing to normalize that by policy."
            fi
            echo "modelbank was originally unexposed; a successful no-expose outcome."
        fi
    fi
    # Outcomes: after a verified final exposure, or a verified
    # activation of an originally-unexposed instance, remove
    # activation.state. An originally-exposed instance deliberately
    # left unexposed keeps phase=activated until a later --expose
    # succeeds.
    if [[ "$mode" == "expose" || "$original" == "0" ]]; then
        rm -f "$(modelbank_activation_state_path)" \
            && echo "Activation complete; removed $(modelbank_activation_state_path)."
    else
        echo "modelbank activated and left unexposed (phase stays 'activated' until a later --expose succeeds)."
    fi
}

function staging_activate_abort {
    # A pre-restart failure restores only the recorded original
    # exposure, and only where that is safe (nothing restarted, nothing
    # activated). Post-restart failures fail closed with explicit
    # recovery commands instead (printed by the caller).
    local status=$?
    trap - EXIT
    if [[ "${MB_PHASE:-}" == "pre-restart" && "${MB_ORIGINAL_EXPOSED:-}" == "1" ]]; then
        echo "Activation aborted before restart; restoring the originally-exposed state..." >&2
        if expose_profile modelbank; then
            echo "Re-exposed modelbank (original exposure restored)." >&2
        else
            echo "WARNING: could not re-expose modelbank; run 'scripts/data-ui profile expose modelbank'." >&2
        fi
    fi
    exit "$status"
}

#
# Orphan scanner (read-only; mirrors the Lisp reaper's strictness)
#

function parse_registry_record {
    # Strict parse of a <token>.registry record — the contract shared
    # with the Lisp reaper: key=value lines, no quoting, no comments,
    # no blank lines, every key present, in this order:
    #   state token worker-pid child-pid path
    # Prints "state worker-pid child-pid path" on success. Returns 1
    # (with a reason on stderr) on any deviation: unknown, missing, or
    # duplicate keys; a bad state; a non-numeric worker-pid;
    # child-pid='-' outside pending; a numeric child-pid in pending; a
    # token/path mismatch. Unrecognizable records are retained and
    # reported, never reaped.
    local rec="$1" line key val n=0
    local state token worker child path
    while IFS= read -r line; do
        n=$(( n + 1 ))
        [[ "$line" == *=* ]] || { echo "line ${n} has no '='" >&2; return 1; }
        key="${line%%=*}"
        val="${line#*=}"
        case "$n:$key" in
            1:state) state="$val" ;;
            2:token) token="$val" ;;
            3:worker-pid) worker="$val" ;;
            4:child-pid) child="$val" ;;
            5:path) path="$val" ;;
            *) echo "unexpected key '${key}' at line ${n}" >&2; return 1 ;;
        esac
    done < "$rec"
    (( n == 5 )) || { echo "expected 5 lines, got ${n}" >&2; return 1; }
    [[ "$state" == pending || "$state" == ready || "$state" == done ]] \
        || { echo "bad state '${state}'" >&2; return 1; }
    [[ "$token" =~ ^[A-Za-z0-9_-]+$ && "$token" == "$(basename "$rec" .registry)" ]] \
        || { echo "bad token '${token}'" >&2; return 1; }
    [[ "$worker" =~ ^[0-9]+$ ]] || { echo "bad worker-pid '${worker}'" >&2; return 1; }
    if [[ "$state" == "pending" ]]; then
        [[ "$child" == "-" ]] || { echo "numeric child-pid '${child}' in pending" >&2; return 1; }
    else
        [[ "$child" =~ ^[0-9]+$ ]] || { echo "child-pid '${child}' must be numeric outside pending" >&2; return 1; }
    fi
    [[ "$path" == "models/local/deploy-incoming/${token}.lisp" ]] \
        || { echo "path '${path}' does not match the token" >&2; return 1; }
    printf '%s %s %s %s\n' "$state" "$worker" "$child" "$path"
}

function pid_alive {
    # /proc/<pid> existence in any state (zombie included) means live.
    # The reaping process did not spawn the child, so process-status
    # cannot answer; every ambiguity (including PID reuse) errs toward
    # "live", which retains and reports — the required direction.
    [[ "$1" =~ ^[0-9]+$ ]] && [[ -e "/proc/$1" ]]
}

function staging_modelbank_orphans {
    # Read-only report of deploy-incoming orphans: one line per entry
    # with path, state, and reason — missing incoming file, dead child
    # without an ack, malformed or unrecognizable record, or stale
    # temp. Exit 0 if none, nonzero otherwise. Never mutates anything,
    # never restarts Model Bank, never takes a lock.
    cd "$STAGING_CHECKOUT" 2>/dev/null \
        || die "no staging checkout at ${STAGING_CHECKOUT}; run 'scripts/data-ui staging update' first."
    local dir="$STAGING_CHECKOUT/models/local/deploy-incoming"
    local found=0 rec token out state worker child path incoming f
    if [[ ! -d "$dir" ]]; then
        echo "No deploy-incoming directory (${dir}); no orphans."
        exit 0
    fi
    for rec in "$dir"/*.registry; do
        [[ -f "$rec" ]] || continue
        token=$(basename "$rec" .registry)
        incoming="${dir}/${token}.lisp"
        if ! out=$(parse_registry_record "$rec" 2>&1); then
            echo "orphan: ${rec}: malformed/unrecognizable record (${out})"
            found=1
            continue
        fi
        read -r state worker child path <<<"$out"
        if [[ ! -f "$incoming" ]]; then
            echo "orphan: ${rec}: missing incoming file (state=${state})"
            found=1
            continue
        fi
        case "$state" in
            done)
                echo "orphan: ${incoming}: state=done but the file remains (worker died before cleanup)"
                found=1
                ;;
            pending)
                if ! pid_alive "$worker"; then
                    echo "orphan: ${incoming}: state=pending, worker-pid ${worker} dead"
                    found=1
                fi
                ;;
            ready)
                if ! pid_alive "$child"; then
                    echo "orphan: ${incoming}: state=ready, child-pid ${child} dead without an ack"
                    found=1
                fi
                ;;
        esac
    done
    for f in "$dir"/*.lisp; do
        [[ -f "$f" ]] || continue
        token=$(basename "$f" .lisp)
        [[ -f "$dir/${token}.registry" ]] \
            || { echo "orphan: ${f}: no registry record (worker died between file creation and the record write)"; found=1; }
    done
    for f in "$dir"/.*.tmp; do
        [[ -f "$f" ]] || continue
        echo "orphan: ${f}: stale temp"
        found=1
    done
    if (( found == 0 )); then
        echo "No orphans in ${dir}."
        exit 0
    fi
    exit 1
}

#
# Routing without fetching: routine staging commands run the staging
# checkout's script from any non-staging cwd. Routing compares
# canonical script roots, never cwd. Unnamed development invocations
# stay local. tests/debug/compile/docs/field never route; dev: and
# prd: snapshot addresses stay on the invoking script; only stg:
# addresses route.
#

function route_for_staging {
    local root staging_root action="${1:-}"
    root=$(canonical_checkout_root)
    staging_root=$(readlink -m "$STAGING_CHECKOUT")
    [[ "$root" == "$staging_root" ]] && return 1
    case "$action" in
        profile)
            # install-model never routes (its source lives in the
            # invoking checkout); the rest of the profile verbs do.
            [[ "${2:-}" != "install-model" ]] || return 1
            ;;
        e-demo|demo)
            ;;
        repl|db|psql)
            [[ -n "${2:-}" ]] || return 1
            ;;
        staging)
            case "${2:-}" in
                activate-modelbank|modelbank-orphans|modelbank-running) ;;
                *) return 1 ;;
            esac
            ;;
        snapshot)
            case "${2:-}" in
                save|restore)
                    [[ "${4:-}" == stg:* ]] || return 1
                    ;;
                *) return 1 ;;
            esac
            ;;
        *)
            return 1
            ;;
    esac
    [[ -x "${staging_root}/scripts/data-ui" ]] \
        || die "No staging checkout at ${staging_root}; run 'scripts/data-ui staging update' first."
    echo "Routing to the staging checkout (${staging_root})."
    exec "${staging_root}/scripts/data-ui" "$@"
}

#
# Internal envelope dispatch (the re-exec entry point)
#

function run_envelope_action {
    # The inner arm. Order: parse (done by the caller), overwrite
    # ambient MODEL_FILE from the validated handoff or unset it (no
    # environment-variable bypass), install cleanup traps for every
    # inherited temporary artifact, THEN verify the fallible guards
    # (root, host, SHA, lock ownership), then run the action body.
    case "$ENVELOPE_ACTION" in
        deploy)
            [[ "$ENVELOPE_ROLE" == "production" ]] \
                || die "internal envelope: deploy must be ROLE=production."
            if [[ "$ENVELOPE_HANDOFF_KIND" != "none" ]]; then
                export MODEL_FILE="${DEPLOY_CHECKOUT}/${ENVELOPE_HANDOFF_PATH}"
                DEPLOY_CANDIDATE="$ENVELOPE_HANDOFF_PATH"
                DEPLOY_CANDIDATE_ABS="${DEPLOY_CHECKOUT}/${ENVELOPE_HANDOFF_PATH}"
                DEPLOY_CANDIDATE_TOKEN="$(basename "$ENVELOPE_HANDOFF_PATH" .lisp)"
            else
                unset MODEL_FILE
            fi
            trap 'deploy_inner_exit_trap' EXIT
            trap 'exit 130' INT
            trap 'exit 143' TERM
            verify_internal_envelope
            deploy_selected
            ;;
        delete)
            [[ "$ENVELOPE_ROLE" == "production" ]] \
                || die "internal envelope: delete must be ROLE=production."
            if [[ "$ENVELOPE_HANDOFF_KIND" != "none" ]]; then
                export MODEL_FILE="${DEPLOY_CHECKOUT}/${ENVELOPE_HANDOFF_PATH}"
                DEPLOY_CANDIDATE="$ENVELOPE_HANDOFF_PATH"
                DEPLOY_CANDIDATE_ABS="${DEPLOY_CHECKOUT}/${ENVELOPE_HANDOFF_PATH}"
                DEPLOY_CANDIDATE_TOKEN="$(basename "$ENVELOPE_HANDOFF_PATH" .lisp)"
            else
                unset MODEL_FILE
            fi
            verify_internal_envelope
            delete_selected
            ;;
        staging-update-child)
            [[ "$ENVELOPE_ROLE" == "staging" ]] \
                || die "internal envelope: staging-update-child must be ROLE=staging."
            verify_internal_envelope
            staging_update_child
            ;;
        *)
            die "internal envelope: unhandled ACTION '${ENVELOPE_ACTION}'."
            ;;
    esac
}

# Internal envelope dispatch: the re-exec entry point. A marker-shaped
# first argument never reaches the public grammar below — a protocol
# mismatch dies with its own message, and a matching marker with any
# bad guard dies inside parse/verify (never a fallback to public
# dispatch; a user-supplied marker cannot forge the inherited, held
# lock descriptors).
if envelope_marker_shaped "${1:-}"; then
    if ! internal_envelope_present "$@"; then
        die "Re-exec envelope protocol mismatch: got '${1}', this script speaks $(checkout_envelope_marker)."
    fi
    parse_internal_envelope "$@"
    run_envelope_action
    exit $?
fi

# Routing without fetching (see route_for_staging): execs into the
# staging checkout's script for the routine staging verbs, or returns
# to local dispatch. Unnamed development invocations stay local.
route_for_staging "$@"

case "$ACTION" in
    repl)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        setup_repl_env "$2"
        start_postgres_quietly
        initialize_database_quietly
        start_repl
        stop_database_quietly
        ;;
    db)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        setup_repl_env "$2"
        start_postgres
        initialize_database
        start_psql
        stop_database_quietly
        ;;
    psql)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        if [[ -n "${2:-}" ]]; then
            load_profile "$2"
        else
            export_repl_environment
            render_init_sql
        fi
        start_psql
        ;;
    e-demo)
        demo_verb e-demo "${@:2}"
        ;;
    demo)
        demo_verb demo "${@:2}"
        ;;
    profile)
        # Routed to staging when invoked elsewhere; either way the arm
        # runs from the invoking script's canonical root so every
        # checkout-relative path (models/, ops/) resolves there.
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        sub="${2:-}"
        case "$sub" in
            create)
                create_profile "$3" "$4"
                ;;
            delete)
                delete_profile "$3"
                ;;
            list)
                show_profiles
                ;;
            expose)
                expose_profile "$3"
                ;;
            unexpose)
                unexpose_profile "$3"
                ;;
            install-model)
                install_profile_model "$3"
                ;;
            *)
                echo "Usage: $SCRIPT_NAME profile {create|delete|list|expose|unexpose|install-model} ..."
                echo
                echo "Manage host profiles (locally-run instances)."
                echo "  create <model> [profile] Create a host profile"
                echo "  delete <profile>         Delete a host profile"
                echo "  list                     List host profiles and status"
                echo "  expose <profile>         Route the domain via HAProxy"
                echo "  unexpose <profile>       Remove the HAProxy exposure"
                echo "  install-model <model>    Deliver a local model to staging"
                exit 1
                ;;
        esac
        ;;
    tests)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        export_test_environment
        render_init_sql
        start_postgres_quietly
        initialize_database_quietly
        run_tests
        stop_database_quietly
        echo $REPORT
        [[ "$REPORT" == "PASS" ]] || exit 1
        ;;
    debug)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        export_test_environment
        render_init_sql
        start_postgres
        initialize_database
        run_tests
        stop_database
        echo $REPORT
        ;;
    compile)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        export_docs_environment
        compile
        ;;
    docs)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        export_docs_environment
        generate_readme
        ;;
    stop)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        export_test_environment
        stop_database
        ;;
    field)
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        # export: the eval form reads these through uiop:getenv, and the
        # old plain assignments never crossed to ros — every internal
        # caller (model_field) prefixes them per call, so only the bare
        # verb was affected (it printed NIL for every field; pre-existing,
        # surfaced by this item's verification).
        export MODEL_NAME="$2"
        export DATA_UI_FIELD_NAME="$3"
        if [[ -z "$MODEL_NAME" ]]; then
            echo "Model name required."
            exit 1
        fi
        if [[ -z "$DATA_UI_FIELD_NAME" ]]; then
            echo "Field name required."
            exit 1
        fi
        # Resolver swap: a local-only model previously died inside
        # ros (the deployment reader's error) because nothing checked
        # the path; the gate lives here now. field never routes, so
        # the invoking checkout is the only tree searched.
        resolved_model=$(resolve_model_file "$MODEL_NAME")
        if [[ -z "$resolved_model" ]]; then
            echo "No model '${MODEL_NAME}' (looked for models/${MODEL_NAME}.lisp, models/local/${MODEL_NAME}.lisp)." >&2
            exit 1
        fi
        DATA_UI_MODEL_PATH="$resolved_model" get_model_field
        ;;
    deploy)
        # Fail-fast parsing (operand grammar, --from spec, unknown
        # flags, the marker) before any side effect; then the outer
        # arm (selection + re-execution).
        parse_deploy_args "${@:2}"
        deploy_outer
        ;;
    deploy-bootstrap)
        [[ -z "${2:-}" ]] || die "deploy-bootstrap takes no arguments."
        deploy_bootstrap_only
        ;;
    delete)
        [[ -n "${2:-}" ]] || die "Usage: $SCRIPT_NAME delete <model-name>"
        [[ -z "${3:-}" ]] || die "delete takes exactly one model operand."
        valid_model_operand "$2" "delete operand"
        delete_outer "$2"
        ;;
    staging)
        sub="${2:-}"
        case "$sub" in
            update)
                staging_update_supervisor "${@:3}"
                ;;
            activate-modelbank)
                staging_activate_modelbank "${@:3}"
                ;;
            modelbank-orphans)
                [[ -z "${3:-}" ]] || die "staging modelbank-orphans takes no arguments."
                staging_modelbank_orphans
                ;;
            modelbank-running)
                [[ -z "${3:-}" ]] || die "staging modelbank-running takes no arguments."
                staging_modelbank_running
                ;;
            *)
                echo "Usage: $SCRIPT_NAME staging {update|activate-modelbank|modelbank-orphans|modelbank-running} ..." >&2
                echo >&2
                echo "  update [--from REMOTE/BRANCH]   select, build, install ops, restart (default private/master)" >&2
                echo "  activate-modelbank [--leave-unexposed|--expose]" >&2
                echo "  modelbank-orphans               read-only orphan report" >&2
                echo "  modelbank-running               drain query (private helper)" >&2
                exit 1
                ;;
        esac
        ;;
    traffic)
        traffic
        ;;
    snapshot)
        # stg: addresses may have routed here (the staging checkout);
        # dev: and prd: stay on their invoking script. Either way, run
        # from the invoking script's canonical root.
        cd "$(canonical_checkout_root)" 2>/dev/null || true
        sub="${2:-}"
        case "$sub" in
            save)
                [[ -n "${3:-}" && -n "${4:-}" ]] \
                    || die "snapshot save needs a name and a source address: '$SCRIPT_NAME snapshot save <name> <src-address>' (e.g. books-1 dev:books, stg-books-golden stg:books, todos-prd-1 prd:todos)." \
                           "Legal address shapes: ${LEGAL_ADDRESSES}."
                [[ -z "${5:-}" ]] \
                    || die "snapshot save takes exactly two arguments (name, source address)."
                snapshot_save_pair "$3" "$4"
                ;;
            restore)
                [[ -n "${3:-}" && -n "${4:-}" ]] \
                    || die "snapshot restore needs a name and a destination address: '$SCRIPT_NAME snapshot restore <name> <dst-address>' (e.g. books-1 stg:books, stg-books-golden dev:books, todos-prd-1 prd:todos)." \
                           "Legal address shapes: ${LEGAL_ADDRESSES}."
                [[ -z "${5:-}" ]] \
                    || die "snapshot restore takes exactly two arguments (name, destination address)."
                snapshot_restore "$3" "$4"
                ;;
            list)
                [[ -z "${3:-}" ]] \
                    || die "snapshot list takes no arguments."
                snapshot_list
                ;;
            drop)
                [[ -n "${3:-}" ]] \
                    || die "snapshot drop needs a snapshot name: '$SCRIPT_NAME snapshot drop <name>'."
                [[ -z "${4:-}" ]] \
                    || die "snapshot drop takes exactly one argument (the snapshot name)."
                snapshot_drop "$3"
                ;;
            migrate)
                [[ -z "${3:-}" ]] \
                    || die "snapshot migrate takes no arguments (one-time maintenance verb; idempotent)."
                snapshot_migrate
                ;;
            *)
                cat >&2 <<SNAPUSAGE
Usage: $SCRIPT_NAME snapshot {save|restore|list|drop|migrate} ...

Save or restore a snapshot between explicit environments.

    save <name> <src-address>      e.g. books-1 dev:books
    restore <name> <dst-address>   e.g. books-1 stg:books
    list                           shared pool; names + provenance + timestamp
    drop <name>                    removes .dump + .files.tar.gz + .meta
    migrate                        one-time: rename legacy slots,
                                   stub .meta (idempotent)

Addresses are <qualifier>:<name>, both tokens mandatory on save /
restore — no defaults, no unqualified fallback. Qualifiers: dev
(built-in 5444 REPL, asserting the loaded model: dev:books), stg
(host profile: stg:books), prd (k3d production deploy:
prd:todos; must run on the deploy host from a checkout — the
verb scales the app to 0 for a restore, see docs/snapshots.md).
The one-arg muscle-memory forms are hard errors; the message
names the legal shapes.

FORCE=1 meanings: skip the delete/profile confirmations, and the
one escape on 'save' when dev:'s /api/info is unreachable. It
NEVER overrides a model mismatch, and the restore-unreachable skip
needs no FORCE at all.
SNAPUSAGE
                exit 1
                ;;
        esac
        ;;
    help)
        usage
        exit 0
        ;;
    *)
        if [[ -z "$ACTION" ]]; then
            echo "Missing command"
        else
            echo "Unknown command $ACTION"
        fi
        usage
        exit 1
        ;;
esac
