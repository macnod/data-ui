#!/bin/bash

SCRIPT_NAME=$(basename $0)
ACTION=$1

# Defaults only (profiles and export_* may override). Use := so pre-set
# values survive; deploy-compile keeps unconditional assignments.
: "${ADMIN_PASSWORD:=admin-password-1}"
: "${HTTP_HOST:=127.0.0.1}"
: "${DB_HOST:=127.0.0.1}"
: "${DB_INIT_TEMPLATE:=tests/init-template.sql}"
: "${DB_INIT_SQL:=tests/init.sql}"
: "${DB_NAME:=dataui}"
: "${DB_USER:=dataui}"
: "${DB_PASSWORD:=dataui-password}"
: "${DOCUMENT_ROOT:=tests/shared-files/}"
: "${FS_TEMP_DIRECTORY:=tests/temp-uploads/}"
export ADMIN_PASSWORD HTTP_HOST DB_HOST DB_INIT_TEMPLATE DB_INIT_SQL \
       DB_NAME DB_USER DB_PASSWORD DOCUMENT_ROOT FS_TEMP_DIRECTORY
export PGPASSWORD="$DB_PASSWORD"

TIMEOUT=60
SLEEP_INTERVAL=1
SLEEP_MAX=10

# D15: one env-overridable state root for all growing host state
# (profiles, snapshots, deploy). /data as a host convention is product
# precedent (apply_manifests hardcodes /data/k8s/data-ui/...); the
# override keeps other hosts possible. Every context that touches this
# state (units, interactive shells, the reset script) must agree — a
# mismatch silently splits state.
DATA_UI_STATE="${DATA_UI_STATE:-/data/data-ui}"
HOST_STATE_DIR="$DATA_UI_STATE/profiles"
SNAPSHOT_DIR="$DATA_UI_STATE/snapshots"

# Shared checkout machinery (source environments, selection, locks, the
# re-exec envelope), sourced through THIS script's canonical root so
# every clone runs its own copy. It defines die only if unset, so the
# die below later in this file simply overrides it.
SCRIPT_CANONICAL_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"
# shellcheck source=scripts/lib/checkout.sh
source "${SCRIPT_CANONICAL_ROOT}/scripts/lib/checkout.sh" \
    || { echo "ERROR: cannot source ${SCRIPT_CANONICAL_ROOT}/scripts/lib/checkout.sh" >&2; exit 1; }

function profile_dir {
    echo "${HOST_STATE_DIR}/${1}"
}

function profile_env_path {
    echo "${HOST_STATE_DIR}/${1}/profile.env"
}

function valid_profile_name {
    local name="$1"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] \
        || die "Invalid profile name '${name}'"
}

function pg_ident {
    # Postgres identifiers cannot contain hyphens.
    echo "${1//-/_}"
}

function model_file_path {
    # Top-level models only; no models/test/ fallback.
    echo "models/${1}.lisp"
}

function resolve_model_file {
    # First existing model file in set-model's search order minus
    # models/test/ (test fixtures are not addressable): models/<name>.lisp,
    # then models/local/<name>.lisp. Top-level shadows local, exactly
    # like set-model. Empty when neither exists; model_file_path
    # remains the error-text helper.
    local name="$1"
    if [[ -f "models/${name}.lisp" ]]; then
        echo "models/${name}.lisp"
    elif [[ -f "models/local/${name}.lisp" ]]; then
        echo "models/local/${name}.lisp"
    fi
}

function usage {
    cat <<EOF
Usage:
    $SCRIPT_NAME {command}

Commands:

repl [profile]
    Starts a Common Lisp REPL (using Roswell) that loads the test file at
    \$TEST_FILE, but doesn't run the tests. You can connect to the REPL with a
    client like Slime at the reported Swank port. Dev verb (throwaway
    5444 database) — demo profiles run under systemd units via the
    e-demo / demo verbs. With [profile], loads the profile's
    profile.env (complete partition) and auto set-model when MODEL_NAME
    is set.

db [profile]
    Start the PostgreSQL database for the profile (or dev) and connect to it;
    quiet-stop on exit.

psql [profile]
    Connect to an already-running PostgreSQL for the profile (or dev). Does not
    start or stop the database.

e-demo start <profile> [--from <snapshot>]
e-demo stop <profile>
e-demo reset [profile...]
    Lifecycle verbs for the nightly-reset demo class (todos, books).
    "e-demo" = ephemeral: the *data* is disposable, the process is
    permanent. start = preflight (app port only) → vacuum check →
    compose up → restore stg-<profile>-golden into a vacuum (degrade
    to empty start when absent) → stamp DEMO_CLASS → systemctl enable
    --now dataui@<profile>. stop is the shared class-blind teardown
    (refreshes stg-<profile>-last before tearing down). reset = the
    nightly golden reset on demand: no args = every enabled e-demo
    (dataui-reset.service; blocks until done); explicit profiles =
    the grungy-day path, any class. reset reinstalls the ops reset
    script first when the installed copy is stale.

demo start <profile> [--from <snapshot>]
demo stop <profile>
demo reset <profile> [...]
    Same verbs for the no-reset class (modelbank). Bare start resumes
    from stg-<profile>-last (the state at the last deliberate pause);
    the golden stays manual-only. stop is the same teardown as e-demo.
    reset is explicit-only (demo profiles are never in the nightly
    set): 'demo reset modelbank' is the grungy-day golden restore.

profile create <model> [profile]
        delete <profile>
        list
        expose <profile>
        unexpose <profile>
        install-model <model>
    Manage host profiles for locally-run instances.

    create: host profile for a model (models/<model>.lisp or
    models/local/<model>.lisp, set-model's order); profile name
    defaults to the model name. Fails if the profile already
    exists (no --force). Allocates free HTTP/Swank/DB ports, generates
    secrets, prints the admin password, and writes profile.env (mode 600).
    Does not start Postgres or the REPL.

    delete: stops the profile's Docker compose project with volumes and
    removes the profile directory. Refuses if the profile's HTTP or DB
    port is listening (exit the REPL first). Asks to type the profile
    name unless FORCE=1. Snapshots and deploy state are left alone.

    list: host profiles with model, ports, and whether the instance is
    running (HTTP port listening), plus the demo class (e-demo | demo;
    blank = never started) and the exposed hostname (blank = not
    exposed).

    expose: make a locally-run host profile reachable from the outside
    through the existing HAProxy TLS front door:
    https://<model :domain> -> 127.0.0.1:<HTTP_PORT>. Primary profiles only
    (profile name == model name). Requires sudo and must run on
    \$DEPLOY_HOST (default evo-x2), from a checkout containing
    models/<model>.lisp or models/local/<model>.lisp (and ros). TLS is
    covered by the existing *.demo.data-ui.com wildcard. Refuses if the
    domain is claimed by a deployed instance: 'delete' it first. Warns
    (does not fail) if the profile is not listening yet.

    unexpose: remove a profile's HAProxy exposure (backend file and map
    entry). Idempotent: prints 'not exposed' and exits 0 if there is
    nothing to remove. Requires sudo and must run on \$DEPLOY_HOST.
    'profile delete' does this cleanup automatically.

    install-model: deliver a local-only model (models/local/<model>.lisp)
    from the development checkout into the staging clone's
    models/local/, where the dataui@<profile> unit's set-model reads it.
    Runs on the deploy host (\$STAGING_HOST, default evo-x2 — the
    staging update rule) from the development checkout, never routes,
    and refuses a same-named top-level model in either tree. Committed
    models arrive via staging update instead.

tests
    Runs all the tests and reports success or failure.

docs
    Generates the README file.

stop
    Stops the database container and removes it. This is normally not necessary.

field <model-name> <field-name>
    Read a top-level field from a model file (models/<model-name>.lisp
    or models/local/<model-name>.lisp, set-model's order).

debug
    Runs the tests, printing all output from postgres and docker compose.

deploy <model-name> [--from REMOTE/BRANCH]
    deploy always builds the PRODUCTION checkout: it fetches and
    fast-forwards a clean clone at \$DEPLOY_CHECKOUT (default
    /data/data-ui/repos/production) to public/master — or exactly
    REMOTE/BRANCH with --from (canonical remotes: public
    git@github.com:macnod/data-ui.git, private
    git@github.com:macnod/data-ui-private.git) — prints the source and
    full SHA, and re-executes the production script there. No
    production build uses the caller's HEAD, branch, working tree, or
    remotes. Requires sudo (HAProxy) and must end up on \$DEPLOY_HOST
    (default evo-x2); from any other host it forwards over ssh (the
    caller's repo is never inspected, cleaned, or pushed). The model
    is read from models/<model-name>.lisp in the selected revision; a
    Model Bank worker instead sets MODEL_FILE (a unique file under
    models/local/deploy-incoming/, <=1 MiB, snapshot + SHA-256
    verified) which is installed as a candidate and promoted to
    models/local/<name>.lisp only after rollout plus both health
    gates (NodePort and public domain). DRY_RUN=1 still fetches,
    fast-forwards, compiles, and writes deploy state — it is NOT
    side-effect-free; it skips tagging, image build, and cluster
    mutation. A checkout lock (\$CHECKOUT_LOCK_ROOT, default
    /data/data-ui/repos) serializes every deploy/delete against dry
    runs and Model Bank workers. Deployment state (manifests,
    ports.lock, secrets, orphaned candidates, recovery records) lives
    in \$DEPLOY_STATE_DIR (default \$DATA_UI_STATE/deploy), outside
    every repository.

deploy-bootstrap
    Bootstrap-only production mode: create/validate the production
    clone and its remotes (and, at cutover, migrate legacy VIP
    identities) without compiling, building, or touching the cluster.
    This, not a dry run, is the first production action on a fresh
    host.

delete <model-name>
    Undeploys the model's app from the PRODUCTION checkout's script:
    deletes its Kubernetes namespace and PVs, wipes its data on the
    host, removes its HAProxy backend and map entry, and removes its
    deploy state (including secrets). Asks for confirmation unless
    FORCE=1 is set (forwarded over ssh -t when run remotely). It never
    fetches, switches, or requires a clean tree. Identity comes from
    the explicit MODEL_FILE, else the canonical models/<name>.lisp,
    else the stable models/local/<name>.lisp. Requires sudo (for
    HAProxy). Docker images and git release tags are left in place.

staging update [--from REMOTE/BRANCH]
staging activate-modelbank [--leave-unexposed|--expose]
staging modelbank-orphans
staging modelbank-running
    Manage the staging environment at \$STAGING_CHECKOUT (default
    /data/data-ui/repos/staging). update (default private/master)
    bootstraps/selects the staging clone under the staging +
    production locks, quiesces Model Bank first (unexpose + drain;
    never restarted by update), builds the frontend there (npm ci +
    npm run build), pre-warms SBCL, installs the host ops files, and
    plainly restarts active non-Model-Bank profiles behind per-profile
    health gates (\$STAGING_HEALTH_TIMEOUT, default 300s). Model Bank
    activates separately via activate-modelbank, which takes both
    locks itself, restarts the unit, verifies journal/loopback/Swank
    identity, and with --expose restores the originally recorded
    exposure. modelbank-orphans is a read-only report;
    modelbank-running is the private drain query. Routine profile /
    e-demo / demo / named repl/db/psql commands route to the staging
    checkout automatically and never fetch; snapshot stg: addresses
    route too; dev: and prd: never do.

traffic
    Shows HAProxy's per-IP rate-limit counters (concurrent connections,
    connection rate, request rate) and flags clients near or over the limits.
    Requires sudo.

snapshot save <name> <src-address>
         restore <name> <dst-address>
         list
         drop <name>
         migrate
    Save or restore a snapshot between explicit environments. Every
    address is <qualifier>:<name>, both tokens mandatory — no
    defaults, no unqualified fallback:
      dev:<model>   the built-in dev environment (5444 REPL),
                    asserting the loaded model: dev:books
      stg:<profile> a host profile: stg:books
    The second token is the SOURCE on save, the DESTINATION on
    restore — same position, same vocabulary, role fixed by the verb.
    Snapshots live in the shared pool /data/data-ui/snapshots/
    (DATA_UI_STATE) and carry a .meta manifest (model,
    source-address, timestamp, model-version best-effort); restore
    refuses a model mismatch (never FORCE-able) and re-stamps the
    destination's own admin password (auth rows travel with the
    dump; the dest's ADMIN_PASSWORD does not, so restore writes the
    dest's hash back — dev: admin-password-1, stg: the profile.env
    value) and prints a notice on a cross-environment restore.
    Dump and restore use the server container's own pg_dump/pg_restore,
    so they work regardless of the host's PostgreSQL client version.
    Restore takes a safety snapshot of the current database first
    (slot <dest>-prerestore, with its own .meta) and rolls back to it
    if the restore fails; the dump is restored in a single
    transaction. Snapshots include the files tree (DOCUMENT_ROOT) as
    <name>.files.tar.gz when present — packed under a canonical
    files/ top-level entry, so tars are portable across environments
    and old tars restore retroactively. Restore swaps it back in
    after the database.
    migrate is a one-time maintenance verb (idempotent): renames
    legacy profile-keyed slots to stg-<p>-* and stubs their .meta.
    FORCE=1 skips confirmations and is the only escape for
    'save' + unreachable dev: /api/info; it never overrides a
    model mismatch, and restore-unreachable skips need no FORCE.

help
    Displays this help text.
EOF
}

function die {
    # $* (space-joined, one line) so multi-arg parse errors keep their
    # legal-shapes line on screen; matching the ops script's die.
    echo "ERROR: $*" >&2
    exit 1
}

function render_init_sql {
    sed "s/:database_name:/${DB_NAME}/" "$DB_INIT_TEMPLATE" > "$DB_INIT_SQL"
}

function list_profiles {
    local d
    [[ -d "$HOST_STATE_DIR" ]] || return
    for d in "$HOST_STATE_DIR"/*/; do
        [[ -f "${d}profile.env" ]] || continue
        basename "$d"
    done
}

function profile_demo_class {
    # Class stamp from profile.env (D14): e-demo | demo. Empty when the
    # profile has never been started (the start verb owns the stamp).
    grep -oP '^DEMO_CLASS=\K.*' "$(profile_env_path "$1")"
}

function profile_exposed_host {
    # Exposed hostname (leading labels; .demo.data-ui.com stripped)
    # from the map line owned by the profile's backend; empty when not
    # exposed. Backend-keyed like profile_is_exposed, so a :domain
    # change cannot strand the old host here, and the map is the
    # router's truth — a bare conf.d file routes nothing. The map is
    # mode 644; reading it needs no sudo.
    [[ -f "$HAPROXY_MAP" ]] || return 0
    local domain
    domain=$(awk -v b="$(profile_backend_name "$1")" \
                 '$2 == b { print $1; exit }' "$HAPROXY_MAP")
    [[ -n "$domain" ]] || return 0
    echo "${domain%.demo.data-ui.com}"
}

function profile_routed_domain {
    # The FULL first field of the map line whose second field is the
    # profile's backend — the same lookup profile_exposed_host does,
    # but without stripping. This is the hostname actually routed; it
    # differs from profile_domain whenever a staging update brings a
    # changed :domain, so health gates on an already-exposed profile
    # use this, never profile_exposed_host (not a URL source) and
    # never profile_domain (recomputed from the model file).
    local name="$1"
    [[ -f "$HAPROXY_MAP" ]] || return 1
    awk -v b="$(profile_backend_name "$name")" \
        '$2 == b { print $1; exit }' "$HAPROXY_MAP"
}

function show_profiles {
    local name env model http swank db status class host
    local names
    names=$(list_profiles)
    if [[ -z "$names" ]]; then
        echo "No host profiles in ${HOST_STATE_DIR}"
        return
    fi
    haproxy_env
    printf '%-12s %-12s %-7s %-12s %-5s %-6s %-5s %s\n' \
           "PROFILE" "MODEL" "CLASS" "HOST" "HTTP" "SWANK" "DB" "STATUS"
    for name in $names; do
        env="$(profile_env_path "$name")"
        model=$(grep -oP '^MODEL_NAME=\K.*' "$env")
        class=$(profile_demo_class "$name")
        http=$(grep -oP '^HTTP_PORT=\K\d+' "$env")
        swank=$(grep -oP '^SWANK_PORT=\K\d+' "$env")
        db=$(grep -oP '^DB_PORT=\K\d+' "$env")
        host=$(profile_exposed_host "$name")
        if ss -ltn 2>/dev/null | awk '{print $4}' \
               | grep -qE "[:.]${http}\$"; then
            status="running"
        else
            status="stopped"
        fi
        printf '%-12s %-12s %-7s %-12s %-5s %-6s %-5s %s\n' \
               "$name" "$model" "$class" "$host" \
               "$http" "$swank" "$db" "$status"
    done
}

#
# Profile port allocation
#

# Ports reserved for the unnamed repl, tests, and deploy compile.
RESERVED_PORTS="8081 8082 4010 4011 5444 5445 5446"

function listening_ports {
    ss -ltn 2>/dev/null | awk '{print $4}' \
        | grep -oE '[0-9]+$' | sort -u
}

function claimed_profile_ports {
    # Parse port lines from other profiles; never source them.
    local env
    [[ -d "$HOST_STATE_DIR" ]] || return
    for env in "$HOST_STATE_DIR"/*/profile.env; do
        [[ -f "$env" ]] || continue
        grep -E '^(HTTP_PORT|SWANK_PORT|DB_PORT)=' "$env" \
            | cut -d= -f2
    done
}

TAKEN_PORTS=""

function collect_taken_ports {
    # One pass: reserved ports, other profiles' claims, live listeners.
    TAKEN_PORTS=$(printf '%s\n%s\n%s\n' \
                      "$RESERVED_PORTS" \
                      "$(claimed_profile_ports)" \
                      "$(listening_ports)" | sort -u)
}

function port_taken {
    printf '%s\n' "$TAKEN_PORTS" | grep -qx "$1"
}

function next_free_port {
    local port="$1"
    while port_taken "$port"; do
        port=$(( port + 1 ))
        if (( port > 65535 )); then
            die "No free port found starting at ${1}"
        fi
    done
    echo "$port"
}

function allocate_profile_ports {
    collect_taken_ports
    HTTP_PORT=$(next_free_port 8083)
    SWANK_PORT=$(next_free_port 4012)
    DB_PORT=$(next_free_port 5447)
}

function generate_profile_secrets {
    DB_PASSWORD=$(openssl rand -hex 16)
    # rbac's password policy requires a letter, a digit, and a
    # punctuation character; the suffix guarantees all three.
    ADMIN_PASSWORD=$(openssl rand -hex 8)-a1
    JWT_SECRET=$(openssl rand -hex 16)
}

function write_profile_env {
    local dir="$1"
    # D16: PGDATA_DIR / PG_UID / PG_GID are the unit user's ids
    # (macnod's), never $(id -u) of whoever ran profile create — a
    # sudo or agent caller would stamp the wrong owner. Without the
    # stamps compose substitutes empty and docker creates the bind
    # source as root, the exact failure this design prevents.
    local pg_uid pg_gid
    pg_uid=$(id -u macnod)
    pg_gid=$(id -g macnod)
    cat > "$(profile_env_path "$PROFILE_NAME")" <<ENV
HTTP_PORT=${HTTP_PORT}
SWANK_PORT=${SWANK_PORT}
SWANK_INTERFACE=127.0.0.1
DB_PORT=${DB_PORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_CONTAINER=pg-data-ui-${PROFILE_NAME}
DB_SERVICE=pg-data-ui
DB_DOCKER_COMPOSE=ops/pg-profile.yaml
PGDATA_DIR=${dir}/pgdata
PG_UID=${pg_uid}
PG_GID=${pg_gid}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
JWT_SECRET=${JWT_SECRET}
PROTECTED_USERS=demos
DOCUMENT_ROOT=${dir}/files
FS_TEMP_DIRECTORY=${dir}/temp
LOG_FILE=${dir}/repl.log
MODEL_NAME=${MODEL_NAME}
HTTP_HOST=127.0.0.1
DB_HOST=127.0.0.1
WEB_DIRECTORY=web/dist
LOG_SEVERITY=DEBUG
RUN_TESTS=false
PUBLIC_ORIGIN=http://127.0.0.1:${HTTP_PORT}
ENV
    chmod 600 "$(profile_env_path "$PROFILE_NAME")"
}

function create_profile {
    MODEL_NAME="$1"
    PROFILE_NAME="${2:-$1}"
    [[ -n "$MODEL_NAME" ]] || { usage; exit 1; }
    valid_profile_name "$MODEL_NAME"
    valid_profile_name "$PROFILE_NAME"
    local resolved
    resolved=$(resolve_model_file "$MODEL_NAME")
    if [[ -z "$resolved" ]]; then
        # create runs post-routing, so this root is the staging
        # checkout, not the checkout the operator typed the command
        # in — name the absolute root explicitly.
        die "No model '${MODEL_NAME}' (looked for models/${MODEL_NAME}.lisp, models/local/${MODEL_NAME}.lisp under $(canonical_checkout_root)). A development-checkout model must be delivered first: run '$SCRIPT_NAME profile install-model ${MODEL_NAME}' from the development checkout."
    fi
    if [[ -f "$(profile_env_path "$PROFILE_NAME")" ]]; then
        die "Profile '${PROFILE_NAME}' already exists. Use '$SCRIPT_NAME profile delete ${PROFILE_NAME}' first."
    fi
    allocate_profile_ports
    generate_profile_secrets
    DB_NAME=$(pg_ident "$PROFILE_NAME")
    DB_USER=$DB_NAME
    local dir
    dir=$(profile_dir "$PROFILE_NAME")
    mkdir -p "${dir}/files" "${dir}/temp"
    write_profile_env "$dir"
    echo "Created profile '${PROFILE_NAME}'"
    echo "  model:      ${MODEL_NAME}"
    echo "  HTTP port:  ${HTTP_PORT}"
    echo "  Swank port: ${SWANK_PORT}"
    echo "  DB port:    ${DB_PORT}"
    echo "  DB name:    ${DB_NAME}"
    echo "  DB user:    ${DB_USER}"
    echo "  DB container: pg-data-ui-${PROFILE_NAME}"
    echo "  Admin:      admin / ${ADMIN_PASSWORD}"
    echo
    echo "Next: edit $(profile_env_path "$PROFILE_NAME") (LOG_SEVERITY=INFO),"
    if [[ "$PROFILE_NAME" == "$MODEL_NAME" ]]; then
        echo "  optional, for a public URL (needs sudo): $SCRIPT_NAME profile expose ${PROFILE_NAME}"
    fi
    echo "then: $SCRIPT_NAME e-demo start ${PROFILE_NAME}   (nightly-reset class)"
    echo "  or: $SCRIPT_NAME demo start ${PROFILE_NAME}    (no-reset class)"
    echo "e-demos: seed via the admin UI, then snapshot the golden the nightly reset restores:"
    echo "  $SCRIPT_NAME snapshot save stg-${PROFILE_NAME}-golden stg:${PROFILE_NAME}"
}

function delete_profile {
    PROFILE_NAME="$1"
    [[ -n "$PROFILE_NAME" ]] || die "Usage: $SCRIPT_NAME profile delete <profile>"
    valid_profile_name "$PROFILE_NAME"
    if [[ ! -f "$(profile_env_path "$PROFILE_NAME")" ]]; then
        local available
        available=$(list_profiles | tr '\n' ' ')
        die "Unknown profile '${PROFILE_NAME}'. Available: ${available:-"(none)"}"
    fi
    # Load so compose project, ports, and DB_CONTAINER are known.
    load_profile "$PROFILE_NAME"
    local port
    for port in "$HTTP_PORT" "$DB_PORT"; do
        if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"; then
            die "Profile '${PROFILE_NAME}' appears to be running (port ${port} in use). Run '$SCRIPT_NAME e-demo stop ${PROFILE_NAME}' (or 'demo stop') first, then retry."
        fi
    done
    if [[ -z "$FORCE" ]]; then
        local reply
        read -r -p "Type the profile name ('${PROFILE_NAME}') to confirm: " reply
        [[ "$reply" == "$PROFILE_NAME" ]] || die "Confirmation did not match; aborting."
    fi
    # HAProxy cleanup for an exposed profile. Paths first (delete_profile
    # never ran export_deploy_environment). No host guard: deleting a
    # laptop-local profile that was never exposed must stay possible.
    haproxy_env
    if [[ "$(hostname)" != "$DEPLOY_HOST" ]]; then
        echo "HAProxy cleanup skipped (not on ${DEPLOY_HOST})."
        echo "If '${PROFILE_NAME}' is exposed, run '$SCRIPT_NAME profile unexpose ${PROFILE_NAME}' on ${DEPLOY_HOST}."
    elif profile_is_exposed "$PROFILE_NAME"; then
        remove_profile_exposure "$PROFILE_NAME"
        haproxy_validate_and_reload "" tolerant
        echo "Removed HAProxy exposure for '${PROFILE_NAME}'."
    fi
    # Tolerate a project that was never started.
    compose down --remove-orphans --volumes &>/dev/null || true
    rm -rf "$(profile_dir "$PROFILE_NAME")"
    local snapshots=()
    if [[ -f "${SNAPSHOT_DIR}/${PROFILE_NAME}.dump" ]]; then
        snapshots+=("${PROFILE_NAME}.dump")
    fi
    local f
    for f in "${SNAPSHOT_DIR}/${PROFILE_NAME}-"*.dump; do
        [[ -f "$f" ]] && snapshots+=("$(basename "$f")")
    done
    # Snapshot 2: address-keyed slots (stg-<p>-golden etc.) match
    # neither selector above. Union glob AND .meta scan, not one or
    # the other: the glob catches stubless slots (a partial
    # migration), and scanning .meta for source-address=stg:<p>
    # catches hand-named saves (books-1) the glob silently drops.
    # Dev-keyed slots (dev-<model>-prerestore) are dev state; they
    # survive a profile delete.
    local seen m base
    declare -A seen=()
    for f in "${SNAPSHOT_DIR}/stg-${PROFILE_NAME}-"*.dump; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        [[ -n "${seen[$base]:-}" ]] && continue
        seen[$base]=t
        snapshots+=("$base.dump")
    done
    for m in "$SNAPSHOT_DIR"/*.meta; do
        [[ -f "$m" ]] || continue
        [[ "$(sed -n 's/^source-address=//p' "$m" | tail -n1)" \
           == "stg:${PROFILE_NAME}" ]] || continue
        base="$(basename "$m" .meta)"
        [[ -f "${SNAPSHOT_DIR}/${base}.dump" ]] || continue
        [[ -n "${seen[$base]:-}" ]] && continue
        seen[$base]=t
        snapshots+=("$base.dump")
    done
    if (( ${#snapshots[@]} > 0 )); then
        echo "Leaving snapshot(s): ${snapshots[*]}"
        echo "Use '$SCRIPT_NAME snapshot drop <name>' to remove them."
    fi
    echo "Deleted profile '${PROFILE_NAME}'."
    echo "Deploy state and snapshots were not touched."
}

#
# Profile exposure (HAProxy front door for a local instance)
#

function profile_backend_name {
    echo "dataui-profile-${1}"
}

function profile_conf_path {
    echo "${HAPROXY_CONF_D}/dataui-profile-${1}.cfg"
}

function require_haproxy_host {
    [[ "$(hostname)" == "$DEPLOY_HOST" ]] \
        || die "$1 must run on ${DEPLOY_HOST} (this is $(hostname))."
}

function profile_domain {
    # The public hostname comes from the model's :domain-stg when
    # present, else :domain with -stg suffixed onto the first DNS
    # label (the compiler's default, duplicated here because this is
    # a pure file read via lisp/deployment.lisp; no database, no
    # compiler — see the unify-reads todo). MODEL_NAME is read from
    # the profile env, not sourced.
    local name="$1" model domain resolved
    model=$(grep -oP '^MODEL_NAME=\K.*' "$(profile_env_path "$name")")
    [[ -n "$model" ]] || die "Profile '${name}' has no MODEL_NAME."
    resolved=$(resolve_model_file "$model")
    [[ -n "$resolved" ]] \
        || die "No model '${model}' (looked for models/${model}.lisp, models/local/${model}.lisp)."
    MODEL_NAME="$model" DATA_UI_MODEL_PATH="$resolved" DATA_UI_FIELD_NAME="domain" get_model_field >/dev/null 2>&1 \
        || die "Could not read :domain from ${resolved}."
    domain=$(MODEL_NAME="$model" DATA_UI_MODEL_PATH="$resolved" model_field domain-stg)
    if [[ -z "$domain" || "$domain" == "NIL" ]]; then
        domain=$(MODEL_NAME="$model" DATA_UI_MODEL_PATH="$resolved" model_field domain)
        [[ -n "$domain" && "$domain" != "NIL" ]] \
            || die "Model '${model}' has no :domain; cannot expose."
        local first="${domain%%.*}" rest="${domain#*.}"
        domain="${first}-stg.${rest}"
    fi
    echo "$domain"
}

function remove_profile_exposure {
    # Drop the conf.d backend and every map line pointing at it (exact
    # second-field match, never a substring). No validate/reload here;
    # the caller decides and does it.
    local name="$1"
    sudo rm -f "$(profile_conf_path "$name")"
    haproxy_map_delete_backend "$(profile_backend_name "$name")"
}

function profile_is_exposed {
    # Backend-keyed: a map entry whose second field equals our backend,
    # or the conf.d file. Survives a :domain change after expose.
    local name="$1"
    [[ -f "$(profile_conf_path "$name")" ]] && return 0
    [[ -f "$HAPROXY_MAP" ]] || return 1
    awk -v b="$(profile_backend_name "$name")" \
        '$2 == b { found = 1 } END { exit !found }' "$HAPROXY_MAP"
}

function expose_profile {
    PROFILE_NAME="$1"
    [[ -n "$PROFILE_NAME" ]] || die "Usage: $SCRIPT_NAME profile expose <profile>"
    valid_profile_name "$PROFILE_NAME"
    if [[ ! -f "$(profile_env_path "$PROFILE_NAME")" ]]; then
        local available
        available=$(list_profiles | tr '\n' ' ')
        die "Unknown profile '${PROFILE_NAME}'. Available: ${available:-"(none)"}"
    fi
    haproxy_env
    require_haproxy_host "profile expose"
    local model_name
    model_name=$(grep -oP '^MODEL_NAME=\K.*' "$(profile_env_path "$PROFILE_NAME")")
    if [[ "$PROFILE_NAME" != "$model_name" ]]; then
        die "Only the primary profile (name == model) can be exposed; '${PROFILE_NAME}' runs model '${model_name}'."
    fi
    local domain http_port
    domain=$(profile_domain "$PROFILE_NAME")
    http_port=$(grep -oP '^HTTP_PORT=\K\d+' "$(profile_env_path "$PROFILE_NAME")")
    [[ -n "$http_port" ]] || die "Profile '${PROFILE_NAME}' has no HTTP_PORT."
    # One domain, one owner: refuse to hijack a deployed instance's map
    # line. Re-exposing our own profile backend is fine (step below
    # first purges any stale domain from an earlier expose).
    local backend owner
    backend="$(profile_backend_name "$PROFILE_NAME")"
    if [[ -f "$HAPROXY_MAP" ]]; then
        owner=$(awk -v d="$domain" '$1 == d { print $2; exit }' "$HAPROXY_MAP")
        if [[ -n "$owner" && "$owner" != "$backend" ]]; then
            if [[ "$owner" == dataui-profile-* ]]; then
                local other="${owner#dataui-profile-}"
                die "Domain ${domain} is claimed by host profile '${other}'; run '$SCRIPT_NAME profile unexpose ${other}' first."
            fi
            die "Domain ${domain} is claimed by deployed instance backend '${owner}'; run '$SCRIPT_NAME delete' on that instance first."
        fi
    fi
    local need_restart
    need_restart=$(haproxy_bootstrap)
    # Backend config via temp file + install (never a predictable /tmp
    # path, never a sudo tee heredoc pipe).
    local tmp
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' RETURN
    cat > "$tmp" <<CFG
backend ${backend}
    mode http
    option forwardfor
    option httpchk GET /health
    server ${backend} 127.0.0.1:${http_port} check inter 2000 rise 2 fall 3
CFG
    sudo install -m 644 "$tmp" "$(profile_conf_path "$PROFILE_NAME")"
    # Purge stale lines for our backend (a changed :domain must not
    # leave the old host routing), then add the fresh entry.
    haproxy_map_delete_backend "$backend"
    echo "${domain} ${backend}" | sudo tee -a "$HAPROXY_MAP" >/dev/null
    # Public pages: the profile's canonical origin is the exposed
    # https domain (feed guids, og:url, sitemap). The profile must be
    # restarted so the image re-reads the variable.
    local env_path
    env_path="$(profile_env_path "$PROFILE_NAME")"
    if grep -q '^PUBLIC_ORIGIN=' "$env_path"; then
        sed -i "s|^PUBLIC_ORIGIN=.*|PUBLIC_ORIGIN=https://${domain}|" "$env_path"
    else
        echo "PUBLIC_ORIGIN=https://${domain}" >> "$env_path"
    fi
    local http_port_env
    http_port_env=$(grep -oP '^HTTP_PORT=\K\d+' "$env_path" || true)
    haproxy_validate_and_reload "$need_restart"
    if ! ss -ltn 2>/dev/null | awk '{print $4}' \
           | grep -qE "[:.]${http_port}\$"; then
        echo "WARNING: profile '${PROFILE_NAME}' is not listening on ${http_port} yet; start it with '$SCRIPT_NAME e-demo start ${PROFILE_NAME}' (or 'demo start')." >&2
    fi
    echo "Exposed '${PROFILE_NAME}': https://${domain} -> 127.0.0.1:${http_port}"
    echo "PUBLIC_ORIGIN in ${env_path} is now https://${domain}; restart the profile so the image re-reads it."
}

function unexpose_profile {
    PROFILE_NAME="$1"
    [[ -n "$PROFILE_NAME" ]] || die "Usage: $SCRIPT_NAME profile unexpose <profile>"
    valid_profile_name "$PROFILE_NAME"
    if [[ ! -f "$(profile_env_path "$PROFILE_NAME")" ]]; then
        local available
        available=$(list_profiles | tr '\n' ' ')
        die "Unknown profile '${PROFILE_NAME}'. Available: ${available:-"(none)"}"
    fi
    haproxy_env
    require_haproxy_host "profile unexpose"
    if ! profile_is_exposed "$PROFILE_NAME"; then
        echo "Profile '${PROFILE_NAME}' is not exposed."
        return 0
    fi
    # No haproxy_bootstrap here: enabling conf.d as a side effect of a
    # remove would be wrong, and exposure implies it is already on.
    remove_profile_exposure "$PROFILE_NAME"
    haproxy_validate_and_reload ""
    # Public pages: restore the loopback origin (the pre-expose
    # spelling). The profile must be restarted to re-read it.
    local env_path http_port_env
    env_path="$(profile_env_path "$PROFILE_NAME")"
    http_port_env=$(grep -oP '^HTTP_PORT=\K\d+' "$env_path" || true)
    if grep -q '^PUBLIC_ORIGIN=' "$env_path"; then
        sed -i "s|^PUBLIC_ORIGIN=.*|PUBLIC_ORIGIN=http://127.0.0.1:${http_port_env}|" "$env_path"
    fi
    echo "Removed HAProxy exposure for '${PROFILE_NAME}'."
    echo "PUBLIC_ORIGIN in ${env_path} is back to http://127.0.0.1:${http_port_env}; restart the profile so the image re-reads it."
}

function install_profile_model {
    # profile install-model <model>: deliver a local-only model from
    # the invoking (development) checkout into the staging clone's
    # models/local/, so the dataui@<p> unit's set-model (which runs
    # from the staging tree) can find it. The staging sibling of
    # production's deploy-incoming -> models/local/<name>.lisp promote
    # pattern; git cannot carry the file (the ignore is the point) and
    # staging update never installs ignored files. Never routes: the
    # invoking script is the only side that knows both paths.
    local model="$1"
    # First of all, the staging-update / activate-modelbank host guard
    # shape: the verb writes host-local tree state and never routes,
    # so a wrong-host invocation must be a visible error, never a copy
    # onto some other machine's /data.
    [[ "$(hostname)" == "$STAGING_HOST" ]] \
        || die "profile install-model must run on ${STAGING_HOST} (this is $(hostname))."
    [[ -n "$model" ]] || die "Usage: $SCRIPT_NAME profile install-model <model>"
    [[ -z "${2:-}" ]] || die "install-model takes exactly one argument (the model name)."
    # create_profile's pattern, run before any path is built: ../x and
    # the empty arg die here, not inside mkdir -p / cp.
    valid_profile_name "$model"
    cd "$(canonical_checkout_root)" 2>/dev/null \
        || die "cannot cd to the invoking checkout $(canonical_checkout_root)."
    # Local-only by two refusals. First: a top-level file in the
    # invoking checkout (committed or uncommitted — a dirty one is the
    # same collision once staging update lands it).
    if [[ -f "models/${model}.lisp" ]]; then
        die "top-level file models/${model}.lisp exists (committed or uncommitted); staging update delivers committed models."
    fi
    local src
    src=$(resolve_model_file "$model")
    [[ -n "$src" ]] \
        || die "No local model '${model}' (looked for models/${model}.lisp, models/local/${model}.lisp)."
    # The -x gate matches the router on the same canonicalized path,
    # so a non-executable script fails here with the right hint
    # instead of inside the router with the wrong one.
    local staging_root
    staging_root=$(readlink -m "$STAGING_CHECKOUT")
    [[ -x "${staging_root}/scripts/data-ui" ]] \
        || die "No staging checkout at ${staging_root}; run 'scripts/data-ui staging update' first."
    # Second refusal: a canonical model in the staging tree.
    # resolve-model-path prefers the canonical file, so the unit would
    # silently run the upstream model once staging update lands it —
    # deploy_check_identity's upstream-collision refusal, transplanted.
    if [[ -f "${staging_root}/models/${model}.lisp" ]]; then
        die "canonical model already in the staging checkout at ${staging_root}/models/${model}.lisp; the unit would run it, not the delivered copy (dev tree: $(canonical_checkout_root)/models/${model}.lisp absent, staging tree: present)."
    fi
    # Declared-:name gate (delete_selected / migrate_legacy_vip_
    # identities' model_field name pattern): the file name is the
    # address every later lookup keys on. Before any destination
    # mutation.
    local declared
    declared=$(MODEL_NAME="$model" DATA_UI_MODEL_PATH="$src" model_field name)
    [[ -n "$declared" && "$declared" != "NIL" ]] \
        || die "Model has no :name."
    [[ "$declared" == "$model" ]] \
        || die "Model :name is '${declared}' but the install operand is '${model}'; they must match."
    # Source cleanliness gate (install_deploy_candidate's shape minus
    # the token machinery; take_model_snapshot's cap): a symlinked or
    # oversized source dies before any destination mutation.
    local size
    [[ -f "$src" && ! -L "$src" ]] \
        || die "Model source must be a regular file, not a symlink: ${src}."
    size=$(stat -c %s "$src")
    (( size > 0 )) || die "Model source is empty: ${src}."
    (( size <= 1048576 )) || die "Model source is larger than 1 MiB (${size} bytes): ${src}."
    # Overwrite is allowed — models/local/ is runtime state.
    local dest tmp got
    dest="${staging_root}/models/local/${model}.lisp"
    mkdir -p "${staging_root}/models/local"
    if [[ -f "$dest" ]]; then
        if [[ "$(sha256sum "$src" | cut -d' ' -f1)" == "$(sha256sum "$dest" | cut -d' ' -f1)" ]]; then
            echo "already installed (identical bytes): ${dest}"
            echo "Installed ${model}: ${src} -> ${dest}"
            return 0
        fi
        echo "overwriting ${dest} (bytes differ)"
    fi
    # Temp-then-mv onto the dest (install_deploy_candidate's shape —
    # same VIP sensitivity; a bare cp onto the final name can strand a
    # partial file on a mid-write death, and the mode survives the
    # same-directory mv).
    tmp="${staging_root}/models/local/.${model}.lisp.tmp.$$"
    cp -- "$src" "$tmp" || { rm -f "$tmp"; die "cannot stage the model copy."; }
    chmod 600 "$tmp"
    got=$(sha256sum "$tmp" | cut -d' ' -f1)
    [[ "$got" == "$(sha256sum "$src" | cut -d' ' -f1)" ]] \
        || { rm -f "$tmp"; die "model copy hash mismatch after the copy."; }
    mv "$tmp" "$dest" || { rm -f "$tmp"; die "cannot install the model copy."; }
    echo "Installed ${model}: ${src} -> ${dest}"
}

function load_profile {
    local name="$1"
    valid_profile_name "$name"
    local path
    path="$(profile_env_path "$name")"
    if [[ ! -f "$path" ]]; then
        local available
        available=$(list_profiles | tr '\n' ' ')
        die "Unknown profile '${name}'. Available: ${available:-"(none)"}"
    fi
    # shellcheck disable=SC1090
    set -a
    # shellcheck source=/dev/null
    source "$path"
    set +a

    local required key
    required=(
        HTTP_PORT SWANK_PORT SWANK_INTERFACE DB_PORT DB_NAME DB_USER
        DB_PASSWORD DB_CONTAINER DB_SERVICE DB_DOCKER_COMPOSE
        PGDATA_DIR PG_UID PG_GID
        ADMIN_PASSWORD JWT_SECRET DOCUMENT_ROOT FS_TEMP_DIRECTORY
        LOG_FILE MODEL_NAME PUBLIC_ORIGIN
    )
    for key in "${required[@]}"; do
        if [[ -z "${!key}" ]]; then
            die "Profile '${name}' missing required key: ${key}"
        fi
    done

    export HTTP_PORT SWANK_PORT SWANK_INTERFACE DB_PORT DB_NAME DB_USER \
           DB_PASSWORD DB_CONTAINER DB_SERVICE DB_DOCKER_COMPOSE \
           ADMIN_PASSWORD JWT_SECRET DOCUMENT_ROOT FS_TEMP_DIRECTORY \
           LOG_FILE MODEL_NAME PUBLIC_ORIGIN
    # Optional keys profiles may set
    [[ -n "${HTTP_HOST:-}" ]] && export HTTP_HOST
    [[ -n "${DB_HOST:-}" ]] && export DB_HOST
    [[ -n "${WEB_DIRECTORY:-}" ]] && export WEB_DIRECTORY
    [[ -n "${LOG_SEVERITY:-}" ]] && export LOG_SEVERITY
    [[ -n "${RUN_TESTS:-}" ]] && export RUN_TESTS
    # FR-12: accounts only admin may change or delete (besides
    # admin / guest, which the Lisp protects unconditionally).
    [[ -n "${PROTECTED_USERS:-}" ]] && export PROTECTED_USERS
    # D14: how the profile was last started (e-demo | demo). Absent =
    # not in the nightly set; the start verb owns the stamp.
    [[ -n "${DEMO_CLASS:-}" ]] && export DEMO_CLASS

    export PGPASSWORD="$DB_PASSWORD"
    render_init_sql
}

#
# Snapshot addresses (Snapshot 2)
#
# A snapshot is a portable artifact in one shared pool, aimed at an
# explicit address. Every address is <qualifier>:<name>, mandatory,
# no unqualified fallback: stg:<profile> is a host profile, dev:<model>
# is the built-in dev environment (the 5444 REPL) asserting its model,
# prd:<instance> is a k3d production deploy. Identity comes from the
# address, never from the live app.

# One string, every parse-error site + both usage texts: the next arm
# is one edit (round-2 should-fix).
LEGAL_ADDRESSES="dev:<model> (e.g. dev:books), stg:<profile> (e.g. stg:books), prd:<instance> (e.g. prd:todos)"

function valid_snapshot_name {
    # Same grammar as profile names; the colon is illegal so an
    # address-shaped token at the name slot is a parse error, not a
    # minted file. Message says "snapshot name", never "profile name".
    local name="$1"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] \
        || die "Invalid snapshot name '${name}' (must match ^[A-Za-z0-9][A-Za-z0-9_-]*$)"
}

function resolve_snapshot_address {
    # Parse and resolve an explicit <qualifier>:<name> address into the
    # shell environment (DB_CONTAINER etc.) plus ADDRESS_MODEL (the
    # asserted model: the dev token, the profile's MODEL_NAME, or —
    # prd — the instance name itself) and ADDRESS_QUALIFIER. The
    # referent is validated: dev: requires models/<model>.lisp, stg:
    # requires profile.env, prd: requires the live cluster namespace.
    local raw="$1" role="$2"
    [[ -n "$raw" ]] \
        || die "Missing ${role} address. Legal shapes: ${LEGAL_ADDRESSES}."
    [[ "$raw" != *:* ]] \
        && die "Invalid ${role} address '${raw}': no qualifier. Legal shapes: ${LEGAL_ADDRESSES}."
    [[ "$raw" != *:*:* ]] \
        || die "Invalid ${role} address '${raw}': extra colon. Legal shapes: ${LEGAL_ADDRESSES}."
    local qualifier="${raw%%:*}" name="${raw#*:}"
    [[ -n "$qualifier" ]] \
        || die "Invalid ${role} address '${raw}': empty qualifier. Legal shapes: ${LEGAL_ADDRESSES}."
    [[ -n "$name" ]] \
        || die "Invalid ${role} address '${raw}': empty name. Legal shapes: ${LEGAL_ADDRESSES}."
    # Qualifiers are case-sensitive and resolved through this registry;
    # it IS the grammar spec.
    case "$qualifier" in
        dev)
            local resolved
            resolved=$(resolve_model_file "$name")
            if [[ -z "$resolved" ]]; then
                die "No top-level model '${name}' for ${role} address dev:${name} (looked for models/${name}.lisp, models/local/${name}.lisp)."
            fi
            export_repl_environment
            render_init_sql
            ADDRESS_MODEL="$name"
            ;;
        stg)
            if [[ ! -f "$(profile_env_path "$name")" ]]; then
                local available
                available=$(list_profiles | tr '\n' ' ')
                die "Unknown profile '${name}' for ${role} address stg:${name}. Available: ${available:-(none)}"
            fi
            load_profile "$name"
            ADDRESS_MODEL="$MODEL_NAME"
            ;;
        prd)
            resolve_prd_address "$name" "$role"
            ;;
        *)
            die "Unknown ${role} address qualifier '${qualifier}' in '${raw}'. Known qualifiers: dev, stg, prd."
            ;;
    esac
    ADDRESS_QUALIFIER="$qualifier"
    ADDRESS_NAME="$name"
}

function resolve_prd_address {
    # prd:<name> — a k3d production deploy. The tail IS the model
    # (equivalently the instance): namespace, deployments, and Secret
    # are all dataui-<name> / <name>. Cluster is truth; no local file
    # is consulted, and never secrets.env (a cache; the live Secret is
    # the source and a stale cache would re-stamp the wrong password).
    local name="$1" role="$2"
    # Name grammar FIRST, before the name is interpolated into kubectl
    # -n dataui-<name> and friends: this regex is the arm's own gate
    # (same shape as valid_snapshot_name's, but that validates the
    # snapshot slot name — a different argument; do not cite it).
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] \
        || die "Invalid instance name '${name}' for ${role} address prd:${name} (must match ^[A-Za-z0-9][A-Za-z0-9_-]*$)."
    # Checkout: model_field / get_model_field shell out to
    # lisp/deployment.lisp via a checkout-relative path (verb_start's
    # pattern). prd snapshot verbs therefore run from any cwd.
    cd "$(dirname "$(readlink -f "$0")")/.." \
        || die "cannot cd to the checkout for prd:${name}"
    # Local-host guard: snapshots read cluster truth and host files
    # (snapshot pool, PV hostPaths) that only exist on the deploy
    # host. DEPLOY_HOST is exported only inside haproxy_env, so that
    # setup must run first (round-5 correction: a guard called before
    # it dies on an unset DEPLOY_HOST on the correct machine).
    haproxy_env
    require_haproxy_host "snapshot ${role} with a prd: address"
    kubectl get ns "dataui-${name}" &>/dev/null \
        || die "No deployed instance '${name}' for ${role} address prd:${name} (namespace dataui-${name} not found in the cluster)."
    # NodePort, pinned from the live Service (never reconstructed);
    # HTTP_HOST/HTTP_PORT ride the +1000 loopback hop so
    # api_info_model works unchanged over plain HTTP.
    local node_port
    node_port=$(kubectl -n "dataui-${name}" get svc "dataui-${name}" \
                    -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null)
    [[ -n "$node_port" ]] \
        || die "Service dataui-${name} (namespace dataui-${name}) has no NodePort for prd:${name}."
    # Passwords — the arm owns the exports, unconditionally
    # (environment-inheritance hazard): a dev:/stg: resolve earlier in
    # the same shell leaves its DB_PASSWORD/ADMIN_PASSWORD/PGPASSWORD
    # exported, and stamp_admin_password would hash the stale value
    # into prod. get_cluster_secret is a bare pipe with no status
    # check, so empty reads die here rather than exporting empty.
    local ns_secret
    for ns_secret in admin-password db-password; do
        local key value
        key="${ns_secret%%-*}_password"
        NAMESPACE="dataui-${name}" NAME="$name" \
            value=$(get_cluster_secret "$ns_secret")
        [[ -n "$value" ]] \
            || die "Empty '${ns_secret}' read from Secret dataui-${name}-secrets (namespace dataui-${name}) for prd:${name}; refusing to proceed with an empty password."
        if [[ "$ns_secret" == "db-password" ]]; then
            DB_PASSWORD="$value"
        else
            ADMIN_PASSWORD="$value"
        fi
    done
    export DB_PASSWORD ADMIN_PASSWORD
    export PGPASSWORD="$DB_PASSWORD"
    # DB identity pinned by the k8s templates; the two named
    # coordinates every prd path reads (db_exec, the prd die message).
    # Never DB_SERVICE: compose-only, unset on the prd path.
    export DB_NAME="dataui" DB_USER="dataui"
    PRD_NAMESPACE="dataui-${name}"
    PRD_PG_DEPLOY="dataui-${name}-postgres"
    export PRD_NAMESPACE PRD_PG_DEPLOY
    export HTTP_HOST="127.0.0.1" HTTP_PORT=$(( node_port + 1000 ))
    # DOCUMENT_ROOT, pinned from the live files PV (cluster-is-truth;
    # never string surgery on /data/k8s/...). No files side yet → an
    # exported EMPTY string: "resolved; there is no files side". Every
    # save-path consumer checks -d (false for empty), and the restore
    # path's snapshot_restore_files skips on -z before any path
    # arithmetic (basename ""/dirname "" are nonsense — the hole this
    # export shape would otherwise open).
    local pv_root
    pv_root=$(kubectl -n "dataui-${name}" get pv \
                  "dataui-${name}-demo-files-pv" \
                  -o jsonpath='{.spec.hostPath.path}' 2>/dev/null)
    if [[ -n "$pv_root" ]]; then
        export DOCUMENT_ROOT="$pv_root"
    else
        export DOCUMENT_ROOT=""
    fi
    ADDRESS_MODEL="$name"
}

function address_slot_prefix {
    # Destination-address slot key, colon -> dash (stg:books ->
    # stg-books-golden / stg-books-last / stg-books-prerestore;
    # dev:books -> dev-books-prerestore; prd:todos ->
    # prd-todos-prerestore — the prd slots fall out unchanged).
    echo "${1/:/-}"
}

function prd_swap_begin {
    # Mark the files-swap window open for the EXIT trap. The keep-aside
    # path mirrors snapshot_restore_files' own derivation: parked old
    # tree = newest <base>.pre-restore-<ts> beside DOCUMENT_ROOT
    # (the ts is not knowable in advance, so it is discovered at
    # swap-begin time — exactly when the aside is being created).
    local base parent keep
    [[ -z "$DOCUMENT_ROOT" ]] && return 0
    base=$(basename "$DOCUMENT_ROOT")
    parent=$(dirname "$DOCUMENT_ROOT")
    keep=$(ls -1d "${parent}/${base}.pre-restore-"* 2>/dev/null | tail -1)
    PRD_KEEP_ASIDE="${keep:-}"
    PRD_SWAP_STARTED=1
}

function prd_swap_end {
    # The new tree is in place: close the window (the trap must not
    # move a keep-aside back over a good tree).
    PRD_SWAP_STARTED=""
    PRD_KEEP_ASIDE=""
}

function prd_app_deploy {
    # The app Deployment name for a prd instance (dataui-<name>).
    echo "dataui-${ADDRESS_NAME}"
}

function prd_quiesce {
    # Scale the app to 0 and WAIT until the pod is actually gone (a
    # Terminating pod still holds the RWO files PVC mount, and the
    # host-side mv swap must not start while it does). Not rollout
    # status: some kubectl versions return as soon as the spec says 0.
    # The pod selector is exactly app=dataui-<name> (template 40;
    # postgres pods carry app=dataui-<name>-postgres — verified on the
    # live cluster, M1). On timeout, scale back up and die: dying with
    # the app left at 0 and no trap installed yet would strand prod.
    kubectl -n "$PRD_NAMESPACE" scale "deploy/$(prd_app_deploy)" \
            --replicas=0 >/dev/null \
        || die "could not scale ${PRD_NAMESPACE}/deploy/$(prd_app_deploy) to 0; aborting (prod untouched)."
    local waited=0
    while kubectl get pods -n "$PRD_NAMESPACE" \
              -l "app=$(prd_app_deploy)" \
              --field-selector=status.phase=Running 2>/dev/null \
          | grep -q "$(prd_app_deploy)"; do
        if (( waited >= 120 )); then
            kubectl -n "$PRD_NAMESPACE" scale "deploy/$(prd_app_deploy)" \
                    --replicas=1 >/dev/null 2>&1
            die "app pod still Running 120s after scale-to-0; scaled back" \
                "to 1, database untouched. Investigate: kubectl -n" \
                "${PRD_NAMESPACE} get pods."
        fi
        sleep 2; waited=$(( waited + 2 ))
    done
}

function prd_restore_trap {
    # EXIT-trap backstop for a prd restore, installed after the
    # scale-to-0 and disarmed before the rollback exit and before the
    # success echo. NOT a rollback mechanism and not a set -e
    # substitute (the script has neither): it is the backstop for
    # signals, Ctrl-C, kill, and body dies between install and disarm
    # (e.g. snapshot_restore_files' die on a bad tar, which is after
    # the DB restore and wants the revive). SIGKILL is the one
    # exception no trap can cover: under kill -9 nothing runs, the app
    # stays at 0, and the manual revive named here is the recovery.
    # Best-effort throughout: kubectl may be unavailable; never die.
    [[ -n "${PRD_RESTORE_ACTIVE:-}" ]] || return 0
    # 1. Files swap mid-flight? Put the keep-aside back BEFORE scaling:
    #    a revive into the swap window would serve an app with no files
    #    tree while this message talks about the database.
    if [[ -n "${PRD_SWAP_STARTED:-}" && -n "${PRD_KEEP_ASIDE:-}" ]] \
       && [[ -e "$PRD_KEEP_ASIDE" ]] \
       && [[ ! -e "${PRD_RESTORE_DOCROOT:-}" ]]; then
        mv "$PRD_KEEP_ASIDE" "$PRD_RESTORE_DOCROOT" 2>/dev/null \
            || echo "WARNING: could not restore the parked files tree" \
                 "${PRD_KEEP_ASIDE}; recover it by hand." >&2
    fi
    # 2. Staged safety temps: promote onto the slot when the schema
    #    drop had started (the DB may be invalid; the slot is the
    #    data-level undo), clean when it had not (DB untouched).
    if [[ -n "${PRD_DROP_STARTED:-}" ]]; then
        [[ -n "${PRD_SAFETY_TMP:-}" && -f "$PRD_SAFETY_TMP" ]] \
            && mv "$PRD_SAFETY_TMP" "${SNAPSHOT_DIR}/${PRD_SLOT}.dump" 2>/dev/null
        [[ -n "${PRD_SAFETY_META:-}" && -f "$PRD_SAFETY_META" ]] \
            && mv "$PRD_SAFETY_META" "$(meta_path "$PRD_SLOT")" 2>/dev/null
        [[ -n "${PRD_SAFETY_FILES:-}" && -f "$PRD_SAFETY_FILES" ]] \
            && mv "$PRD_SAFETY_FILES" "$(snapshot_files_path "$PRD_SLOT")" 2>/dev/null
    else
        rm -f "${PRD_SAFETY_TMP:-}" "${PRD_SAFETY_META:-}" "${PRD_SAFETY_FILES:-}"
    fi
    # 3. Revive (best effort).
    if ! kubectl -n "$PRD_NAMESPACE" scale "deploy/$(prd_app_deploy)" \
                 --replicas=1 &>/dev/null; then
        echo "WARNING: could not scale the app back to 1; revive" \
             "manually: kubectl -n ${PRD_NAMESPACE} scale" \
             "deploy/$(prd_app_deploy) --replicas=1" >&2
    fi
    # 4. Three facts, never an overclaim.
    echo "prd restore aborted; scaled ${PRD_NAMESPACE}/deploy/$(prd_app_deploy) back to 1 replica (best effort)." >&2
    if [[ -n "${PRD_RESTORE_DONE:-}" ]]; then
        echo "The database was successfully restored; only the coda was cut short." >&2
    elif [[ -n "${PRD_DROP_STARTED:-}" ]]; then
        echo "The schema drop had started: the database is NOT guaranteed valid (empty, partial, or unverified rollback)." >&2
        echo "Manual undo: $SCRIPT_NAME snapshot restore ${PRD_SLOT} prd:${ADDRESS_NAME}" >&2
    else
        echo "The schema drop had not started: the database is untouched." >&2
    fi
}

function prd_revive {
    # Scale back to 1, wait for Ready, then a bounded health predicate:
    # HTTP 200 from GET /health on the loopback hop, 2s x 30 (60s).
    # Any other answer — 502, 503, refused — is failure (rollout Ready
    # means the manifest's own probe passed; the predicate is explicit
    # because any-HTTP-answer is not success). On failure the error
    # names the prerestore slot; the operator's undo is one more
    # restore.
    local slot="$1" i code
    kubectl -n "$PRD_NAMESPACE" scale "deploy/$(prd_app_deploy)" \
            --replicas=1 >/dev/null \
        || { echo "ERROR: scale-to-1 failed; revive manually: kubectl -n ${PRD_NAMESPACE} scale deploy/$(prd_app_deploy) --replicas=1" >&2; return 1; }
    if ! kubectl -n "$PRD_NAMESPACE" rollout status \
             "deploy/$(prd_app_deploy)" --timeout=300s >/dev/null 2>&1; then
        echo "WARNING: rollout did not report Ready within 300s;" \
             "continuing to the health check." >&2
    fi
    for i in $(seq 1 30); do
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 2 \
                   "http://${HTTP_HOST}:${HTTP_PORT}/health" 2>/dev/null)
        if [[ "$code" == "200" ]]; then
            echo "App revived (HTTP 200 on /health via the loopback hop)."
            return 0
        fi
        sleep 2
    done
    echo "ERROR: app did not answer 200 on /health within 60s of" \
         "scale-up (last: ${code:-none})." >&2
    echo "Recover with: $SCRIPT_NAME snapshot restore ${slot} prd:${ADDRESS_NAME}" >&2
    return 1
}

function meta_path {
    # .meta manifest beside a snapshot pair (may not exist).
    echo "${SNAPSHOT_DIR}/${1}.meta"
}

function meta_read {
    # Read one KEY from a .meta file (parsed, never sourced — the pool
    # is shared and writable; a sidecar must never reach the shell env).
    # Empty when absent or key-less.
    [[ -f "$(meta_path "$1")" ]] || return 0
    sed -n "s/^${2}=//p" "$(meta_path "$1")" | tail -n1
}

function confirm_model_via_api {
    # Positive check only: can never be the source of identity. Prints
    # the live /api/info model (lowercase keyword) and exits:
    #   0  answered and matches the expected model
    #   3  answered with a different model (refuse)
    #   7  login failed (401 residue — expected after a cross-env
    #      restore), unreachable (no HTTP response: refused or
    #      timeout), any other failed check (non-200 status,
    #      unparseable body) — the check confirmed nothing.
    # /api/info is never written into .meta.
    local expected="$1" model
    model=$(api_info_model)
    case "$?" in
        0)
            if [[ "$model" == "$expected" ]]; then
                echo confirmed
                return 0
            fi
            echo "mismatch: server reports model '${model}'"
            return 3
            ;;
        1)
            # /api/info login itself 401s only via the retry below;
            # reaching here means info failed without the token step.
            echo "unconfirmed"
            return 7
            ;;
        2)
            # Token worked but info failed/unparseable.
            echo "unconfirmed"
            return 7
            ;;
        4)
            echo "unconfirmed"
            return 7
            ;;
        5)
            echo "unconfirmed"
            return 7
            ;;
        6)
            # Login failed with 401: known residue (the DB carries the
            # source's auth rows while the env keeps the dest
            # ADMIN_PASSWORD). Treat as check-unconfirmed; the caller
            # prints the residue note where appropriate.
            echo "unconfirmed"
            return 7
            ;;
        *)
            echo "unconfirmed"
            return 7
            ;;
    esac
}

function api_info_model {
    # The live model name from /api/info, or an exit status classifying
    # the failure: 1 = login request failed (unreachable), 2 = token
    # obtained but /api/info failed, 4 = /api/info unparseable, 5 = no
    # token (login refused / bad body), 6 = login explicitly 401.
    # Prints the model name (exit 0) on success. Any HTTP response on
    # the login path is inspected: a 401 is classified apart from
    # network failure so the caller can treat the two differently.
    local login_status token body code
    login_status=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
                      "http://${HTTP_HOST}:${HTTP_PORT}/api/login" \
                      -H 'Content-Type: application/json' \
                      -d "{\"username\":\"admin\",\"password\":\"${ADMIN_PASSWORD}\"}" \
                      2>/dev/null) || login_status="000"
    case "$login_status" in
        200)
            token=$(curl -s --max-time 5 \
                        "http://${HTTP_HOST}:${HTTP_PORT}/api/login" \
                        -H 'Content-Type: application/json' \
                        -d "{\"username\":\"admin\",\"password\":\"${ADMIN_PASSWORD}\"}" \
                | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d['result']['access-token'])
except Exception:
    sys.exit(1)
" 2>/dev/null) || token=""
            [[ -n "$token" ]] || return 5
            ;;
        401)
            return 6
            ;;
        000)
            return 1
            ;;
        *)
            return 5
            ;;
    esac
    body=$(curl -s -w '\n%{http_code}' --max-time 5 \
               "http://${HTTP_HOST}:${HTTP_PORT}/api/info" \
               -H "Authorization: Bearer ${token}" 2>/dev/null) || return 2
    code="${body##*$'\n'}"
    [[ "$code" == 200 ]] || return 2
    printf '%s' "${body%$'\n'*}" \
        | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d['result']['name'])
except Exception:
    sys.exit(1)
" 2>/dev/null || return 4
}

function save_unreachable_policy {
    # Verb-split unreachable policy (review round 3/5), keyed on the
    # operation's address qualifier. SKIP means skip the /api/info
    # confirm ONLY, then proceed; REFUSE aborts (no dump taken).
    # save + unreachable dev: refuses (cannot check "what am I
    # dumping"; the DB may hold anything) unless FORCE=1.
    # save + unreachable stg: skips quietly — identity is
    # profile.env, a file already checked. One log-shaped line, never
    # fault-shaped (verb_stop's p-last refresh shares this branch and
    # the pause must not look like a fault).
    local qualifier="$1"
    case "$qualifier" in
        dev)
            if [[ -z "$FORCE" ]]; then
                die "Cannot confirm what the dev database holds (/api/info unreachable; start the dev REPL first), and 'snapshot save' refuses an unchecked dump. FORCE=1 overrides this check only (never a model mismatch)."
            fi
            echo "note: /api/info unreachable; FORCE=1 set — saving dev: dump unverified" >&2
            ;;
        stg)
            echo "note: /api/info unreachable; identity taken from profile.env (already checked) — saving anyway"
            ;;
        prd)
            # Identity is the namespace + Secret, both already checked
            # by the resolver; same rationale as stg:.
            echo "note: /api/info unreachable; identity taken from the cluster (namespace + Secret, already checked) — saving anyway"
            ;;
    esac
}

# Save-path 401 residue (Snapshot 2), now historical: /api/login
# could 401 with the app up — the DB carried the SOURCE's auth rows
# after a cross-env restore while the env kept the dest
# ADMIN_PASSWORD. Restore re-stamps the dest password now, so the
# confirm logs in positively whenever the app is reachable. Kept as
# a note because the exit-6 branch in api_info_model documents the
# same residue shape.
function confirm_model_for_save {
    # SAVE-side confirm. Dev asserts the loaded model, so a mismatch or
    # an unreachable server matters; stg identity is the profile env.
    local qualifier="$1" expected="$2"
    local verdict
    verdict=$(confirm_model_via_api "$expected")
    case "$?" in
        0)
            ;;
        3)
            # A positive mismatch is a refused save even under FORCE=1:
            # FORCE only buys the unreachable-dev escape.
            die "Refusing save: ${verdict}, but the address asserts '${expected}'. A model mismatch is never overridable (FORCE does not apply)."
            ;;
        7)
            if [[ "$verdict" == "mismatch:"* ]]; then
                : # unreachable never lands here
            fi
            save_unreachable_policy "$qualifier"
            ;;
    esac
}

function confirm_model_for_restore {
    # RESTORE-side confirm. "What am I overwriting" never reads the DB:
    # identity is .meta vs the address, both static, checked with the
    # app down, and the prerestore slot is the net. Unreachable (either
    # qualifier) skips the confirm with one quiet line — the journal
    # then shows which branch ran. The 401 residue note rides the save
    # path only (it describes the state entered earlier, not this
    # check).
    local expected="$1"
    local verdict
    verdict=$(confirm_model_via_api "$expected")
    case "$?" in
        0)
            ;;
        3)
            die "Refusing restore: ${verdict}, but the destination address asserts '${expected}'. A model mismatch is never overridable (FORCE does not apply)."
            ;;
        7)
            echo "note: /api/info unreachable; proceeding (identity is .meta vs the address, both static)"
            ;;
    esac
}

function require_postgres_running {
    # The die hint keys on the destination qualifier (Snapshot 2):
    # dev: is the natural restore shape (REPL down, Postgres up) and
    # "e-demo start" is wrong advice there. prd carries its own die
    # message naming the postgres Deployment and a rollout-status
    # hint — the dev advice ("db"/"repl") is compose-only nonsense
    # on the prd path, and DB_SERVICE is unset there. pg_isready
    # needs no -U/-d (a reachability probe), so it bypasses db_exec's
    # appended identity on purpose.
    if [[ "${ADDRESS_QUALIFIER:-}" == "prd" ]]; then
        kubectl exec -i -n "$PRD_NAMESPACE" "deploy/$PRD_PG_DEPLOY" -- \
            env PGPASSWORD="$DB_PASSWORD" pg_isready -h 127.0.0.1 \
            &>/dev/null \
            || die "PostgreSQL (${PRD_PG_DEPLOY} in namespace" \
                   "${PRD_NAMESPACE}) is not reachable." \
                   "Check: kubectl -n ${PRD_NAMESPACE} rollout status" \
                   "deploy/${PRD_PG_DEPLOY}"
    else
        compose exec -T "$DB_SERVICE" pg_isready -U "$DB_USER" &>/dev/null \
            || die "PostgreSQL (${DB_SERVICE}) is not reachable." \
                   "Start it with '$SCRIPT_NAME db' (or 'repl') first."
    fi
}

function preflight_ports {
    local profile_label="${1:-dev}"
    local port busy
    for port in "$HTTP_PORT" "$DB_PORT"; do
        if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"; then
            die "Profile '${profile_label}': port ${port} is already in use"
        fi
    done
    # Swank is only required for repl; check when set
    if [[ -n "${SWANK_PORT:-}" ]]; then
        if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${SWANK_PORT}\$"; then
            die "Profile '${profile_label}': swank port ${SWANK_PORT} is already in use"
        fi
    fi
}

function ensure_storage_dirs {
    mkdir -p "$DOCUMENT_ROOT" "$FS_TEMP_DIRECTORY"
}

function compose {
    docker compose -p "${DB_CONTAINER}" -f "${DB_DOCKER_COMPOSE}" "$@"
}

function db_exec {
    # Qualified dispatcher for every database touch on the snapshot
    # paths: compose exec -T on dev/stg (DB_SERVICE, docker compose),
    # kubectl exec -i on prd (PRD_NAMESPACE / PRD_PG_DEPLOY from the
    # prd resolver arm). Connection identity is appended by the
    # dispatcher so callers pass only the verb and its flags: on prd,
    # TCP auth with the Secret's password (the init container's
    # mechanism, -h 127.0.0.1 + PGPASSWORD); on dev/stg, -U/-d against
    # the compose service (missing -U made pg_dump resolve the
    # invoking uid inside the container and die with "local user with
    # ID 1000 does not exist"). stdin/stdout stream through
    # kubectl exec -i exactly as they do through compose exec -T, so
    # pg_dump -Fc to a host file and pg_restore from one need no new
    # plumbing. -i, NEVER -t: stdin must forward without a TTY (the
    # reset_public_schema heredoc, pg_restore -l < file, and
    # container_pg_restore's stdin all depend on it); -t would
    # allocate a TTY and corrupt the stream — do not add it later to
    # make pg_isready look interactive. Never reads DB_HOST / DB_PORT:
    # the cluster database has no host-side address. Two compose sites
    # stay on compose deliberately (verb_start's stg pg_isready wait,
    # wait_for_postgres): prd never reaches them.
    if [[ "${ADDRESS_QUALIFIER:-}" == "prd" ]]; then
        kubectl exec -i -n "$PRD_NAMESPACE" "deploy/$PRD_PG_DEPLOY" -- \
            env PGPASSWORD="$DB_PASSWORD" "$@" \
            -h 127.0.0.1 -U "$DB_USER" -d "$DB_NAME"
    else
        compose exec -T "$DB_SERVICE" "$@" \
            -U "$DB_USER" -d "$DB_NAME"
    fi
}

function prd_stage_archive {
    # $1 = archive file on this host; prints the pod-local path.
    # kubectl exec -i stdin streaming is unsafe for anything but a
    # full-read consumer: the kubectl 1.35 snap (2026-11-11) never
    # signals stdin EOF to a remote process that exits while the
    # local side still has pending bytes — `pg_restore -l` wedged
    # exactly so, hanging a prd restore at its TOC gate with prod
    # untouched. `cat > file` reads to EOF and exits, so the upload
    # terminates on every client version; pg_restore then takes the
    # pod-local path as a file argument (options trailing it parse
    # fine — GNU getopt permutation, verified live). A stray staged
    # file after a hard kill is harmless: pod /tmp is ephemeral and
    # the next stage truncates the same name.
    local src="$1" dst="/tmp/data-ui-snapshot-$$-${RANDOM}.dump"
    kubectl exec -i -n "$PRD_NAMESPACE" "deploy/$PRD_PG_DEPLOY" -- \
        sh -c "cat > '$dst'" < "$src" \
        || die "could not stage the archive into the postgres pod."
    echo "$dst"
}

function prd_unstage_archive {
    # Best-effort removal of a staged archive; never fails a restore.
    [[ -n "${1:-}" ]] || return 0
    kubectl exec -n "$PRD_NAMESPACE" "deploy/$PRD_PG_DEPLOY" -- \
        rm -f -- "$1" >/dev/null 2>&1 || true
}

function wait_for_postgres {
    local quiet="$1"
    local interval=$SLEEP_INTERVAL
    SECONDS=0
    if [[ -z "$quiet" ]]; then
        echo "Waiting for postgres..."
        until compose exec -it "$DB_SERVICE" \
                     pg_isready -U postgres; do
            if (( SECONDS >= TIMEOUT )); then
                echo "ERROR: Timed out waiting for PostgreSQL. Waited $SECONDS seconds." >&2
                return 1
            fi
            sleep $interval
            if (( interval < SLEEP_MAX )); then
                interval=$(( interval + 1 ))
            fi
        done
    else
        until compose exec -it "$DB_SERVICE" \
                     pg_isready -U postgres &>/dev/null; do
            if (( SECONDS >= TIMEOUT )); then
                echo "ERROR: Timed out waiting for PostgreSQL. Waited $SECONDS seconds." >&2
                return 1
            fi
            sleep $interval
            if (( interval < SLEEP_MAX )); then
                interval=$(( interval + 1 ))
            fi
        done
    fi
}

function start_postgres_quietly {
    echo
    echo "Starting PostgreSQL"
    if ! compose up -d &>/dev/null; then
        echo "ERROR: Failed to start PostgreSQL with docker compose" >&2
        return 1
    fi
    wait_for_postgres quiet
    echo "PostgreSQL is up on port ${DB_PORT}"
    sleep 2
}

function start_postgres {
    echo
    echo "Starting PostgreSQL"
    echo "docker compose -p \"${DB_CONTAINER}\" -f \"${DB_DOCKER_COMPOSE}\" up -d"
    if ! compose up -d; then
        echo "ERROR: Failed to start PostgreSQL with docker compose" >&2
        return 1
    fi
    wait_for_postgres
    echo "PostgreSQL is up on port ${DB_PORT}"
    sleep 2
}

function initialize_database_quietly {
    echo
    echo -n "Initializing database... "
    psql -h $DB_HOST -p $DB_PORT -d $DB_NAME -U $DB_USER \
         -f "$DB_INIT_SQL" >&/dev/null
    echo "Done."
}

function initialize_database {
    echo
    echo "Initializing database"
    psql -h $DB_HOST -p $DB_PORT -d $DB_NAME -U $DB_USER \
         -f "$DB_INIT_SQL"
}

function start_psql {
    echo
    echo "Connecting to database $DB_NAME at $DB_PORT"
    # Fail fast if nothing is listening (psql alone can hang on connect).
    if ! ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${DB_PORT}\$"; then
        die "Nothing listening on port ${DB_PORT} for DB ${DB_NAME}. Is the instance up?"
    fi
    psql -P pager=off -h $DB_HOST -p $DB_PORT -d $DB_NAME -U $DB_USER
}

function start_repl {
    # Unnamed development keeps its frontend build; named (staging)
    # REPLs run no npm — only 'staging update' builds web/dist — and
    # fail with the update instruction when dist is missing. The ASDF
    # load contract pins the checkout, and the orphan reap runs after
    # (init): a REPL can be the first process after an unclean
    # shutdown, and the reap must finish before the REPL prompt (Swank
    # is already listening by then, which is intended — it is an
    # operator channel).
    if [[ -n "${REPL_PROFILE:-}" ]]; then
        if [[ ! -d "web/dist" ]]; then
            die "web/dist is missing in $(canonical_checkout_root); run 'scripts/data-ui staging update' first (named REPLs never build the frontend)."
        fi
    else
        echo
        echo "Building frontend."
        local current
        current=$(pwd)
        ( cd web && npm install && npm run build ) || die "frontend build failed."
        cd "$current" || die "cannot cd back to ${current}"
    fi
    echo
    echo "Loading data-ui and starting Swank server on port $SWANK_PORT."
    local -a evals
    build_load_contract_evals
    evals=("${LOAD_CONTRACT_EVALS[@]}"
           --eval '(in-package :data-ui)'
           --eval '(init)'
           --eval '(reap-deploy-incoming-orphans)'
           --eval '(in-package :data-ui)')
    if [[ -n "${MODEL_NAME:-}" ]]; then
        evals+=(--eval "(set-model \"${MODEL_NAME}\")")
    fi
    DATA_UI_EXPECTED_CHECKOUT="$LOAD_CONTRACT_CHECKOUT" ros run -- "${evals[@]}"
}

function run_tests {
    echo
    echo "Running tests"
    # Tests ship inside the :data-ui system (tests/helpers.lisp → run-tests).
    # TEST_FILE was never assigned in this script; invoke the helper directly.
    # The ASDF load contract pins the run to this checkout (a plain
    # central-registry push is not enough; see build_load_contract_evals).
    local out status
    out=$(mktemp)
    # Gitignored runtime directories; absent in a fresh clone (same
    # shape as compile_model) — data-ui.lisp probes DOCUMENT_ROOT and
    # FS_TEMP_DIRECTORY at load time and dies without them.
    mkdir -p "$DOCUMENT_ROOT" "$FS_TEMP_DIRECTORY"
    build_load_contract_evals
    DATA_UI_EXPECTED_CHECKOUT="$LOAD_CONTRACT_CHECKOUT" \
        ros run -- --disable-debugger \
            "${LOAD_CONTRACT_EVALS[@]}" \
            --eval '(in-package :data-ui)' \
            --eval '(init)' \
            --eval '(run-tests)' \
            --eval '(uiop:quit 0)' 2>&1 | tee "$out"
    status=${PIPESTATUS[0]}
    if grep -qE '^[0-9]+/[0-9]+ checks FAILED' "$out"; then
        export REPORT="FAIL"
    elif grep -q 'All .* checks passed' "$out" && [[ $status -eq 0 ]]; then
        export REPORT="PASS"
    else
        export REPORT="FAIL"
    fi
    rm -f "$out"
}

function generate_readme {
    ros run -- --disable-debugger \
        --eval '(asdf:load-system :rbac :force t)' \
        --load "$TEST_FILE" \
        --eval "(rbac::generate-readme)" --quit
    if [[ $? -eq 0 ]]; then
        echo "Generated README.md"
    else
        echo "Failed to generate README.md"
    fi
}

function compile {
    ros run -- --disable-debugger \
        --eval "(push (uiop:getcwd) asdf:*central-registry*)" \
        --eval "(ql:register-local-projects)" \
        --eval "(asdf:load-system :rbac :force t)" \
        --load "$TEST_FILE" \
        --quit
    if [[ $? -eq 0 ]]; then
        echo
        echo "Compilation successful."
    else
        echo
        echo "Compilation failed."
    fi
}

function stop_database {
    echo "Stopping and removing database container"
    echo "docker compose -p \"${DB_CONTAINER}\" -f \"${DB_DOCKER_COMPOSE}\" down --remove-orphans --volumes"
    compose down --remove-orphans --volumes
}

function stop_database_quietly {
    # Remove container and its volumes: every caller's database is
    # throwaway by design (repl 5444, test 5445, deploy compile 5446).
    # A fresh volume means no admin user, so initialize-tables always
    # runs and the schema always matches the code just loaded — a
    # retained volume would resurrect an outdated schema instead.
    # Profile instances never pass through here (ops/profile-run.sh
    # owns their lifecycle, and their pgdata is a bind mount that
    # --volumes does not touch anyway).
    echo "Stopping and removing database container and volumes"
    compose down --volumes &>/dev/null
}

function export_repl_environment {
    : "${DB_CONTAINER:=pg-data-ui-repl}"
    : "${DB_SERVICE:=pg-data-ui-repl}"
    : "${DB_DOCKER_COMPOSE:=tests/docker-compose-pg-data-ui-repl.yaml}"
    : "${DB_PORT:=5444}"
    : "${LOG_FILE:=tests/repl.log}"
    : "${LOG_SEVERITY:=DEBUG}"
    : "${SWANK_PORT:=4010}"
    : "${SWANK_INTERFACE:=127.0.0.1}"
    : "${HTTP_PORT:=8081}"
    : "${WEB_DIRECTORY:=web/dist}"
    : "${RUN_TESTS:=false}"
    export DB_CONTAINER DB_SERVICE DB_DOCKER_COMPOSE DB_PORT LOG_FILE \
           LOG_SEVERITY SWANK_PORT SWANK_INTERFACE HTTP_PORT WEB_DIRECTORY \
           RUN_TESTS
    export PGPASSWORD="$DB_PASSWORD"
}

function export_test_environment {
    : "${DB_CONTAINER:=pg-data-ui-test}"
    : "${DB_SERVICE:=pg-data-ui-test}"
    : "${DB_DOCKER_COMPOSE:=tests/docker-compose-pg-data-ui-test.yaml}"
    : "${DB_PORT:=5445}"
    : "${LOG_FILE:=tests/test.log}"
    : "${LOG_SEVERITY:=DEBUG}"
    : "${SWANK_PORT:=4011}"
    : "${SWANK_INTERFACE:=127.0.0.1}"
    : "${HTTP_PORT:=8082}"
    : "${RUN_TESTS:=true}"
    export DB_CONTAINER DB_SERVICE DB_DOCKER_COMPOSE DB_PORT LOG_FILE \
           LOG_SEVERITY SWANK_PORT SWANK_INTERFACE HTTP_PORT RUN_TESTS
