(test apply-generated-model-text-writes-valid
  "apply-generated-model-text writes a valid model with header."
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (unwind-protect
      (let* ((record (th-gen-record id "gen-admin"))
             (result (apply-generated-model-text
                       :models record "gen-admin" :model
                       "A todo app" *gen-valid-model* "")))
        (is (getf result :ok) "Apply should succeed")
        (let ((model-val (getf (th-gen-record id "gen-admin") :model)))
          (is (search ";; Generated by" (or model-val "")))
          (is (search ":types" (or model-val "")))))
      (be-delete :models id "gen-admin"))))

(test apply-generated-model-text-rejects-invalid
  "apply-generated-model-text rejects invalid model text.  With an
empty prior model the failed attempt IS written, prefixed by the
one-line ;; failed: marker (error next to the artifact)."
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (unwind-protect
      (let* ((record (th-gen-record id "gen-admin"))
             (result (apply-generated-model-text
                       :models record "gen-admin" :model
                       "A todo app" "'garbage" "")))
        (is (getf result :error) "Should reject invalid model")
        (let ((model-val (getf (th-gen-record id "gen-admin") :model)))
          (is (search ";; failed: " (or model-val ""))
              "Failed attempt should be written with marker")
          ;; Marker is the FIRST line and stays one line
          (is (u:starts-with (first-line (or model-val ""))
                ";; failed: "))
          ;; Provenance header follows, then the failed body
          (is (search ";; Generated by" (or model-val "")))
          (is (search "garbage" (or model-val "")))))
      (be-delete :models id "gen-admin"))))

(test apply-generated-model-text-preserves-working-model
  "Rule 2.2: a prior WORKING model is never clobbered by a failed
attempt — the field keeps the working model untouched."
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (unwind-protect
      (progn
        ;; Seed the working model (the resolved field value in the
        ;; real flow; prior-model is what the field holds)
        (be-set-field-value :models id :model *gen-valid-model*
          "gen-admin")
        (let* ((record (th-gen-record id "gen-admin"))
               (working (getf record :model))
               (result (apply-generated-model-text
                         :models record "gen-admin" :model
                         "A todo app" "'garbage" working)))
          (is (getf result :error) "Should reject invalid model")
          (is (equal working
                 (getf (th-gen-record id "gen-admin") :model))
              "Working model must be left untouched")))
      (be-delete :models id "gen-admin"))))

(test apply-generated-model-text-replaces-failed-model
  "Rule 2.1: when the prior model is itself a failed attempt
 (;; failed: marker), a new failure replaces it — iteration on
 failures, no accumulation."
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (unwind-protect
      (progn
        ;; Seed a prior failed attempt
        (be-set-field-value :models id :model
          ";; failed: parse error in model text
'(:old-failure)"
          "gen-admin")
        (let* ((record (th-gen-record id "gen-admin"))
               (prior (getf record :model))
               (result (apply-generated-model-text
                         :models record "gen-admin" :model
                         "A todo app" "'garbage" prior)))
          (is (getf result :error) "Should reject invalid model")
          (let ((model-val (getf (th-gen-record id "gen-admin") :model)))
            (is (search ";; failed: " (or model-val ""))
                "New failed attempt should replace the old one")
            (is-false (search ":old-failure" (or model-val ""))
                      "Old failed attempt must be gone"))))
      (be-delete :models id "gen-admin"))))

