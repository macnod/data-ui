(in-suite generator-integration-suite)

(defun th-gen-seed-llm-config ()
  "Insert the llm-config secret as admin, or re-insert if it was
deleted.  Idempotent: deletes any existing llm-config rows first
to avoid duplicates.  Returns NIL."
  (th-gen-delete-llm-config)
  (be-insert :secrets
    (list :name "llm-config"
          :value ":url \"http://fake\" :model \"fake\" :api-key \"fake-key\""
          :description "Test LLM config")
    "admin")
  nil)

(defun th-gen-delete-llm-config ()
  "Delete all llm-config secrets so read-llm-config-missing can run."
  (let* ((result (be-list :secrets "admin" :form :update-form))
         (records (getf result :records)))
    (dolist (record records)
      (when (equal (getf record :name) "llm-config")
        (let ((id (getf record :id)))
          (when id
            (handler-case (be-delete :secrets id "admin")
              (error ())))))))
  nil)

(defun th-gen-make-user (&optional (name "gen-user"))
  "Create a user with ai-user and models-user roles.
Idempotent: skips creation if the user already exists."
  (unless (a:get-id *rbac* "users" name)
    (th-make-user name :roles '("ai-user" "models-user")))
  name)

(defparameter *gen-row-counter* 0)

(defun th-gen-make-model-row (user description)
  "Insert a :models row with a unique name, empty model.
Returns the new record ID."
  (incf *gen-row-counter*)
  (be-insert :models
    (list :name (format nil "gen-test-~d" *gen-row-counter*)
          :description description
          :model "")
    user
    :roles '("models-user")))

(defun th-gen-record (id user)
  "Fetch a :models record by ID."
  (getf (rec id user :type-key :models) :record))

(defun th-gen-status (id user)
  "Fetch the generate-status field for a :models record."
  (getf (th-gen-record id user) :generate-status))

(defun th-gen-wait (id user &optional (timeout 50))
  "Poll until generate-status is no longer running. Returns status."
  (loop for i below timeout
        for status = (th-gen-status id user)
        when (and status (not (equal status "running")))
          do (return status)
        do (sleep 0.1)
        finally (return (th-gen-status id user))))

(test generate-hook-override-writes-no-prompt-log
  "The LLM-override path (tests) short-circuits before the prompt
log — a Generate click under the override leaves the log dir
untouched.  Integration-suite (needs the modelbank-test model,
which run-generator-tests compiles after the pure suite)."
  (th-gen-seed-llm-config)
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (let ((dir (th-gen-temp-dir)))
      (unwind-protect
        (let* ((*generate-model-prompt-log-dir* dir)
               (*generate-model-llm-override*
                 (lambda (desc prior)
                   (declare (ignore desc prior))
                   (list :ok *gen-valid-model*))))
          (be-action :models id :generate "gen-admin")
          (th-gen-wait id "gen-admin")
          (is (null (uiop:directory-files (pathname dir)))
              "override runs must write no prompt-log files"))
        (progn
          (th-gen-delete-dir dir)
          (be-delete :models id "gen-admin"))))))

