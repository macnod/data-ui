(in-package :data-ui)

(def-suite generator-suite
  :description "Generate-model hook tests")

(def-suite generator-pure-suite
  :description "Pure function tests (no model, no DB)"
  :in generator-suite)

(def-suite generator-integration-suite
  :description "Integration tests (need modelbank-test + DB)"
  :in generator-suite)

;;; Reusable valid model text for integration tests.
(defparameter *gen-valid-model*
  (concatenate 'string
    "'(:title \"Gen\" :name \"gen\" :version \"0.1\""
    "  :types (:todos (:table t"
    "    :create :auto :update :auto :delete :auto :display t"
    "    :fields (:name (:type :text :identity t"
    "      :ui (:label \"Name\" :widget :textbox)"
    "      :source (:view :main :column :name :agg :first)"
    "      :column t :not-null t :unique t))"
    "    :list-form (:fields t)"
    "    :update-form (:fields t)"
    "    :add-form (:fields t))))"))

;;; ---------------------------------------------------------------------------
;;; Pure function tests (no model, no DB)
;;; ---------------------------------------------------------------------------

(in-suite generator-pure-suite)

(test strip-leading-comments-basic
  "strip-leading-lisp-comments removes ;; and blank lines."
  (is (equal "'(:types (:foo))"
        (u:trim
          (strip-leading-lisp-comments
            ";; Purpose: test
'(:types (:foo))"))))
  (is (equal "'(:types (:foo))"
        (u:trim
          (strip-leading-lisp-comments
            ";; line 1
;; line 2

'(:types (:foo))"))))
  (is (equal ""
        (strip-leading-lisp-comments
          ";; only comments
;; more comments"))))

(test strip-leading-comments-preserves-inner
  "Comments inside the plist body are preserved."
  (let ((result (strip-leading-lisp-comments
                  "'(:types ;; inner comment
     (:foo))")))
    (is (search ";; inner comment" result))
    (is (search "'(:types" result))))

(test validate-deploy-model-text-accepts-comments
  "validate-deploy-model-text accepts leading ;; headers."
  (let ((result (validate-deploy-model-text
                  (concatenate 'string
                    ";; Purpose: test
;; Author: rose
" *gen-valid-model*))))
    (is (getf result :ok) "Should succeed with leading comments")
    (is-false (getf result :error))))

(test validate-deploy-model-text-rejects-bad-body
  "validate-deploy-model-text still rejects garbage after comments."
  (let ((result (validate-deploy-model-text
                  ";; comment
garbage")))
    (is (getf result :error))))

(test validate-deploy-model-text-parse-error
  "Parse errors stay one-line messages (the model text is not
embedded — it lives in the :model field via the failed-attempt
write).  Both parse sites: unreadable text and a readable form
whose body is not a plist."
  (let ((result (validate-deploy-model-text "'(:types (:foo")))
    (is (equal "parse error in model text" (getf result :error))))
  (let ((result (validate-deploy-model-text "'not-a-plist")))
    (is (equal "parse error in model text" (getf result :error)))))

(test first-line
  "first-line returns text up to the first newline."
  (is (equal "abc" (first-line "abc
def")))
  (is (equal "abc" (first-line "abc"))))

(test failed-model-p
  "failed-model-p: empty/blank/nil or a ;; failed: first line.
A working model's header never matches."
  (is (failed-model-p nil))
  (is (failed-model-p ""))
  (is (failed-model-p "   "))
  (is (failed-model-p
        ";; failed: parse error in model text
'(:types (:foo"))
  (is-false (failed-model-p
              ";; Generated by Data UI Model Generator
'(:types (:foo))"))
  (is-false (failed-model-p "'(:types (:foo))")))

(test generate-model-error-line-one-line
  "The ;; failed: marker line collapses newlines so it stays one
line — the prefix check on the next Generate depends on that."
  (is (equal "line1 line2"
        (generate-model-error-line "line1
line2")))
  (is (equal "no newlines"
        (generate-model-error-line "no newlines"))))

(test clean-llm-response-strips-fences
  "clean-llm-response strips markdown fences."
  (is (equal "'(:types (:foo))"
        (clean-llm-response
          "```lisp
'(:types (:foo))
```")))
  (is (equal "'(:types (:foo))"
        (clean-llm-response
          "```
'(:types (:foo))
```")))
  (is (equal "'(:types (:foo))"
        (clean-llm-response "'(:types (:foo))")))
  (is (equal "'(:types (:foo))"
        (clean-llm-response
          "Here is the model:
```common-lisp
'(:types (:foo))
```
Hope this helps!"))))

(test generate-model-header-format
  "generate-model-header produces ;; comment lines."
  (let ((header (generate-model-header "a todo app")))
    (is (search ";; Generated by Data UI Model Generator" header))
    (is (search ";; Created:" header))
    (is (search ";; Prompt: a todo app" header))))

(test generate-model-header-truncates-long-prompts
  "generate-model-header truncates prompts over 60 chars."
  (let ((header (generate-model-header
                  (make-string 100 :initial-element #\x))))
    (is (search "..." header))))

(test generate-model-example-files-pinned-set
  "generate-model-example-files returns exactly the pinned demo set —
a new demo lands only by updating this pin, forcing a conscious
token-budget re-check instead of silently inflating every prompt.
(shopping.lisp joined the set 2026-09-27: an LLM-generated demo,
kept as a living example of generator output.)"
  (is (equal
        '("books" "chores" "file-server" "gift-tracker" "modelbank"
           "parts" "recurring" "shopping" "todos" "widgets")
        (mapcar (lambda (path)
                  (u:replace-extension (u:filename-only path) ""))
          (generate-model-example-files)))))

(test generate-model-example-block-skips-unreadable
  "generate-model-example-block returns nil for unreadable files —
one stray file never fails a generation."
  (is-false (generate-model-example-block "/no/such/file.lisp")))

(test generate-model-user-message-includes-prior-model
  "generate-model-user-message includes the prior model, framed as
advisory, with the description last (the final signal)."
  (let ((message (generate-model-user-message "A todo app"
                    "'(:name \"prior\")")))
    (is (search "previous version of this model" message))
    (is (search "'(:name \"prior\")" message))
    (is (search "A todo app" message))
    (is (> (search "'(:name \"prior\")" message)
           (search "previous version of this model" message)))
    (is (> (search "A todo app" message)
           (search "'(:name \"prior\")" message)))))

(test generate-model-user-message-omits-blank-prior-model
  "A blank or nil prior model omits the block entirely — erase =
fresh start."
  (dolist (prior (list nil "" "   "))
    (let ((message (generate-model-user-message "A todo app" prior)))
      (is-false (search "previous version of this model" message)
        "blank prior ~s must omit the block" prior)
      (is (search "A todo app" message)))))

(test sanitize-name-component
  "sanitize-name-component: downcase, non-[a-z0-9-] → dash, edges
trimmed — record :name is author/LLM data, never path data."
  (is (equal "model-bank-demo"
        (sanitize-name-component "Model Bank Demo!!")))
  (is (equal "a-b-c" (sanitize-name-component "  A/B C ")))
  (is (equal "" (sanitize-name-component "%%%")))
  (is (equal "" (sanitize-name-component nil))))

(test generate-model-prompt-log-filename-shape
  "Filename is <app>-<record>-<compact-ts>.org, both name
components sanitized."
  (let ((name (generate-model-prompt-log-filename
                "Model Bank" "Shop Ping!")))
    (is (re:scan "^model-bank-shop-ping-\\d{8}T\\d{6}\\.org$"
          name)
        "got ~a" name)))

(test org-escape-src-lines
  "Lines starting with *, #+, or , get a comma prefix inside src
blocks — org strips one leading comma on export / C-c ' edit, so
markdown bold (**) and keyword-looking lines stay literal."
  (let ((out (org-escape-src-lines "**Filter operators**
#+begin_example
,already-escaped
plain line")))
    (is (search ",**Filter operators**" out))
    (is (search ",#+begin_example" out))
    (is (search ",,already-escaped" out))
    (is (re:scan "(?m)^plain line$" out)
        "plain lines must not gain a comma prefix")))

(defun th-gen-temp-dir ()
  "Fresh temp directory under /tmp (namestring, trailing slash)
for prompt-log tests — never the default /data dir.  Caller
deletes it via th-gen-delete-dir."
  (namestring
    (ensure-directories-exist
      (format nil "/tmp/gen-prompt-log-test-~a/"
        (re:regex-replace-all "[^a-zA-Z0-9-]"
          (format nil "~a" (u:uuid)) "-")))))

(defun th-gen-delete-dir (dir)
  "Best-effort recursive delete of a th-gen-temp-dir directory."
  (ignore-errors
    (uiop:delete-directory-tree
      (pathname (string-right-trim "/" dir))
      :validate t :if-does-not-exist :ignore)))

(test generate-model-log-prompt-writes-file
  "generate-model-log-prompt writes one org-mode file into a temp
dir (not /data): level-1 headings for the former JSON keys, the
system prompt structured as two level-2 children (Model Syntax
Reference markdown block, Examples prose + lisp block).  The
prose / example blocks are regenerated inside the logger, so real
demo content rides the file even under a synthetic parts plist."
  (let* ((dir (th-gen-temp-dir))
         (*generate-model-prompt-log-dir* dir)
         (path (generate-model-log-prompt
                 '(:url "http://fake" :model "test-model"
                   :api-key "fake-key" :temperature 0.3 :max-tokens 16)
                 "shopping"
                 '(:reference "SYSTEM PROMPT TEXT"
                   :examples "whatever rides the JSON body")
                 "USER MESSAGE TEXT")))
    (unwind-protect
      (progn
        (is-true path "Should return the written path")
        (is-true (uiop:file-exists-p path) "File should exist")
        (let ((content (u:slurp path)))
          ;; Level-1 headings, one per former JSON key
          (dolist (heading '("* timestamp" "* model" "* temperature"
                             "* record-name" "* system-prompt"
                             "* user-message"))
            (is (search heading content)
              "missing heading ~a" heading))
          ;; Level-2 children under * system-prompt
          (is (search "** Model Syntax Reference" content)
            "missing level-2 reference heading")
          (is (search "** Examples" content)
            "missing level-2 examples heading")
          (is (re:scan "(?m)^shopping$" content)
            "record-name value under its heading")
          (is (re:scan "(?m)^test-model$" content)
            "model value under its heading")
          ;; Reference rides a markdown src block; demos ride one
          ;; lisp block; user message rides plain text
          (is (search "#+begin_src markdown" content))
          (is (search "#+end_src" content))
          (is (re:scan "(?m)^#\\+begin_src lisp$" content)
            "examples must ride one lisp src block")
          (is (search "SYSTEM PROMPT TEXT" content))
          (is (search "USER MESSAGE TEXT" content))
          ;; The regenerated example blocks are real demos
          (is (search ";; --- " content)
            "example-model banner must ride the lisp block")
          (is (search "models/todos.lisp" content))
          (is-false (search "fake-key" content)
            "the key never rides the body (header-only secret)")))
      (th-gen-delete-dir dir))))

(test generate-model-log-prompt-best-effort
  "A logging failure never signals: an impossible path (under a
file) returns NIL, Generate stays alive."
  (let* ((tmp (format nil "/tmp/gen-prompt-log-blocker-~a" (u:uuid)))
         (*generate-model-prompt-log-dir*
           (concatenate 'string tmp "/not-a-dir/")))
    (unwind-protect
      (progn
        (u:spew "blocker" tmp)
        (is-false (generate-model-log-prompt
                    '(:model "m" :temperature 0.3)
                    "shopping" '(:reference "sys" :examples "sys")
                    "user")
          "Failed write must return NIL")
        (finishes
          (generate-model-log-prompt
            '(:model "m" :temperature 0.3)
            "shopping" '(:reference "sys" :examples "sys")
            "user")))
      (ignore-errors (uiop:delete-file-if-exists tmp)))))

