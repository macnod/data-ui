(test be-action-passes-roles
  "be-action threads :roles into the hook (regression for Step 1).
The hook must return synchronously (no llm-config) so no async
worker is spawned."
  (th-gen-delete-llm-config)
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (unwind-protect
      (let ((result (be-action :models id :generate "gen-admin")))
        (is (or (getf result :async)
                (equal (getf result :status) "failed")))
        (is-false (search "ai-user role"
                    (or (getf result :message) ""))))
      (be-delete :models id "gen-admin"))))

(test generate-hook-persists-data-before-generating
  "Step 3: when :data carries the description/model keys, the hook
be-updates exactly those two fields before generating — browser state
is what gets stored and prompted.  Erase-and-Generate persists \"\" →
blank prior-model gate → fresh generation."
  (th-gen-seed-llm-config)
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (unwind-protect
      (let* ((seen-prior nil)
             (*generate-model-llm-override*
               (lambda (desc prior)
                 (setf seen-prior prior)
                 (list :ok *gen-valid-model*))))
        (be-action :models id :generate "gen-admin"
          (list :description "A better todo app"
                :model ""))
        (let ((status (th-gen-wait id "gen-admin")))
          (is (equal status "complete"))
          ;; The unsaved :data description was persisted
          (is (equal "A better todo app"
                 (getf (th-gen-record id "gen-admin") :description)))
          ;; Blank :model in :data → prior-model gate omitted it
          (is (or (null seen-prior) (string= seen-prior "")))
          ;; The prompt used the resolved (browser) description
          ;; indirectly: worker succeeded and wrote the model.
          (is (search ":types"
                 (or (getf (th-gen-record id "gen-admin") :model) "")))))
      (be-delete :models id "gen-admin"))))

(test generate-hook-passes-prior-model-to-llm
  "Step 2: a non-empty record :model rides the user message as
advisory prior art (reprogrammatic be-action, no :data — the only
reachable record-only path)."
  (th-gen-seed-llm-config)
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "A todo app")))
    (is-true id)
    (unwind-protect
      (let* ((seen-prior nil)
             (*generate-model-llm-override*
               (lambda (desc prior)
                 (setf seen-prior prior)
                 (list :ok *gen-valid-model*))))
        (be-set-field-value :models id :model "'(:name \"seed\")"
          "gen-admin")
        (be-action :models id :generate "gen-admin")
        (th-gen-wait id "gen-admin")
        (is (equal "'(:name \"seed\")" seen-prior)
            "Prior model must reach the LLM call"))
      (be-delete :models id "gen-admin"))))

(test generate-hook-skips-persist-without-data
  "Step 3 fallback: a programmatic be-action with no :data skips the
be-update entirely and resolves both fields from the record."
  (th-gen-seed-llm-config)
  (th-gen-make-user "gen-admin")
  (let ((id (th-gen-make-model-row "gen-admin" "Stored description")))
    (is-true id)
    (unwind-protect
      (let* ((seen-desc nil)
             (*generate-model-llm-override*
               (lambda (desc prior)
                 (declare (ignore prior))
                 (setf seen-desc desc)
                 (list :ok *gen-valid-model*))))
        (be-action :models id :generate "gen-admin")
        (th-gen-wait id "gen-admin")
        (is (equal "Stored description" seen-desc)
            "Record description must be used when :data is nil"))
      (be-delete :models id "gen-admin"))))

(test generate-model-system-prompt-carries-demos
  "The system prompt carries every demo model verbatim: part 2 opens
with the # Examples heading, block markers by path, real demo
content — and no test fixtures (the fixtures live in models/test/
and must never ride the prompt).  Fixture names that also appear
inside model-reference.md prose (m2m, static-select-test) are
excluded from the check for that reason.  NUL-freeness guards the
fixed u:slurp (dc-eclectic): modelbank.lisp carries an em-dash, so
a byte-sized buffer regression would leak trailing NULs here."
  (let ((prompt (generate-model-system-prompt)))
    (is (search "models/todos.lisp" prompt))
    (is (search ":title \"To Do List\"" prompt))
    (is (search "models/modelbank.lisp" prompt))
    (is (search "models/widgets.lisp" prompt))
    (is (search "# Examples" prompt)
      "part 2 must open with the # Examples heading")
    (is-false (search (string (code-char 0)) prompt)
      "the prompt must be NUL-free")
    ;; No fixture FILES ride the prompt: no demo block can contain a
    ;; fixture, and fixture-only names (bi-m2m-test is named only in
    ;; models/test/, never in model-reference.md) are absent.  (The
    ;; literal strings m2m-test / static-select-test appear inside
    ;; model-reference.md prose itself, so they cannot be used here.)
    (is-false (search ";; --- ~/common-lisp/data-ui/models/test/" prompt)
      "test fixtures must not ride the system prompt")
    (is-false (search "bi-m2m-test" prompt)
      "test fixtures must not ride the system prompt")))

(test generate-model-examples-text-shape
  "Part 2 opens with the level-1 # Examples heading, then the
framing prose, then the example blocks — and the joined system
prompt carries the reference before it."
  (let ((examples (generate-model-examples-text)))
    (is (u:starts-with examples "# Examples")
      "part 2 must open with the heading")
    (is (search "complete example models" examples)
      "framing prose must follow the heading")
    (is (> (search "complete example models" examples) 0)
      "prose comes after the heading, not before")
    (is-false (search "~" examples)
      "the prose must carry no format-directive residue")
    (is (search ";; --- " examples)
      "example blocks must follow")))

